(def program stdlib.qwen3.fused.norm.square : {((cap.own mem) val) (u64 val) (u64 val) ({(u64 val) (f32 val)} *)} -> (f32 val) =
 ([input base tid pair.]
  ([.pair] *.elim [i acc.])
  ({[.i] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.mul [stride.])
  ({[.stride] [.tid]} stdlib.qwen3.memory.u64.add [channel.])
  ({[.base] [.channel]} stdlib.qwen3.memory.u64.add [offset.])
  ({[.input] [.offset]} stdlib.qwen3.memory.own-read-bf16 [bf.])
  ([.bf] bf16.to-f32 [f.])
  ({[.f] [.f]} stdlib.qwen3.memory.f32.mul [squared.])
  ({[.acc] [.squared]} stdlib.qwen3.memory.f32.add [sum.])
  [.sum]
 ))
