# Dense Qwen3 token decoder. Cache layout matches the default backend.
(def program qwen3.decoder-layer : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val) (u64 val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val)} -> ({((cap.own mem) val) ((cap.own mem) val)} *) =
 ([hidden cache rope capacity position layer input-norm q-weight k-weight v-weight o-weight q-norm k-norm post-norm gate-weight up-weight down-weight.]
  ({[.hidden] [.input-norm] (const.u64.0x{{HIDDEN_SIZE}}) (const.u32.0x{{HIDDEN_F32}} u32.bitcast-f32) (const.u64.0x0000000000000001)} qwen3.normalize [normalized.])
  ({[.normalized] [.q-weight] (const.u64.0x{{HIDDEN_SIZE}}) (const.u64.0x{{QUERY_SIZE}})} qwen3.project [query-raw.])
  ({[.normalized] [.k-weight] (const.u64.0x{{HIDDEN_SIZE}}) (const.u64.0x{{KEY_VALUE_SIZE}})} qwen3.project [key-raw.])
  ({[.normalized] [.v-weight] (const.u64.0x{{HIDDEN_SIZE}}) (const.u64.0x{{KEY_VALUE_SIZE}})} qwen3.project [value.])
  ({[.query-raw] [.q-norm] (const.u64.0x{{HEAD_DIM}}) (const.u32.0x{{HEAD_F32}} u32.bitcast-f32) (const.u64.0x{{QUERY_HEADS}})} qwen3.normalize [query-norm.])
  ({[.query-raw] [.query-norm]} qwen3.free-bf16-before [query-normalized.])
  ({[.key-raw] [.k-norm] (const.u64.0x{{HEAD_DIM}}) (const.u32.0x{{HEAD_F32}} u32.bitcast-f32) (const.u64.0x{{KV_HEADS}})} qwen3.normalize [key-norm.])
  ({[.key-raw] [.key-norm]} qwen3.free-bf16-before [key-normalized.])
  ({[.query-normalized] [.rope]} qwen3.rotate [query-rotated.])
  ({[.query-normalized] [.query-rotated]} qwen3.free-bf16-before [query.])
  ({[.key-normalized] [.rope]} qwen3.rotate [key-rotated.])
  ({[.key-normalized] [.key-rotated]} qwen3.free-bf16-before [key.])
  ({[.layer] (const.u64.0x0000000000000002)} stdlib.qwen3.memory.u64.mul [planes.])
  ({[.planes] [.capacity]} stdlib.qwen3.memory.u64.mul [rows.])
  ({[.rows] (const.u64.0x{{KEY_VALUE_SIZE}})} stdlib.qwen3.memory.u64.mul [key-offset.])
  ({[.capacity] (const.u64.0x{{KEY_VALUE_SIZE}})} stdlib.qwen3.memory.u64.mul [plane.])
  ({[.key-offset] [.plane]} stdlib.qwen3.memory.u64.add [value-offset.])
  ({[.position] (const.u64.0x{{KEY_VALUE_SIZE}})} stdlib.qwen3.memory.u64.mul [append-offset.])
  ({[.key-offset] [.append-offset]} stdlib.qwen3.memory.u64.add [key-target.])
  ({[.value-offset] [.append-offset]} stdlib.qwen3.memory.u64.add [value-target.])
  ({[.key] [.cache] [.key-target]} qwen3.append [cache-k.])
  ({[.value] [.cache-k] [.value-target]} qwen3.append [cache-v.])
  ({[.key] [.cache-v]} qwen3.free-bf16-before [cache-ready-k.])
  ({[.value] [.cache-ready-k]} qwen3.free-bf16-before [cache-ready.])
  ({[.position] (const.u64.0x0000000000000001)} stdlib.qwen3.memory.u64.add [keys.])
  ({[.query] [.cache-ready] [.keys] [.key-offset]} qwen3.scores [scores.])
  ({[.query] [.scores]} qwen3.free-bf16-before [scores-ready.])
  ({[.scores-ready] [.keys]} qwen3.softmax [probabilities.])
  ({[.scores-ready] [.probabilities]} qwen3.free-f32-before [probabilities-ready.])
  ({[.probabilities-ready] [.cache-ready] [.keys] [.value-offset]} qwen3.context [context.])
  ({[.probabilities-ready] [.context]} qwen3.free-bf16-before [context-ready.])
  ({[.context-ready] [.o-weight] (const.u64.0x{{QUERY_SIZE}}) (const.u64.0x{{HIDDEN_SIZE}})} qwen3.project [projected.])
  ({[.context-ready] [.projected]} qwen3.free-bf16-before [projected-ready.])
  ({[.hidden] [.projected-ready]} qwen3.add [residual.])
  ({[.hidden] [.residual]} qwen3.free-bf16-before [residual-ready.])
  ({[.projected-ready] [.residual-ready]} qwen3.free-bf16-before [residual-final.])
  ({[.normalized] [.residual-final]} qwen3.free-bf16-before [attention-result.])
  ({[.attention-result] [.post-norm] (const.u64.0x{{HIDDEN_SIZE}}) (const.u32.0x{{HIDDEN_F32}} u32.bitcast-f32) (const.u64.0x0000000000000001)} qwen3.normalize [ffn-input.])
  ({[.ffn-input] [.gate-weight] (const.u64.0x{{HIDDEN_SIZE}}) (const.u64.0x{{INTERMEDIATE_SIZE}})} qwen3.project [gate.])
  ({[.ffn-input] [.up-weight] (const.u64.0x{{HIDDEN_SIZE}}) (const.u64.0x{{INTERMEDIATE_SIZE}})} qwen3.project [up.])
  ({[.gate] [.up]} qwen3.swiglu [activated.])
  ({[.gate] [.activated]} qwen3.free-bf16-before [activated-g.])
  ({[.up] [.activated-g]} qwen3.free-bf16-before [activated-ready.])
  ({[.ffn-input] [.activated-ready]} qwen3.free-bf16-before [gated.])
  ({[.gated] [.down-weight] (const.u64.0x{{INTERMEDIATE_SIZE}}) (const.u64.0x{{HIDDEN_SIZE}})} qwen3.project [down.])
  ({[.gated] [.down]} qwen3.free-bf16-before [down-ready.])
  ({[.attention-result] [.down-ready]} qwen3.add [result.])
  ({[.attention-result] [.result]} qwen3.free-bf16-before [result-a.])
  ({[.down-ready] [.result-a]} qwen3.free-bf16-before [result-final.])
  ({[.cache-ready] [.result-final]} *.intro)
 ))
