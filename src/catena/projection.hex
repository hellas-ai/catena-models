(def program stdlib.qwen3.add.host-step : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) ({master.grid ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2)} stdlib.gpu.geometry.type.Grid)} :) ({({master.index u64} :) ({((cap.own mem) val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({((cap.own mem) val) (prop.Truth |-)} *) =
 ([a b out count grid pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ({[.a] [.b] [.out] [.count]} partial.stdlib.qwen3.add.launch.4 [kernel.])
  ({[.grid] [.kernel]} unsafe.launch unit.elim)
  ({[.value] [.truth]} *.intro)
 ))

