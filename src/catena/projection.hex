# Native Qwen3: explicit typed memory and guarded launches.
# A one-iteration host fold returns each launched buffer as loop state. This
# preserves an ordering edge after unit ports are erased by product unpacking.

(def program stdlib.qwen3.add : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val)} -> 1 =
 ([a b out index.]
  ({[.a] [.index]} stdlib.models.memory.own-read-bf16 [av.])
  ({[.b] [.index]} stdlib.models.memory.own-read-bf16 [bv.])
  ({[.av] [.bv]} stdlib.models.memory.bf16.add [value.])
  ({[.out] [.index] [.value]} stdlib.models.memory.write-bf16)
  (unit.elim)
  (unit.intro)
 ))
(def program stdlib.qwen3.add.yes : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([a b out pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  ([.unit] unit.elim)
  ({[.a] [.b] [.out] [.index]} stdlib.qwen3.add)

 ))
(def program stdlib.qwen3.add.no : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([a b out pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  [.unit]
 ))
(def program stdlib.qwen3.add.launch : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) ({({master.block ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid} stdlib.gpu.geometry.type.Block)} :) (({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid master.block} stdlib.gpu.geometry.type.Thread) val)} *)} -> 1 =
 ([a b out count pair.]
  ([.pair] stdlib.models.memory.thread-index [index.])
  ({[.index] [.count]} stdlib.models.memory.u64.less [valid.])
  ({[.valid] (unit.intro meta.master.predicate)} smolcat.value.named_at :.forget [condition.])
  ({[.a] [.b] [.out]} partial.stdlib.qwen3.add.yes.3 [yes.])
  ({[.a] [.b] [.out]} partial.stdlib.qwen3.add.no.3 [no.])
  ({[.condition] [.index] [.yes] [.no] unit.intro} core.if)
 ))
(def program qwen3.add : {((cap.own mem) val) ((cap.own mem) val)} -> ((cap.own mem) val) =
 ([a b.]
  ([.a] stdlib.models.memory.own-count-bf16 [count.])
  ([.count] stdlib.models.memory.alloc-bf16 [out.])
  ({[.count] (const.u64.0x00000000000000FF)} stdlib.models.memory.u64.add [padded.])
  ({[.padded] (const.u64.0x0000000000000100)} stdlib.models.memory.u64.div [blocks.])
  ([.blocks] stdlib.models.memory.grid [grid.])
  ({[.a] [.b] [.out] [.count] [.grid]} partial.stdlib.qwen3.add.host-step.5 [host-callback.])
  ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [host-end.])
  ({[.host-end] [.out] [.host-callback] core.truth} core.fold.bounded_u64 [complete proof.])
  ([.proof] unsafe.discard unit.elim)

  [.complete]
 ))
(def program stdlib.qwen3.swiglu : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val)} -> 1 =
 ([gate up out index.]
  ({[.gate] [.index]} stdlib.models.memory.own-read-bf16 [gv.])
  ([.gv] bf16.to-f32 [g.])
  ([.g] stdlib.models.math.silu f32.to-bf16 [activated.])
  ({[.up] [.index]} stdlib.models.memory.own-read-bf16 [uv.])
  ({[.activated] [.uv]} stdlib.models.memory.bf16.mul [value.])
  ({[.out] [.index] [.value]} stdlib.models.memory.write-bf16)
  (unit.elim)
  (unit.intro)
 ))
(def program stdlib.qwen3.swiglu.yes : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([gate up out pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  ([.unit] unit.elim)
  ({[.gate] [.up] [.out] [.index]} stdlib.qwen3.swiglu)

 ))
(def program stdlib.qwen3.swiglu.no : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([gate up out pair.]
  ([.pair] *.elim [index proofs.])
