(def program qwen3.add : {((cap.own mem) val) ((cap.own mem) val)} -> ((cap.own mem) val) =
 ([a b.]
  ([.a] stdlib.qwen3.memory.own-count-bf16 [count.])
  ([.count] stdlib.qwen3.memory.alloc-bf16 [out.])
  ({[.count] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
