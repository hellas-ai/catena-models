 ))
(def program stdlib.qwen3.swiglu : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val)} -> 1 =
 ([gate up out index.]
  ({[.gate] [.index]} stdlib.qwen3.memory.own-read-bf16 [gv.])
  ([.gv] bf16.to-f32 [g.])
  ([.g] qwen3.silu f32.to-bf16 [activated.])
  ({[.up] [.index]} stdlib.qwen3.memory.own-read-bf16 [uv.])
  ({[.activated] [.uv]} stdlib.qwen3.memory.bf16.mul [value.])
  ({[.out] [.index] [.value]} stdlib.qwen3.memory.write-bf16)
  (unit.elim)
  (unit.intro)
 ))
