# Native Qwen3: explicit typed memory and guarded launches.
# A one-iteration host fold returns each launched buffer as loop state. This
# preserves an ordering edge after unit ports are erased by product unpacking.

(def program stdlib.qwen3.dot : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) ({(u64 val) (f32 val)} *)} -> (f32 val) =
 ([input weight base pair.]
  ([.pair] *.elim [i acc.])
  ({[.base] [.i]} stdlib.qwen3.memory.u64.add [offset.])
  ({[.input] [.i]} stdlib.qwen3.memory.own-read-bf16x2 [a.])
  ({[.weight] [.offset]} stdlib.qwen3.memory.ref-read-bf16x2 [b.])
  ({[.a] [.b] [.acc]} bf16x2.dot-f32 [result.])
  [.result]
 ))
(def program stdlib.qwen3.dot.fold : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) ({({master.index u64} :) ({(f32 val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({(f32 val) (prop.Truth |-)} *) =
 ([input weight base pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ([.index] :.forget [i.])
  ({[.i] [.value]} *.intro [arguments.])
  ({[.input] [.weight] [.base] [.arguments]} stdlib.qwen3.dot [result.])
  ({[.result] [.truth]} *.intro)
 ))
(def program stdlib.qwen3.project : {((cap.own mem) val) ((cap.ref mem) val) ((cap.own mem) val) (u64 val) (u64 val)} -> 1 =
 ([input weight out pairs index.]
  ({[.index] [.pairs]} stdlib.qwen3.memory.u64.mul [base.])
  ({[.input] [.weight] [.base]} partial.stdlib.qwen3.dot.fold.3 [callback.])
  ({[.pairs] (unit.intro meta.master.end)} smolcat.value.named_at [end.])
  ({[.end] (const.u32.0x00000000 u32.bitcast-f32) [.callback] core.truth} core.fold.bounded_u64 [ sum proof.])
  ([.proof] unsafe.discard unit.elim)
  ([.sum] f32.to-bf16 [result.])
  ({[.out] [.index] [.result]} stdlib.qwen3.memory.write-bf16)
  (unit.elim)
  (unit.intro)
 ))
(def program stdlib.qwen3.project.yes : {((cap.own mem) val) ((cap.ref mem) val) ((cap.own mem) val) (u64 val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([input weight out pairs pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  ([.unit] unit.elim)
  ({[.input] [.weight] [.out] [.pairs] [.index]} stdlib.qwen3.project)

 ))
(def program stdlib.qwen3.project.no : {((cap.own mem) val) ((cap.ref mem) val) ((cap.own mem) val) (u64 val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([input weight out pairs pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  [.unit]
 ))
(def program stdlib.qwen3.project.launch : {((cap.own mem) val) ((cap.ref mem) val) ((cap.own mem) val) (u64 val) (u64 val) ({({master.block ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid} stdlib.gpu.geometry.type.Block)} :) (({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid master.block} stdlib.gpu.geometry.type.Thread) val)} *)} -> 1 =
 ([input weight out pairs count pair.]
  ([.pair] stdlib.qwen3.memory.thread-index [index.])
  ({[.index] [.count]} stdlib.qwen3.memory.u64.less [valid.])
  ({[.valid] (unit.intro meta.master.predicate)} smolcat.value.named_at :.forget [condition.])
  ({[.input] [.weight] [.out] [.pairs]} partial.stdlib.qwen3.project.yes.4 [yes.])
  ({[.input] [.weight] [.out] [.pairs]} partial.stdlib.qwen3.project.no.4 [no.])
  ({[.condition] [.index] [.yes] [.no] unit.intro} core.if)
 ))
(def program qwen3.project : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) (u64 val)} -> ((cap.own mem) val) =
 ([input weight features outputs.]
  ({[.features] (const.u64.0x0000000000000002)} stdlib.qwen3.memory.u64.div [pairs.])
  ([.outputs] stdlib.qwen3.memory.alloc-bf16 [out.])
  ({[.outputs] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
  ({[.padded] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.div [blocks.])
  ([.blocks] stdlib.qwen3.memory.grid [grid.])
  ({[.input] [.weight] [.out] [.pairs] [.outputs] [.grid]} partial.stdlib.qwen3.project.host-step.6 [host-callback.])
  ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [host-end.])
  ({[.host-end] [.out] [.host-callback] core.truth} core.fold.bounded_u64 [complete proof.])
  ([.proof] unsafe.discard unit.elim)

  [.complete]
 ))
(def program stdlib.qwen3.add : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val)} -> 1 =
 ([a b out index.]
  ({[.a] [.index]} stdlib.qwen3.memory.own-read-bf16 [av.])
  ({[.b] [.index]} stdlib.qwen3.memory.own-read-bf16 [bv.])
  ({[.av] [.bv]} stdlib.qwen3.memory.bf16.add [value.])
  ({[.out] [.index] [.value]} stdlib.qwen3.memory.write-bf16)
  (unit.elim)
  (unit.intro)
 ))
