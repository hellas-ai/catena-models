# Native Qwen3: explicit typed memory and guarded launches.
# A one-iteration host fold returns each launched buffer as loop state. This
# preserves an ordering edge after unit ports are erased by product unpacking.

(def program stdlib.qwen3.square : {((cap.own mem) val) (u64 val) ({(u64 val) (f32 val)} *)} -> (f32 val) =
 ([input base pair.]
  ([.pair] *.elim [i acc.])
  ({[.base] [.i]} stdlib.qwen3.memory.u64.add [offset.])
  ({[.input] [.offset]} stdlib.qwen3.memory.own-read-bf16 [bf.])
  ([.bf] bf16.to-f32 [value.])
  ({[.value] [.value]} stdlib.qwen3.memory.f32.mul [squared.])
  ({[.acc] [.squared]} stdlib.qwen3.memory.f32.add [sum.])
  [.sum]
 ))
(def program stdlib.qwen3.square.fold : {((cap.own mem) val) (u64 val) ({({master.index u64} :) ({(f32 val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({(f32 val) (prop.Truth |-)} *) =
 ([input base pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ([.index] :.forget [i.])
  ({[.i] [.value]} *.intro [arguments.])
  ({[.input] [.base] [.arguments]} stdlib.qwen3.square [result.])
  ({[.result] [.truth]} *.intro)
 ))
(def program stdlib.qwen3.rms : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (f32 val) (u64 val)} -> 1 =
 ([input out columns columns-f32 index.]
  ({[.index] [.columns]} stdlib.qwen3.memory.u64.mul [base.])
  ({[.input] [.base]} partial.stdlib.qwen3.square.fold.2 [callback.])
  ({[.columns] (unit.intro meta.master.end)} smolcat.value.named_at [end.])
  ({[.end] (const.u32.0x00000000 u32.bitcast-f32) [.callback] core.truth} core.fold.bounded_u64 [ sum proof.])
  ([.proof] unsafe.discard unit.elim)
  ({[.sum] [.columns-f32]} stdlib.qwen3.memory.f32.div [mean.])
  ({[.mean] (const.u32.0x{{RMS_EPSILON_BITS}} u32.bitcast-f32)} stdlib.qwen3.memory.f32.add [variance.])
  ([.variance] qwen3.sqrt [root.])
  ({(const.u32.0x3F800000 u32.bitcast-f32) [.root]} stdlib.qwen3.memory.f32.div [inverse.])
  ({[.out] [.index] [.inverse]} stdlib.qwen3.memory.write-f32)
  (unit.elim)
  (unit.intro)
 ))
(def program stdlib.qwen3.rms.yes : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (f32 val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([input out columns columns-f32 pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  ([.unit] unit.elim)
  ({[.input] [.out] [.columns] [.columns-f32] [.index]} stdlib.qwen3.rms)

 ))
(def program stdlib.qwen3.rms.no : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (f32 val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([input out columns columns-f32 pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  [.unit]
 ))
(def program stdlib.qwen3.rms.launch : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (f32 val) (u64 val) ({({master.block ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid} stdlib.gpu.geometry.type.Block)} :) (({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid master.block} stdlib.gpu.geometry.type.Thread) val)} *)} -> 1 =
 ([input out columns columns-f32 count pair.]
  ([.pair] stdlib.qwen3.memory.thread-index [index.])
  ({[.index] [.count]} stdlib.qwen3.memory.u64.less [valid.])
  ({[.valid] (unit.intro meta.master.predicate)} smolcat.value.named_at :.forget [condition.])
  ({[.input] [.out] [.columns] [.columns-f32]} partial.stdlib.qwen3.rms.yes.4 [yes.])
  ({[.input] [.out] [.columns] [.columns-f32]} partial.stdlib.qwen3.rms.no.4 [no.])
  ({[.condition] [.index] [.yes] [.no] unit.intro} core.if)
 ))
(def program qwen3.rms-inverse : {((cap.own mem) val) (u64 val) (f32 val) (u64 val)} -> ((cap.own mem) val) =
 ([input columns columns-f32 rows.]
  ([.rows] stdlib.qwen3.memory.alloc-f32 [out.])
  ({[.rows] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
  ({[.padded] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.div [blocks.])
  ([.blocks] stdlib.qwen3.memory.grid [grid.])
  ({[.input] [.out] [.columns] [.columns-f32] [.rows] [.grid]} partial.stdlib.qwen3.rms.host-step.6 [host-callback.])
  ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [host-end.])
  ({[.host-end] [.out] [.host-callback] core.truth} core.fold.bounded_u64 [complete proof.])
  ([.proof] unsafe.discard unit.elim)

  [.complete]
 ))
(def program stdlib.qwen3.norm : {((cap.own mem) val) ((cap.ref mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val)} -> 1 =
 ([input weight inverse out columns index.]
  ({[.index] [.columns]} stdlib.qwen3.memory.u64.div [row.])
  ({[.index] [.columns]} stdlib.qwen3.memory.u64.rem [channel.])
  ({[.input] [.index]} stdlib.qwen3.memory.own-read-bf16 [bf.])
  ([.bf] bf16.to-f32 [value.])
  ({[.inverse] [.row]} stdlib.qwen3.memory.own-read-f32 [scale.])
  ({[.weight] [.channel]} stdlib.qwen3.memory.ref-read-f32 [learned.])
  ([.learned] f32.to-bf16 [learned-bf.])
  ({[.value] [.scale]} stdlib.qwen3.memory.f32.mul [scaled.])
  ([.scaled] f32.to-bf16 [scaled-bf.])
  ({[.scaled-bf] [.learned-bf]} stdlib.qwen3.memory.bf16.mul [result.])
  ({[.out] [.index] [.result]} stdlib.qwen3.memory.write-bf16)
  (unit.elim)
  (unit.intro)
 ))
(def program stdlib.qwen3.norm.yes : {((cap.own mem) val) ((cap.ref mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([input weight inverse out columns pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  ([.unit] unit.elim)
  ({[.input] [.weight] [.inverse] [.out] [.columns] [.index]} stdlib.qwen3.norm)

 ))
(def program stdlib.qwen3.norm.no : {((cap.own mem) val) ((cap.ref mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([input weight inverse out columns pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  [.unit]
 ))
(def program stdlib.qwen3.norm.launch : {((cap.own mem) val) ((cap.ref mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val) ({({master.block ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid} stdlib.gpu.geometry.type.Block)} :) (({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid master.block} stdlib.gpu.geometry.type.Thread) val)} *)} -> 1 =
 ([input weight inverse out columns count pair.]
  ([.pair] stdlib.qwen3.memory.thread-index [index.])
  ({[.index] [.count]} stdlib.qwen3.memory.u64.less [valid.])
  ({[.valid] (unit.intro meta.master.predicate)} smolcat.value.named_at :.forget [condition.])
  ({[.input] [.weight] [.inverse] [.out] [.columns]} partial.stdlib.qwen3.norm.yes.5 [yes.])
  ({[.input] [.weight] [.inverse] [.out] [.columns]} partial.stdlib.qwen3.norm.no.5 [no.])
  ({[.condition] [.index] [.yes] [.no] unit.intro} core.if)
 ))
(def program qwen3.normalize : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) (f32 val) (u64 val)} -> ((cap.own mem) val) =
 ([input weight columns columns-f32 rows.]
  ({[.input] [.columns] [.columns-f32] [.rows]} qwen3.rms-inverse [inverse.])
  ([.input] stdlib.qwen3.memory.own-count-bf16 [count.])
  ([.count] stdlib.qwen3.memory.alloc-bf16 [out.])
  ({[.count] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
  ({[.padded] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.div [blocks.])
  ([.blocks] stdlib.qwen3.memory.grid [grid.])
  ({[.input] [.weight] [.inverse] [.out] [.columns] [.count] [.grid]} partial.stdlib.qwen3.norm.host-step.7 [host-callback.])
  ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [host-end.])
  ({[.host-end] [.out] [.host-callback] core.truth} core.fold.bounded_u64 [complete proof.])
  ([.proof] unsafe.discard unit.elim)

  ({[.inverse] [.complete]} qwen3.free-f32-before)
 ))

(def program stdlib.qwen3.rms.host-step : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (f32 val) (u64 val) ({master.grid ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2)} stdlib.gpu.geometry.type.Grid)} :) ({({master.index u64} :) ({((cap.own mem) val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({((cap.own mem) val) (prop.Truth |-)} *) =
 ([input out columns columns-f32 rows grid pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ({[.input] [.out] [.columns] [.columns-f32] [.rows]} partial.stdlib.qwen3.rms.launch.5 [kernel.])
  ({[.grid] [.kernel]} unsafe.launch unit.elim)
  ({[.value] [.truth]} *.intro)
 ))

(def program stdlib.qwen3.norm.host-step : {((cap.own mem) val) ((cap.ref mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val) ({master.grid ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2)} stdlib.gpu.geometry.type.Grid)} :) ({({master.index u64} :) ({((cap.own mem) val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({((cap.own mem) val) (prop.Truth |-)} *) =
 ([input weight inverse out columns count grid pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ({[.input] [.weight] [.inverse] [.out] [.columns] [.count]} partial.stdlib.qwen3.norm.launch.6 [kernel.])
  ({[.grid] [.kernel]} unsafe.launch unit.elim)
  ({[.value] [.truth]} *.intro)
 ))
