# Transformer block template; dimensions are rendered from TransformerConfig.
(def program flux.single-block-owned : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) (u64 val) (f32 val) (f32 val)} -> ((cap.own mem) val)
= ([x mod rope in-weight out-weight qnorm knorm rows epsilon attention-scale.]
 ({[.rows] @hidden@} stdlib.models.memory.u64.mul [count.])
 ({[.x] [.x] [.x] [.rows] @hidden@ (const.u64.0x0000000000000001) (const.u64.0x0000000000000000) (const.u64.0x0000000000000000) [.epsilon]} flux.norm-bf16-ooo [normalized.])
 ({[.normalized] [.mod] [.count] @hidden@ (const.u64.0x0000000000000000)} flux.modulate-oo [modulated.])
 ({[.modulated] [.in-weight] [.rows] @hidden@ @qkv-ff@} flux.wmma-linear-bf16-or [projected.])
 ({[.rows] @hidden@} stdlib.models.memory.u64.mul [q-count.])
 ({[.projected] [.q-count] @qkv-ff@ @hidden@ (const.u64.0x0000000000000000)} flux.slice-bf16-o [q.])
 ({[.rows] @hidden@} stdlib.models.memory.u64.mul [k-count.])
 ({[.projected] [.k-count] @qkv-ff@ @hidden@ @hidden@} flux.slice-bf16-o [k.])
 ({[.rows] @hidden@} stdlib.models.memory.u64.mul [v-count.])
 ({[.projected] [.v-count] @qkv-ff@ @hidden@ @twice-hidden@} flux.slice-bf16-o [v.])
 ({[.rows] @heads@} stdlib.models.memory.u64.mul [head-rows.])
 ({[.q] [.qnorm] [.q] [.head-rows] @head-dim@ (const.u64.0x0000000000000001) (const.u64.0x0000000000000001) (const.u64.0x0000000000000001) [.epsilon]} flux.norm-bf16-oro [qn.])
 ({[.qn] [.rope] [.count] @hidden@} flux.apply-rope-oo [qr.])
 ({[.k] [.knorm] [.k] [.head-rows] @head-dim@ (const.u64.0x0000000000000001) (const.u64.0x0000000000000001) (const.u64.0x0000000000000001) [.epsilon]} flux.norm-bf16-oro [kn.])
 ({[.kn] [.rope] [.count] @hidden@} flux.apply-rope-oo [kr.])
 ({[.qr] [.kr] [.v] [.rows] [.rows] @heads@ @heads@ @head-dim@ [.attention-scale] (const.u64.0x0000000000000000) [.rows]} flux.wmma-fused-attention-bf16-ooo [attention.])
 ({[.rows] @ff@} stdlib.models.memory.u64.mul [ff-count.])
 ({[.projected] [.ff-count] @qkv-ff@ @ff@ @qkv-offset@} flux.swiglu-o [act.])
 ({[.rows] @combined@} stdlib.models.memory.u64.mul [combined-count.])
 ({[.attention] [.act] [.combined-count] @hidden@ @ff@} flux.concat-bf16-oo [combined.])
 ({[.combined] [.out-weight] [.rows] @combined@ @hidden@} flux.wmma-linear-bf16-or [projected-output.])
 ({[.x] [.projected-output] [.mod] [.count] @hidden@ @twice-hidden@} flux.gated-residual-ooo [output.])
 ({[.normalized] [.output]} stdlib.models.resources.free-bf16-before [after-free-0.])
 ({[.modulated] [.after-free-0]} stdlib.models.resources.free-bf16-before [after-free-1.])
 ({[.projected] [.after-free-1]} stdlib.models.resources.free-bf16-before [after-free-2.])
 ({[.q] [.after-free-2]} stdlib.models.resources.free-bf16-before [after-free-3.])
 ({[.k] [.after-free-3]} stdlib.models.resources.free-bf16-before [after-free-4.])
 ({[.v] [.after-free-4]} stdlib.models.resources.free-bf16-before [after-free-5.])
 ({[.qn] [.after-free-5]} stdlib.models.resources.free-bf16-before [after-free-6.])
 ({[.qr] [.after-free-6]} stdlib.models.resources.free-bf16-before [after-free-7.])
 ({[.kn] [.after-free-7]} stdlib.models.resources.free-bf16-before [after-free-8.])
 ({[.kr] [.after-free-8]} stdlib.models.resources.free-bf16-before [after-free-9.])
 ({[.attention] [.after-free-9]} stdlib.models.resources.free-bf16-before [after-free-10.])
 ({[.act] [.after-free-10]} stdlib.models.resources.free-bf16-before [after-free-11.])
 ({[.combined] [.after-free-11]} stdlib.models.resources.free-bf16-before [after-free-12.])
 ({[.projected-output] [.after-free-12]} stdlib.models.resources.free-bf16-before [after-free-13.])
 [.after-free-13]
))
