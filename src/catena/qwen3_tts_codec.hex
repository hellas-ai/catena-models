# Causal codec kernels. Rows are chronological and channels contiguous.

(def program stdlib.qwen-tts.codec-layer-stat :
 {((cap.own mem) val) (u64 val)
  ({({master.index32 u32} :) ({({(f32 val) (f32 val)} *) ({(({master.index32 master.end32} prop.Less) |-) (prop.Truth |-)} *)} *)} *)}
 -> ({({(f32 val) (f32 val)} *) (prop.Truth |-)} *) =
 ([input offset pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [stats proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ([.index] :.forget stdlib.models.memory.u32.to-u64 [i.])
  ([.stats] *.elim [sum sum-square.])
  ({[.offset] [.i]} stdlib.models.memory.u64.add [at.])
  ({[.input] [.at]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [x.])
  ({[.x] [.x]} stdlib.models.memory.f32.mul [square.])
  ({[.sum] [.x]} stdlib.models.memory.f32.add [next-sum.])
  ({[.sum-square] [.square]} stdlib.models.memory.f32.add [next-square.])
  ({[.next-sum] [.next-square]} *.intro [next.])
  ({[.next] [.truth]} *.intro)
 ))

(def program stdlib.qwen-tts.codec-depthwise-tap :
 {((cap.own mem) val) ((cap.ref mem) val) (u64 val) (u64 val) (u64 val)
  ({({master.index32 u32} :) ({(f32 val) ({(({master.index32 master.end32} prop.Less) |-) (prop.Truth |-)} *)} *)} *)}
 -> ({(f32 val) (prop.Truth |-)} *) =
 ([input weight row column cols pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [sum proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ([.index] :.forget stdlib.models.memory.u32.to-u64 [tap.])
  ({[.row] [.tap]} stdlib.models.memory.u64.add [target.])
  ({(const.u64.0x0000000000000006) [.target]} stdlib.models.memory.u64.less_equal [valid.])
  ({[.target] (const.u64.0x0000000000000006)} stdlib.models.memory.u64.sub [x-row.])
  ({[.valid] [.x-row] (const.u64.0x0000000000000000)} stdlib.models.memory.select-u64 [safe-row.])
  ({[.safe-row] [.cols]} stdlib.models.memory.u64.mul [x-offset.])
  ({[.x-offset] [.column]} stdlib.models.memory.u64.add [x-index.])
  ({[.input] [.x-index]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [raw.])
  ({[.valid] [.raw] (const.u32.0x00000000 u32.bitcast-f32)} stdlib.models.memory.select-f32 [x.])
  ({[.column] (const.u64.0x0000000000000007)} stdlib.models.memory.u64.mul [w-offset.])
  ({[.w-offset] [.tap]} stdlib.models.memory.u64.add [w-index.])
  ({[.weight] [.w-index]} stdlib.models.memory.ref-read-bf16 bf16.to-f32 [w.])
  ({[.x] [.w]} stdlib.models.memory.f32.mul [product.])
  ({[.sum] [.product]} stdlib.models.memory.f32.add [next.])
  ({[.next] [.truth]} *.intro)
 ))

# Element bodies
# Element rvq-lookup
  ({[.i] (const.u64.0x0000000000000100)} stdlib.models.memory.u64.div [row.])
  ({[.i] (const.u64.0x0000000000000100)} stdlib.models.memory.u64.rem [column.])
  ({[.row] [.start]} stdlib.models.memory.u64.add [frame.])
  ({[.progress] (const.u64.0x0000000000000000)} stdlib.models.memory.own-read-u64 [count.])
  ({[.frame] [.count]} stdlib.models.memory.u64.less [valid.])
  ({[.valid] [.frame] (const.u64.0x0000000000000000)} stdlib.models.memory.select-u64 [safe-frame.])
  ({[.safe-frame] (const.u64.0x0000000000000010)} stdlib.models.memory.u64.mul [frame-offset.])
  ({[.frame-offset] [.book]} stdlib.models.memory.u64.add [at.])
  ({[.codes] [.at]} stdlib.models.memory.own-read-u64 [code.])
  ({[.code] (const.u64.0x0000000000000100)} stdlib.models.memory.u64.mul [offset.])
  ({[.offset] [.column]} stdlib.models.memory.u64.add [index.])
  ({[.embedding] [.index]} stdlib.models.memory.ref-read-f32 [weight.])
  ({[.usage] [.code]} stdlib.models.memory.ref-read-f32 [usage-count.])
  ({[.usage-count] (const.u32.0x3727C5AC u32.bitcast-f32)} stdlib.models.memory.f32.max [divisor.])
  ({[.weight] [.divisor]} stdlib.models.memory.f32.div [x.])
  ({[.valid] [.x] (const.u32.0x00000000 u32.bitcast-f32)} stdlib.models.memory.select-f32 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-f32 unit.elim)
# Element rvq-sum
  ({[.out] [.i]} stdlib.models.memory.own-read-f32 [sum.])
  ({[.input] [.i]} stdlib.models.memory.own-read-f32 [next.])
  ({[.sum] [.next]} stdlib.models.memory.f32.add [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-f32 unit.elim)
# Element codec-rope
  ({[.i] (const.u64.0x0000000000000040)} stdlib.models.memory.u64.div stdlib.models.memory.fold-count-u32 stdlib.models.memory.u32.to-f32 [position.])
  ({[.i] (const.u64.0x0000000000000020)} stdlib.models.memory.u64.rem stdlib.qwen-tts.codec-rope-frequency [frequency.])
  ({[.position] [.frequency]} stdlib.models.memory.f32.mul stdlib.models.math.rope-sincos [sin cos.])
  ({[.i] (const.u64.0x0000000000000040)} stdlib.models.memory.u64.rem [part.])
  ({[.part] (const.u64.0x0000000000000020)} stdlib.models.memory.u64.less [first.])
  ({[.first] [.cos] [.sin]} stdlib.models.memory.select-f32 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-f32 unit.elim)
# Element codec-rotate
  ({[.i] (const.u64.0x0000000000000040)} stdlib.models.memory.u64.rem [channel.])
  ({[.channel] (const.u64.0x0000000000000020)} stdlib.models.memory.u64.less [low.])
  ({[.i] (const.u64.0x0000000000000020)} stdlib.models.memory.u64.add [plus.])
  ({[.i] (const.u64.0x0000000000000020)} stdlib.models.memory.u64.sub [minus.])
  ({[.low] [.plus] [.minus]} stdlib.models.memory.select-u64 [other.])
  ({[.input] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [x.])
  ({[.input] [.other]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [y.])
  ([.y] stdlib.models.memory.f32.negate [negative.])
  ({[.low] [.negative] [.y]} stdlib.models.memory.select-f32 [signed.])
  ({[.i] (const.u64.0x0000000000000400)} stdlib.models.memory.u64.div [row.])
  ({[.row] (const.u64.0x0000000000000040)} stdlib.models.memory.u64.mul [offset.])
  ({[.channel] (const.u64.0x0000000000000020)} stdlib.models.memory.u64.rem [pair.])
  ({[.offset] [.pair]} stdlib.models.memory.u64.add [cos-index.])
  ({[.cos-index] (const.u64.0x0000000000000020)} stdlib.models.memory.u64.add [sin-index.])
  ({[.rope] [.cos-index]} stdlib.models.memory.own-read-f32 [cos.])
  ({[.rope] [.sin-index]} stdlib.models.memory.own-read-f32 [sin.])
  ({[.x] [.cos]} stdlib.models.memory.f32.mul [cx.])
  ({[.signed] [.sin]} stdlib.models.memory.f32.mul [sy.])
  ({[.cx] [.sy]} stdlib.models.memory.f32.add [rotated.])
  ([.rotated] f32.to-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element causal-mask
  ({[.i] [.rows]} stdlib.models.memory.u64.rem [key.])
  ({[.i] [.rows]} stdlib.models.memory.u64.div [query-head.])
  ({[.query-head] (const.u64.0x0000000000000010)} stdlib.models.memory.u64.div [query.])
  ({[.key] [.query]} stdlib.models.memory.u64.less_equal [causal.])
  ({[.key] (const.u64.0x0000000000000048)} stdlib.models.memory.u64.add [window-end.])
  ({[.query] [.window-end]} stdlib.models.memory.u64.less [in-window.])
  ({[.causal] [.in-window]} stdlib.boolean.and [allowed.])
  ({[.scores] [.i]} stdlib.models.memory.own-read-f32 [score.])
  ({[.allowed] [.score] (const.u32.0xFF800000 u32.bitcast-f32)} stdlib.models.memory.select-f32 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-f32 unit.elim)
# Element scaled-residual
  ({[.i] [.width]} stdlib.models.memory.u64.rem [column.])
  ({[.input] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [x.])
  ({[.delta] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [y.])
  ({[.scale] [.column]} stdlib.models.memory.ref-read-f32 [scale-factor.])
  ({[.y] [.scale-factor]} stdlib.models.memory.f32.mul [scaled.])
  ({[.x] [.scaled]} stdlib.models.memory.f32.add f32.to-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element depthwise
  ({[.i] [.cols]} stdlib.models.memory.u64.div [row.])
  ({[.i] [.cols]} stdlib.models.memory.u64.rem [column.])
  ({[.bias] [.column]} stdlib.models.memory.ref-read-bf16 bf16.to-f32 [shift.])
  ({[.input] [.weight] [.row] [.column] [.cols]} partial.stdlib.qwen-tts.codec-depthwise-tap.5 [tap.])
  ({(const.u32.0x00000007) (unit.intro meta.master.end32)} smolcat.value.named_at [end.])
  ({[.end] [.shift] [.tap] core.truth} core.fold.bounded [sum proof.])
  ([.proof] unsafe.discard unit.elim)
  ([.sum] f32.to-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element layer-stats
  ({[.i] (const.u64.0x0000000000000400)} stdlib.models.memory.u64.mul [base.])
  ({[.input] [.base]} partial.stdlib.qwen-tts.codec-layer-stat.2 [accumulate.])
  ({(const.u32.0x00000400) (unit.intro meta.master.end32)} smolcat.value.named_at [end.])
  ({(const.u32.0x00000000 u32.bitcast-f32) (const.u32.0x00000000 u32.bitcast-f32)} *.intro [initial.])
  ({[.end] [.initial] [.accumulate] core.truth} core.fold.bounded [stats proof.])
  ([.proof] unsafe.discard unit.elim)
  ([.stats] *.elim [sum squares.])
  ({[.sum] (const.u32.0x3A800000 u32.bitcast-f32)} stdlib.models.memory.f32.mul [mean.])
  ({[.squares] (const.u32.0x3A800000 u32.bitcast-f32)} stdlib.models.memory.f32.mul [mean-square.])
  ({[.mean] [.mean]} stdlib.models.memory.f32.mul [squared-mean.])
  ({[.mean-square] [.squared-mean]} stdlib.models.memory.f32.sub [variance.])
  ({[.variance] (const.u32.0x00000000 u32.bitcast-f32)} stdlib.models.memory.f32.max [safe-var.])
  ({[.safe-var] (const.u32.0x358637BD u32.bitcast-f32)} stdlib.models.memory.f32.add stdlib.models.math.sqrt [std.])
  ({(const.u32.0x3F800000 u32.bitcast-f32) [.std]} stdlib.models.memory.f32.div [inv.])
  ({[.i] (const.u64.0x0000000000000002)} stdlib.models.memory.u64.mul [index.])
  ({[.index] (const.u64.0x0000000000000001)} stdlib.models.memory.u64.add [next.])
  ({[.out] [.index] [.mean]} stdlib.models.memory.write-f32 unit.elim)
  ({[.out] [.next] [.inv]} stdlib.models.memory.write-f32 unit.elim)
# Element layer-norm
  ({[.i] (const.u64.0x0000000000000400)} stdlib.models.memory.u64.div [row.])
  ({[.i] (const.u64.0x0000000000000400)} stdlib.models.memory.u64.rem [column.])
  ({[.row] (const.u64.0x0000000000000002)} stdlib.models.memory.u64.mul [index.])
  ({[.index] (const.u64.0x0000000000000001)} stdlib.models.memory.u64.add [next.])
  ({[.stats] [.index]} stdlib.models.memory.own-read-f32 [mean.])
  ({[.stats] [.next]} stdlib.models.memory.own-read-f32 [inv.])
  ({[.weight] [.column]} stdlib.models.memory.ref-read-f32 [scale.])
  ({[.bias] [.column]} stdlib.models.memory.ref-read-f32 [shift.])
  ({[.input] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [x.])
  ({[.x] [.mean]} stdlib.models.memory.f32.sub [centered.])
  ({[.centered] [.inv]} stdlib.models.memory.f32.mul [norm.])
  ({[.norm] [.scale]} stdlib.models.memory.f32.mul [scaled.])
  ({[.scaled] [.shift]} stdlib.models.memory.f32.add f32.to-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element gelu
  ({[.input] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 stdlib.whisper.gelu f32.to-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element snake-beta
  ({[.i] [.width]} stdlib.models.memory.u64.rem [column.])
  ({[.input] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [x.])
  ({[.alpha] [.column]} stdlib.models.memory.ref-read-f32 stdlib.models.math.exp [a.])
  ({[.beta] [.column]} stdlib.models.memory.ref-read-f32 stdlib.models.math.exp [b.])
  # sin² is even. The shared range reducer accepts nonnegative angles.
  ({[.a] [.x]} stdlib.models.memory.f32.mul [angle.])
  ([.angle] stdlib.models.memory.f32.negate [negative.])
  ({[.angle] [.negative]} stdlib.models.memory.f32.max stdlib.models.math.rope-sincos [sin cos.])
  ({[.sin] [.sin]} stdlib.models.memory.f32.mul [square.])
  ({[.b] (const.u32.0x3089705F u32.bitcast-f32)} stdlib.models.memory.f32.add [denominator.])
  ({[.square] [.denominator]} stdlib.models.memory.f32.div [delta.])
  ({[.x] [.delta]} stdlib.models.memory.f32.add f32.to-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element copy-wave
  ({[.skip] [.i]} stdlib.models.memory.u64.add [index.])
  ({[.input] [.index]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [value.])
  ({[.value] (const.u32.0xBF800000 u32.bitcast-f32)} stdlib.models.memory.f32.max [at-least.])
  ({(const.u32.0x3F800000 u32.bitcast-f32) [.at-least]} stdlib.models.memory.f32.less [above.])
  ({[.above] (const.u32.0x3F800000 u32.bitcast-f32) [.at-least]} stdlib.models.memory.select-f32 [clipped.])
  ({[.offset] [.i]} stdlib.models.memory.u64.add [target.])
  ({[.out] [.target] [.clipped]} stdlib.models.memory.write-f32 unit.elim)
