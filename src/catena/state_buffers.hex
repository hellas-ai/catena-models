# Model-owned GPU allocation and zeroing.

(def program stdlib.qwen3.state.zero-bf16 : {((cap.own mem) val) (u64 val)} -> 1 =
 ([out index.]
  (const.u32.0x00000000 u32.bitcast-f32 f32.to-bf16 [zero.])
  ({[.out] [.index] [.zero]} stdlib.qwen3.memory.write-bf16 unit.elim)
  (unit.intro)
 ))

(def program stdlib.qwen3.state.zero-bf16.yes : {((cap.own mem) val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([out pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  ([.unit] unit.elim)
  ({[.out] [.index]} stdlib.qwen3.state.zero-bf16)
 ))

(def program stdlib.qwen3.state.zero-bf16.no : {((cap.own mem) val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([out pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  [.unit]
 ))

(def program stdlib.qwen3.state.zero-bf16.launch : {((cap.own mem) val) (u64 val) ({({master.block ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid} stdlib.gpu.geometry.type.Block)} :) (({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid master.block} stdlib.gpu.geometry.type.Thread) val)} *)} -> 1 =
 ([out count pair.]
  ([.pair] stdlib.qwen3.memory.thread-index [index.])
  ({[.index] [.count]} stdlib.qwen3.memory.u64.less [valid.])
  ({[.valid] (unit.intro meta.master.predicate)} smolcat.value.named_at :.forget [condition.])
  ({[.out]} partial.stdlib.qwen3.state.zero-bf16.yes.1 [yes.])
  ({[.out]} partial.stdlib.qwen3.state.zero-bf16.no.1 [no.])
  ({[.condition] [.index] [.yes] [.no] unit.intro} core.if)
 ))

(def program stdlib.qwen3.state.zero-bf16.host : {((cap.own mem) val) (u64 val) ({master.grid ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2)} stdlib.gpu.geometry.type.Grid)} :) ({({master.index u64} :) ({((cap.own mem) val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({((cap.own mem) val) (prop.Truth |-)} *) =
 ([out count grid pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ({[.out] [.count]} partial.stdlib.qwen3.state.zero-bf16.launch.2 [kernel.])
  ({[.grid] [.kernel]} unsafe.launch unit.elim)
  ({[.value] [.truth]} *.intro)
 ))

(def program stdlib.qwen3.state-zero-bf16 : {(u64 val)} -> ((cap.own mem) val) =
 ([count.]
  ([.count] stdlib.qwen3.memory.alloc-bf16 [out.])
  ({[.count] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
  ({[.padded] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.div [blocks.])
  ([.blocks] stdlib.qwen3.memory.grid [grid.])
  ({[.out] [.count] [.grid]} partial.stdlib.qwen3.state.zero-bf16.host.3 [callback.])
  ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [end.])
  ({[.end] [.out] [.callback] core.truth} core.fold.bounded_u64 [complete proof.])
  ([.proof] unsafe.discard unit.elim)
  [.complete]
 ))

