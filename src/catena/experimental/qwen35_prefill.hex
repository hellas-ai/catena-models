 ))
(def program stdlib.qwen35.prefill.embedding.launch : {((cap.ref mem) val) ((cap.ref mem) val) ((cap.own mem) val) (u64 val) (u64 val) ({({master.block ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid} stdlib.gpu.geometry.type.Block)} :) (({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid master.block} stdlib.gpu.geometry.type.Thread) val)} *)} -> 1 =
 ([tokens weight out token-index count pair.]
  ([.pair] stdlib.qwen3.memory.thread-index [index.])
  ({[.index] [.count]} stdlib.qwen3.memory.u64.less [valid.])
  ({[.valid] (unit.intro meta.master.predicate)} smolcat.value.named_at :.forget [condition.])
  ({[.tokens] [.weight] [.out] [.token-index]} partial.stdlib.qwen35.prefill.embedding.yes.4 [yes.])
  ({[.tokens] [.weight] [.out] [.token-index]} partial.stdlib.qwen35.prefill.embedding.no.4 [no.])
  ({[.condition] [.index] [.yes] [.no] unit.intro} core.if)
 ))
(def program stdlib.qwen35.prefill.embed : {((cap.ref mem) val) ((cap.ref mem) val) (u64 val)} -> ((cap.own mem) val) =
 ([tokens weight token-index.]
  ([.tokens] stdlib.qwen3.memory.ref-count-u64 [rows.])
  ({[.rows] (const.u64.0x{{HIDDEN_SIZE}})} stdlib.qwen3.memory.u64.mul [count.])
  ([.count] stdlib.qwen3.memory.alloc-bf16 [out.])
  ({[.count] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
  ({[.padded] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.div [blocks.])
  ([.blocks] stdlib.qwen3.memory.grid [grid.])
  ({[.tokens] [.weight] [.out] [.token-index] [.count] [.grid]} partial.stdlib.qwen35.prefill.embedding.host-step.6 [host-callback.])
  ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [host-end.])
  ({[.host-end] [.out] [.host-callback] core.truth} core.fold.bounded_u64 [complete proof.])
  ([.proof] unsafe.discard unit.elim)
  [.complete]
 ))

(def program stdlib.qwen35.prefill.embedding.host-step : {((cap.ref mem) val) ((cap.ref mem) val) ((cap.own mem) val) (u64 val) (u64 val) ({master.grid ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2)} stdlib.gpu.geometry.type.Grid)} :) ({({master.index u64} :) ({((cap.own mem) val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({((cap.own mem) val) (prop.Truth |-)} *) =
 ([tokens weight out token-index count grid pair.]
