# Cooperative BF16 projections, fused residual and dual projection SwiGLU.
# Eight rows per block, 32 lanes per row. All barriers are block uniform.
(def program stdlib.qwen3.fused.dot : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) (u64 val) ({(u64 val) (f32 val)} *)} -> (f32 val) =
 ([input weight base lane pair.]
  ([.pair] *.elim [i acc.])
  ({[.i] (const.u64.0x0000000000000020)} stdlib.qwen3.memory.u64.mul [stride.])
  ({[.stride] [.lane]} stdlib.qwen3.memory.u64.add [ix.])
  ({[.base] [.ix]} stdlib.qwen3.memory.u64.add [wi.])
  ({[.input] [.ix]} stdlib.qwen3.memory.own-read-bf16x2 [a.])
  ({[.weight] [.wi]} stdlib.qwen3.memory.ref-read-bf16x2 [b.])
  ({[.a] [.b] [.acc]} bf16x2.dot-f32 [sum.])
  [.sum]
 ))
