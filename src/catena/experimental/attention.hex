 ))
(def program qwen3.append : {((cap.own mem) val) ((cap.own mem) val) (u64 val)} -> ((cap.own mem) val) =
 ([input cache offset.]
  ([.input] stdlib.qwen3.memory.own-count-bf16 [count.])
  ({[.count] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
  ({[.padded] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.div [blocks.])
  ([.blocks] stdlib.qwen3.memory.grid [grid.])
  ({[.input] [.cache] [.offset] [.count] [.grid]} partial.stdlib.qwen3.append.host-step.5 [host-callback.])
  ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [host-end.])
  ({[.host-end] [.cache] [.host-callback] core.truth} core.fold.bounded_u64 [complete proof.])
  ([.proof] unsafe.discard unit.elim)
  [.complete]
 ))
(def program stdlib.qwen3.score-dot : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val) ({(u64 val) (f32 val)} *)} -> (f32 val) =
