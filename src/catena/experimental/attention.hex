# Experimental Qwen3: explicit typed memory and guarded launches.
# A one-iteration host fold returns each launched buffer as loop state. This
# preserves an ordering edge after unit ports are erased by product unpacking.

(def program stdlib.qwen3.append : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val)} -> 1 =
 ([input cache offset index.]
  ({[.input] [.index]} stdlib.qwen3.memory.own-read-bf16 [value.])
  ({[.offset] [.index]} stdlib.qwen3.memory.u64.add [target.])
  ({[.cache] [.target] [.value]} stdlib.qwen3.memory.write-bf16)
  (unit.elim)
  (unit.intro)
 ))
(def program stdlib.qwen3.append.yes : {((cap.own mem) val) ((cap.own mem) val) (u64 val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([input cache offset pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  ([.unit] unit.elim)
  ({[.input] [.cache] [.offset] [.index]} stdlib.qwen3.append)

 ))
