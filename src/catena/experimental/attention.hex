  ({[.index] [.keys]} stdlib.qwen3.memory.u64.rem [key.])
  ({[.head] (const.u64.0x{{HEAD_HALF_DIM}})} stdlib.qwen3.memory.u64.mul [qb.])
  ({[.head] (const.u64.0x{{QUERY_HEADS_PER_KV_HEAD}})} stdlib.qwen3.memory.u64.div [kv-head.])
  ({[.key] (const.u64.0x{{KEY_VALUE_SIZE}})} stdlib.qwen3.memory.u64.mul [row.])
  ({[.kv-head] (const.u64.0x{{HEAD_DIM}})} stdlib.qwen3.memory.u64.mul [hb.])
  ({[.row] [.hb]} stdlib.qwen3.memory.u64.add [local.])
  ({[.local] [.key-offset]} stdlib.qwen3.memory.u64.add [global.])
  ({[.global] (const.u64.0x0000000000000002)} stdlib.qwen3.memory.u64.div [kb.])
  (const.u64.0x{{HEAD_HALF_DIM}} [pairs.])
  ({[.query] [.cache] [.qb] [.kb]} partial.stdlib.qwen3.score-dot.fold.4 [callback.])
  ({[.pairs] (unit.intro meta.master.end)} smolcat.value.named_at [end.])
