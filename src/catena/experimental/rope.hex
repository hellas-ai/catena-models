# Experimental Qwen3: explicit typed memory and guarded launches.
# A one-iteration host fold returns each launched buffer as loop state. This
# preserves an ordering edge after unit ports are erased by product unpacking.

(def program stdlib.qwen3.rope-table : {(u64 val) ((cap.own mem) val) (u64 val)} -> 1 =
 ([start out index.]
  ({[.index] (const.u64.0x{{ROPE_HALF_DIM}})} stdlib.qwen3.memory.u64.rem [pair.])
  ([.start] stdlib.qwen3.memory.fold-count-u32 stdlib.qwen3.memory.u32.to-f32 [position.])
  ([.pair] qwen3.rope-frequency [frequency.])
  ({[.position] [.frequency]} stdlib.qwen3.memory.f32.mul [angle.])
  ([.angle] qwen3.rope-sincos [sine cosine.])
  ({[.index] (const.u64.0x{{ROPE_HALF_DIM}})} stdlib.qwen3.memory.u64.less [first.])
  ({[.first] [.cosine] [.sine]} stdlib.qwen3.memory.select-f32 [value.])
  ({[.out] [.index] [.value]} stdlib.qwen3.memory.write-f32)
  (unit.elim)
  (unit.intro)
 ))
(def program stdlib.qwen3.rope-table.yes : {(u64 val) ((cap.own mem) val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([start out pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  ([.unit] unit.elim)
  ({[.start] [.out] [.index]} stdlib.qwen3.rope-table)

 ))
(def program stdlib.qwen3.rope-table.no : {(u64 val) ((cap.own mem) val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([start out pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  [.unit]
 ))
(def program stdlib.qwen3.rope-table.launch : {(u64 val) ((cap.own mem) val) (u64 val) ({({master.block ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid} stdlib.gpu.geometry.type.Block)} :) (({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid master.block} stdlib.gpu.geometry.type.Thread) val)} *)} -> 1 =
 ([start out count pair.]
  ([.pair] stdlib.qwen3.memory.thread-index [index.])
  ({[.index] [.count]} stdlib.qwen3.memory.u64.less [valid.])
  ({[.valid] (unit.intro meta.master.predicate)} smolcat.value.named_at :.forget [condition.])
  ({[.start] [.out]} partial.stdlib.qwen3.rope-table.yes.2 [yes.])
  ({[.start] [.out]} partial.stdlib.qwen3.rope-table.no.2 [no.])
  ({[.condition] [.index] [.yes] [.no] unit.intro} core.if)
 ))
(def program qwen3.rope-one : {(u64 val)} -> ((cap.own mem) val) =
 ([start.]
  (const.u64.0x{{ROPE_DIM}} [count.])
  ([.count] stdlib.qwen3.memory.alloc-f32 [out.])
  ({[.count] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
  ({[.padded] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.div [blocks.])
  ([.blocks] stdlib.qwen3.memory.grid [grid.])
  ({[.start] [.out] [.count] [.grid]} partial.stdlib.qwen3.rope-table.host-step.4 [host-callback.])
  ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [host-end.])
  ({[.host-end] [.out] [.host-callback] core.truth} core.fold.bounded_u64 [complete proof.])
  ([.proof] unsafe.discard unit.elim)
  [.complete]
 ))
(def program stdlib.qwen3.rotate : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val)} -> 1 =
 ([input rope out index.]
  ({[.index] (const.u64.0x{{HEAD_DIM}})} stdlib.qwen3.memory.u64.rem [channel.])
  ({[.index] [.channel]} stdlib.qwen3.memory.u64.sub [base.])
  ({[.channel] (const.u64.0x{{ROPE_HALF_DIM}})} stdlib.qwen3.memory.u64.rem [pair.])
  ({[.pair] (const.u64.0x{{ROPE_HALF_DIM}})} stdlib.qwen3.memory.u64.add [second.])
  ({[.channel] (const.u64.0x{{ROPE_HALF_DIM}})} stdlib.qwen3.memory.u64.less [first.])
  ({[.first] [.second] [.pair]} stdlib.qwen3.memory.select-u64 [partner.])
  ({[.base] [.partner]} stdlib.qwen3.memory.u64.add [partner-index.])
  ({[.input] [.index]} stdlib.qwen3.memory.own-read-bf16 [av.])
  ({[.input] [.partner-index]} stdlib.qwen3.memory.own-read-bf16 [bv.])
  ([.av] bf16.to-f32 [a.])
  ([.bv] bf16.to-f32 [b.])
  ({[.rope] [.pair]} stdlib.qwen3.memory.own-read-f32 [cosine.])
  ({[.rope] [.second]} stdlib.qwen3.memory.own-read-f32 [sine.])
  ({[.a] [.cosine]} stdlib.qwen3.memory.f32.mul [ac.])
  ({[.b] [.sine]} stdlib.qwen3.memory.f32.mul [bs.])
  ({[.ac] [.bs]} stdlib.qwen3.memory.f32.sub [low.])
  ({[.ac] [.bs]} stdlib.qwen3.memory.f32.add [high.])
  ({[.first] [.low] [.high]} stdlib.qwen3.memory.select-f32 [rotated.])
  ({[.channel] (const.u64.0x{{ROPE_DIM}})} stdlib.qwen3.memory.u64.less [rotary.])
  ({[.rotary] [.rotated] [.a]} stdlib.qwen3.memory.select-f32 [value.])
  ([.value] f32.to-bf16 [result.])
  ({[.out] [.index] [.result]} stdlib.qwen3.memory.write-bf16)
  (unit.elim)
  (unit.intro)
 ))
(def program stdlib.qwen3.rotate.yes : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([input rope out pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  ([.unit] unit.elim)
  ({[.input] [.rope] [.out] [.index]} stdlib.qwen3.rotate)

 ))
(def program stdlib.qwen3.rotate.no : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([input rope out pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  [.unit]
 ))
(def program stdlib.qwen3.rotate.launch : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) ({({master.block ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid} stdlib.gpu.geometry.type.Block)} :) (({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid master.block} stdlib.gpu.geometry.type.Thread) val)} *)} -> 1 =
 ([input rope out count pair.]
  ([.pair] stdlib.qwen3.memory.thread-index [index.])
  ({[.index] [.count]} stdlib.qwen3.memory.u64.less [valid.])
  ({[.valid] (unit.intro meta.master.predicate)} smolcat.value.named_at :.forget [condition.])
  ({[.input] [.rope] [.out]} partial.stdlib.qwen3.rotate.yes.3 [yes.])
  ({[.input] [.rope] [.out]} partial.stdlib.qwen3.rotate.no.3 [no.])
  ({[.condition] [.index] [.yes] [.no] unit.intro} core.if)
 ))
(def program qwen3.rotate : {((cap.own mem) val) ((cap.own mem) val)} -> ((cap.own mem) val) =
 ([input rope.]
  ([.input] stdlib.qwen3.memory.own-count-bf16 [count.])
  ([.count] stdlib.qwen3.memory.alloc-bf16 [out.])
  ({[.count] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
  ({[.padded] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.div [blocks.])
  ([.blocks] stdlib.qwen3.memory.grid [grid.])
  ({[.input] [.rope] [.out] [.count] [.grid]} partial.stdlib.qwen3.rotate.host-step.5 [host-callback.])
  ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [host-end.])
  ({[.host-end] [.out] [.host-callback] core.truth} core.fold.bounded_u64 [complete proof.])
  ([.proof] unsafe.discard unit.elim)
  [.complete]
 ))

(def program stdlib.qwen3.rope-table.host-step : {(u64 val) ((cap.own mem) val) (u64 val) ({master.grid ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2)} stdlib.gpu.geometry.type.Grid)} :) ({({master.index u64} :) ({((cap.own mem) val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({((cap.own mem) val) (prop.Truth |-)} *) =
 ([start out count grid pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ({[.start] [.out] [.count]} partial.stdlib.qwen3.rope-table.launch.3 [kernel.])
  ({[.grid] [.kernel]} unsafe.launch unit.elim)
  ({[.value] [.truth]} *.intro)
 ))

(def program stdlib.qwen3.rotate.host-step : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) ({master.grid ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2)} stdlib.gpu.geometry.type.Grid)} :) ({({master.index u64} :) ({((cap.own mem) val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({((cap.own mem) val) (prop.Truth |-)} *) =
 ([input rope out count grid pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ({[.input] [.rope] [.out] [.count]} partial.stdlib.qwen3.rotate.launch.4 [kernel.])
  ({[.grid] [.kernel]} unsafe.launch unit.elim)
  ({[.value] [.truth]} *.intro)
 ))

