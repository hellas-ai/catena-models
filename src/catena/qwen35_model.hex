(def program qwen3.qwen35-delta-at :
  ([n.] {({({(cap.own mem) (cap.own mem)} *) (cap.own mem)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [conv-and-prediction beta.])
  ([.conv-and-prediction] *.elim [conv prediction.])
  ([.output-index] ix.to-u64 [index.])
  (const.u64.0x{{LINEAR_KEY_SIZE}} [key-size.])
  ([.key-size key-size] u64.add [value-base.])
  (const.u64.0x{{LINEAR_VALUE_HEAD_DIM}} [value-dim.])
  ([.index value-dim] u64.div [head.])
  ([.value-base index] u64.add [conv-index.])
  ([.conv] mem.cast.f32 [conv-count conv-buffer.])
  ({[.conv-count] [.conv-buffer] [.conv-index]} qwen3.f32-buffer-at [value.])
  ([.prediction] mem.cast.f32 [prediction-count prediction-buffer.])
  ({[.prediction-count] [.prediction-buffer] [.index]} qwen3.f32-buffer-at [predicted.])
  ([.beta] mem.cast.f32 [beta-count beta-buffer.])
  ({[.beta-count] [.beta-buffer] [.head]} qwen3.f32-buffer-at [beta-value.])
  ([.value predicted] f32.sub [difference.])
  ([.difference beta-value] f32.mul [result.])
  [.result]
))

