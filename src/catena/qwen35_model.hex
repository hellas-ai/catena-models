(def program qwen3.qwen35-conv :
  {(cap.own mem) (cap.own mem) (cap.ref mem) (u64 val)}
  ->
  (cap.own mem)
= ([history qkv conv-weight start.]
  (const.u64.0x{{LINEAR_QKV_SIZE}} [qkv-size-value.])
  (const.u64.0x{{LINEAR_CONV_KERNEL}} [kernel-size-value.])
  ([.qkv-size-value] u64.name [qkv-size.])
  ([.kernel-size-value] u64.name [kernel-size.])
  ({[.history] [.qkv]} *.intro [history-and-qkv.])
  ({[.history-and-qkv] [.conv-weight]} *.intro [buffers.])
  ({[.buffers] [.start]} *.intro [env.])
  {
    [.qkv-size] [.kernel-size] [.env]
    ({([.qkv-size] :.param) ([.kernel-size] :.param)} name.qwen3.qwen35-conv-term-at)
