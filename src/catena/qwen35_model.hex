(def program qwen3.qwen35-l2-term-at :
  ([n.] {({({(cap.own mem) (u64 val)} *) (u64 val)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([env channel-index.]
  ([.env] *.elim [input-and-base head.])
  ([.input-and-base] *.elim [input base.])
  ([.channel-index] ix.to-u64 [channel.])
  (const.u64.0x{{LINEAR_KEY_HEAD_DIM}} [head-dim.])
  ([.head head-dim] u64.mul [head-offset.])
  ([.base head-offset] u64.add [head-base.])
  ([.head-base channel] u64.add [index.])
  ([.input] mem.cast.f32 [count buffer.])
  ({[.count] [.buffer] [.index]} qwen3.f32-buffer-at [value.])
  ([.value value] f32.mul [result.])
  [.result]
))

(def program qwen3.qwen35-l2-at :
  ([n.] {({(cap.own mem) (u64 val)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([input-and-base output-index.]
  ([.input-and-base] *.elim [input base.])
  ([.output-index] ix.to-u64 [flat-index.])
  (const.u64.0x{{LINEAR_KEY_HEAD_DIM}} [head-dim-value.])
  ([.flat-index head-dim-value] u64.div [head.])
  ([.flat-index head-dim-value] u64.rem [channel.])
  ({[.input] [.base]} *.intro [term-input-and-base.])
  ({[.term-input-and-base] [.head]} *.intro [term-env.])
  ([.head-dim-value] u64.name [head-dim.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro name.f32.add-env
    ({[.term-env] (([.head-dim] :.param) name.qwen3.qwen35-l2-term-at)})
    [.head-dim]
  } reducec [sum-squared.])
  (const.u32.0x358637BD u32.bitcast-f32 [epsilon.])
  ([.sum-squared epsilon] f32.add qwen3.sqrt [norm.])
  ([.base flat-index] u64.add [input-index.])
  ([.input] mem.cast.f32 [count buffer.])
  ({[.count] [.buffer] [.input-index]} qwen3.f32-buffer-at [value.])
  ([.value norm] f32.div [result.])
  [.result]
))

