(def program qwen3.qwen35-update-conv-cache :
  {(cap.own mem) (cap.own mem) (u64 val) (u64 val) (u64 val)}
  ->
  (cap.own mem)
= ([cache qkv token-capacity start layer.]
  ([.cache] mem.cast.f32 [cache-count cache-buffer.])
  (const.u64.0x{{KV_CACHE_ELEMENTS_PER_TOKEN}} [kv-elements-per-token.])
  ([.token-capacity kv-elements-per-token] u64.mul [recurrent-base.])
  (const.u64.0x{{LINEAR_CONV_STATE_SIZE}} [conv-state-size.])
  (const.u64.0x{{LINEAR_RECURRENT_STATE_SIZE}} [matrix-state-size.])
  ([.conv-state-size matrix-state-size] u64.add [layer-stride.])
  ([.layer layer-stride] u64.mul [layer-offset.])
  ([.recurrent-base layer-offset] u64.add [conv-base.])
  (const.u64.0x{{LINEAR_CONV_KERNEL}} [kernel-size.])
  (const.u64.0x0000000000000001 [one.])
  ([.kernel-size one] u64.sub [history-slots.])
  ([.start history-slots] u64.rem [slot.])
  (const.u64.0x{{LINEAR_QKV_SIZE}} [qkv-size-value.])
  ([.slot qkv-size-value] u64.mul [slot-offset.])
  ([.conv-base slot-offset] u64.add [write-offset.])
  ([.qkv-size-value] u64.name [qkv-size.])
  {
    [.cache-buffer] [.cache-count] [.write-offset] [.qkv-size] [.qkv]
    (([.qkv-size] :.param) name.qwen3.qwen35-copy-qkv-at)
  } materializec.into [cache-after.]
  ({[.cache-count] [.cache-after]} buf.to-mem)
))

