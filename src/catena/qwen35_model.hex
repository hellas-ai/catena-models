  ([.value-head key-heads] u64.rem [key-head.])
  ([.value-head key-dim] u64.mul [state-head-base-0.])
  ([.state-head-base-0 value-dim] u64.mul [state-head-base.])
  ([.key-channel value-dim] u64.mul [state-key-offset.])
  ([.state-head-base state-key-offset] u64.add [state-key-base.])
  ([.state-key-base value-channel] u64.add [state-index.])
  ([.state] mem.cast.f32 [state-count state-buffer.])
  ({[.state-count] [.state-buffer] [.state-index]} qwen3.f32-buffer-at [state-value.])
  ([.key-head key-dim] u64.mul [key-head-base.])
  ([.key-head-base key-channel] u64.add [flat-key-index.])
  ([.key] mem.cast.f32 [key-count key-buffer.])
  ({[.key-count] [.key-buffer] [.flat-key-index]} qwen3.f32-buffer-at [key-value.])
  ([.state-value key-value] f32.mul [result.])
  [.result]
))

