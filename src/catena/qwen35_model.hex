(def program qwen3.qwen35-update-state-at :
  ([n.] {({({(cap.own mem) (cap.own mem)} *) (cap.own mem)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [state-and-key delta.])
  ([.state-and-key] *.elim [state key.])
  ([.output-index] ix.to-u64 [index.])
  (const.u64.0x{{LINEAR_KEY_HEAD_DIM}} [key-dim.])
  (const.u64.0x{{LINEAR_VALUE_HEAD_DIM}} [value-dim.])
  (const.u64.0x{{LINEAR_KEY_HEADS}} [key-heads.])
  ([.key-dim value-dim] u64.mul [head-stride.])
  ([.index head-stride] u64.div [value-head.])
  ([.index head-stride] u64.rem [within-head.])
  ([.within-head value-dim] u64.div [key-channel.])
  ([.within-head value-dim] u64.rem [value-channel.])
  ([.value-head key-heads] u64.rem [key-head.])
  ([.key-head key-dim] u64.mul [key-head-base.])
  ([.key-head-base key-channel] u64.add [key-index.])
  ([.value-head value-dim] u64.mul [delta-head-base.])
  ([.delta-head-base value-channel] u64.add [delta-index.])
  ([.state] mem.cast.f32 [state-count state-buffer.])
  ({[.state-count] [.state-buffer] [.index]} qwen3.f32-buffer-at [state-value.])
  ([.key] mem.cast.f32 [key-count key-buffer.])
  ({[.key-count] [.key-buffer] [.key-index]} qwen3.f32-buffer-at [key-value.])
  ([.delta] mem.cast.f32 [delta-count delta-buffer.])
  ({[.delta-count] [.delta-buffer] [.delta-index]} qwen3.f32-buffer-at [delta-value.])
  ([.key-value delta-value] f32.mul [outer.])
  ([.state-value outer] f32.add [result.])
  [.result]
))

