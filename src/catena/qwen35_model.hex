# Metadata-parameterized Qwen3.5 dense hybrid operations.

# Extract Q from the per-head [Q, gate] projection layout.
(def program qwen3.qwen35-query-at :
  ([n.] {(cap.own mem) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([qg output-index.]
  ([.output-index] ix.to-u64 [flat-index.])
  (const.u64.0x{{QUERY_SIZE}} [query-size.])
  (const.u64.0x{{HEAD_DIM}} [head-dim.])
  ([.flat-index query-size] u64.div [row.])
  ([.flat-index query-size] u64.rem [query-channel.])
  ([.query-channel head-dim] u64.div [head.])
  ([.query-channel head-dim] u64.rem [channel.])
  ([.query-size query-size] u64.add [qg-row-size.])
  ([.head head-dim] u64.mul [head-offset.])
  ([.head-offset head-offset] u64.add [qg-head-offset.])
  ([.row qg-row-size] u64.mul [row-offset.])
  ([.row-offset qg-head-offset] u64.add [head-base.])
  ([.head-base channel] u64.add [qg-index.])
  ([.qg] mem.cast.f32 [qg-count qg-buffer.])
  ({[.qg-count] [.qg-buffer] [.qg-index]} qwen3.f32-buffer-at [result.])
  [.result]
))

(def program qwen3.qwen35-extract-query :
  (cap.own mem)
  ->
  (cap.own mem)
= ([qg.]
  ([.qg] mem.cast.f32 [qg-count qg-buffer.])
  ([.qg-count] :.forget [qg-count-value.])
  (const.u64.0x0000000000000002 [two.])
  ([.qg-count-value two] u64.div [query-count-value.])
  ([.query-count-value] u64.name [query-count.])
  {
    [.query-count]
    ({[.query-count] [.qg] (([.query-count] :.param) name.qwen3.qwen35-query-at)} materializec)
  } buf.to-mem
))

# Multiply full-attention context by sigmoid of the Q projection's gate half.
(def program qwen3.qwen35-gate-context-at :
  ([n.] {({(cap.own mem) (cap.own mem)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [qg context.])
  ([.output-index] ix.to-u64 [flat-index.])
  (const.u64.0x{{QUERY_SIZE}} [query-size.])
  (const.u64.0x{{HEAD_DIM}} [head-dim.])
  ([.flat-index query-size] u64.div [row.])
  ([.flat-index query-size] u64.rem [query-channel.])
  ([.query-channel head-dim] u64.div [head.])
  ([.query-channel head-dim] u64.rem [channel.])
  ([.query-size query-size] u64.add [qg-row-size.])
  ([.head head-dim] u64.mul [head-offset.])
  ([.head-offset head-offset] u64.add [qg-head-offset.])
  ([.qg-head-offset head-dim] u64.add [gate-head-offset.])
  ([.row qg-row-size] u64.mul [row-offset.])
  ([.row-offset gate-head-offset] u64.add [gate-base.])
  ([.gate-base channel] u64.add [gate-index.])
  ([.qg] mem.cast.f32 [qg-count qg-buffer.])
  ({[.qg-count] [.qg-buffer] [.gate-index]} qwen3.f32-buffer-at [gate.])
  ([.gate] qwen3.sigmoid [gate-sigmoid.])
  ([.context] mem.cast.f32 [context-count context-buffer.])
  ({[.context-count] [.context-buffer] [.flat-index]} qwen3.f32-buffer-at [context-value.])
  ([.context-value gate-sigmoid] f32.mul [result.])
  [.result]
))

(def program qwen3.qwen35-gate-context :
  {(cap.own mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([qg context.]
  ([.qg] mem.cast.f32 [qg-count qg-buffer.])
  ([.context] mem.cast.f32 [context-count _context-buffer.])
  ({[.qg] [.context]} *.intro [env.])
  {
    [.context-count]
    ({[.context-count] [.env] (([.context-count] :.param) name.qwen3.qwen35-gate-context-at)} materializec)
  } buf.to-mem [gated.]
  ({[.qg] [.gated]} qwen3.free-f32-before [gated-after-qg.])
  ({[.context] [.gated-after-qg]} qwen3.free-f32-before [result.])
  [.result]
))

# Paired shared-expert projection. Unlike the routed variant, these GGUF
# matrices have no leading expert dimension and always select slot zero.
(def program qwen3.qwen35-shared-linear-pair :
  {(cap.own mem) (cap.ref mem) (cap.ref mem) (cap.own mem)}
  ->
  {(cap.own mem) (cap.own mem) (cap.own mem) (cap.own mem)}
= ([input gate-weight up-weight selected-experts.]
  ([.input] mem.cast.f32 [input-count input-buffer.])
  ([.gate-weight] mem.cast.bf16 [gate-count gate-buffer.])
  ([.up-weight] mem.cast.bf16 [up-count up-buffer.])
  ([.selected-experts] mem.cast.u64 [selected-count selected-buffer.])
  ([.input-count] :.forget [input-count-value.])
  (const.u64.0x{{HIDDEN_SIZE}} [hidden-size-value.])
  (const.u64.0x{{SHARED_INTERMEDIATE_SIZE}} [shared-size.])
  (const.u64.0x0000000000000001 [one.])
  ([.input-count-value hidden-size-value] u64.div [row-count.])
  ([.row-count shared-size] u64.mul [output-count-value.])
  ([.output-count-value] u64.name [output-count.])
  ([.hidden-size-value] u64.name [hidden-size.])
  {
    [.input-buffer] [.input-count]
    [.gate-buffer] [.gate-count]
    [.up-buffer] [.up-count]
    [.selected-buffer] [.selected-count]
    [.output-count] [.hidden-size] [.one] [.shared-size]
  } materializec.borrow-routed-bf16-gemv-pair
    [input-after selected-after gate up.]
  {
    ({[.input-count] [.input-after]} buf.to-mem)
    ({[.selected-count] [.selected-after]} buf.to-mem)
    ({[.output-count] [.gate]} buf.to-mem)
    ({[.output-count] [.up]} buf.to-mem)
  }
))

(def program qwen3.qwen35-shared-scale-at :
  ([n.] {({(cap.own mem) (cap.own mem)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [activated router.])
  ([.output-index] ix.to-u64 [index.])
  (const.u64.0x{{SHARED_INTERMEDIATE_SIZE}} [shared-size.])
  ([.index shared-size] u64.div [row.])
  ([.activated] mem.cast.f32 [active-count active-buffer.])
  ({[.active-count] [.active-buffer] [.index]} qwen3.f32-buffer-at [value.])
  ([.router] mem.cast.f32 [router-count router-buffer.])
  ({[.router-count] [.router-buffer] [.row]} qwen3.f32-buffer-at qwen3.sigmoid [scale.])
  ([.value scale] f32.mul [result.])
  [.result]
))

(def program qwen3.qwen35-shared-scale :
  {(cap.own mem) (cap.own mem)} -> (cap.own mem)
= ([activated router.]
  ([.activated] mem.cast.f32 [count _buffer.])
  ({[.activated] [.router]} *.intro [env.])
  { [.count] ({[.count] [.env] (([.count] :.param) name.qwen3.qwen35-shared-scale-at)} materializec) }
  buf.to-mem [scaled.]
  ({[.activated] [.scaled]} qwen3.free-f32-before [scaled-after-activated.])
  ({[.router] [.scaled-after-activated]} qwen3.free-f32-before [result.])
  [.result]
))

# Qwen3.5/3.6 MoE FFN: normalized top-k routed experts plus a sigmoid-gated
# dense shared expert, both added to the attention residual.
(def program qwen3.qwen35-moe-ffn :
  {
    (cap.own mem) (cap.own mem) (u64 val)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
  }
  ->
  (cap.own mem)
= ([normalized residual sequence
    router-weight expert-gate-weight expert-up-weight expert-down-weight
    shared-router-weight shared-gate-weight shared-up-weight shared-down-weight.]
  (const.u64.0x{{EXPERT_COUNT}} [router-features.])
  ({[.normalized] [.router-weight] [.router-features]} qwen3.linear [router-logits.])
  ([.router-logits] qwen3.router-select-experts [router-after selected-experts.])
  ({[.router-after] [.selected-experts]} qwen3.routing-weights [routing-weights.])
  ({[.normalized] [.expert-gate-weight] [.expert-up-weight] [.selected-experts]}
    qwen3.expert-linear-pair
    [normalized-after-expert selected-after-expert expert-gate expert-up.])
  ({[.expert-gate] [.expert-up] [.routing-weights]}
    qwen3.moe-activate [expert-activated.])
  ({[.expert-activated] [.expert-down-weight] [.selected-after-expert] [.residual]}
    qwen3.moe-down-residual [expert-activated-after routed-output.])
  (const.u64.0x0000000000000001 [one.])
  ({[.normalized-after-expert] [.shared-router-weight] [.one]}
    qwen3.linear [shared-router.])
  ([.sequence] qwen3.dense-selected-experts [shared-selected.])
  ({[.normalized-after-expert] [.shared-gate-weight] [.shared-up-weight] [.shared-selected]}
    qwen3.qwen35-shared-linear-pair
    [normalized-after-shared shared-selected-after shared-gate shared-up.])
  ({[.shared-gate] [.shared-up]} qwen3.dense-activate [shared-activated.])
  ({[.shared-activated] [.shared-router]} qwen3.qwen35-shared-scale [shared-scaled.])
  (const.u64.0x{{SHARED_INTERMEDIATE_SIZE}} [shared-features.])
  ({[.shared-scaled] [.shared-down-weight] [.routed-output] [.shared-features]}
    qwen3.linear-residual [output.])
  ({[.normalized-after-shared] [.output]} qwen3.free-f32-before [output-01.])
  ({[.router-after] [.output-01]} qwen3.free-f32-before [output-02.])
  ({[.expert-gate] [.output-02]} qwen3.free-f32-before [output-03.])
  ({[.expert-up] [.output-03]} qwen3.free-f32-before [output-04.])
  ({[.expert-activated-after] [.output-04]} qwen3.free-f32-before [output-05.])
  ({[.routing-weights] [.output-05]} qwen3.free-f32-before [output-06.])
  ({[.selected-after-expert] [.output-06]} qwen3.free-u64-before [output-07.])
  ({[.routed-output] [.output-07]} qwen3.free-f32-before [output-08.])
  ({[.shared-gate] [.output-08]} qwen3.free-f32-before [output-09.])
  ({[.shared-up] [.output-09]} qwen3.free-f32-before [output-10.])
  ({[.shared-selected-after] [.output-10]} qwen3.free-u64-before [output-11.])
  ({[.shared-scaled] [.output-11]} qwen3.free-f32-before [output-12.])
  ({[.residual] [.output-12]} qwen3.free-f32-before [result.])
  [.result]
))

(def program qwen3.qwen35-full-decoder-layer :
  {
    (cap.own mem) (cap.own mem) (u64 val) (cap.own mem)
    (u64 val) (u64 val) (u64 val)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
    (cap.ref mem) (cap.ref mem) (cap.ref mem)
  }
  ->
  {(cap.own mem) (cap.own mem)}
= ([hidden rope sequence cache token-capacity start layer
    input-norm q-weight k-weight v-weight o-weight q-norm k-norm
    post-norm gate-weight up-weight down-weight.]
  ([.hidden] qwen3.rms-inv [attention-inverse.])
  (const.u64.0x{{QWEN35_QUERY_PROJECTION_SIZE}} [qg-features.])
  (const.u64.0x{{KEY_VALUE_SIZE}} [key-value-features.])
  ({[.hidden] [.input-norm] [.q-weight] [.attention-inverse] [.qg-features]}
    qwen3.linear-norm [query-and-gate.])
  ([.query-and-gate] qwen3.qwen35-extract-query [query-raw.])
  ({[.hidden] [.input-norm] [.k-weight] [.attention-inverse] [.key-value-features]}
    qwen3.linear-norm [key-raw.])
  ({[.hidden] [.input-norm] [.v-weight] [.attention-inverse] [.key-value-features]}
    qwen3.linear-norm [value.])
  ({[.query-raw] [.q-norm]} qwen3.head-rmsnorm [query.])
  ({[.key-raw] [.k-norm]} qwen3.head-rmsnorm [key.])
  ({[.cache] [.key] [.rope] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cache-append-key [cache-with-key.])
  ({[.key] [.cache-with-key]} qwen3.free-f32-before [cache-after-key.])
  ({[.cache-after-key] [.value] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cache-append-value [cache-with-value.])
  ({[.value] [.cache-with-value]} qwen3.free-f32-before [cache-after-value.])
  ({[.cache-after-value] [.query] [.rope] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cached-attention [cache-after-attention context.])
  ({[.query-and-gate] [.context]} qwen3.qwen35-gate-context [gated-context.])
  ({[.attention-inverse] [.gated-context]} qwen3.free-f32-before [context-after-inverse.])
  ({[.query] [.context-after-inverse]} qwen3.free-f32-before [context-after-query.])
  (const.u64.0x{{QUERY_SIZE}} [attention-input-features.])
  ({[.context-after-query] [.o-weight] [.hidden] [.attention-input-features]}
    qwen3.linear-residual [attention-hidden.])
  ({[.context-after-query] [.attention-hidden]} qwen3.free-f32-before [attention-hidden-after-context.])
  ({[.hidden] [.attention-hidden-after-context]} qwen3.free-f32-before [attention-hidden-after-residual.])
  ([.attention-hidden-after-residual] qwen3.rms-inv [mlp-inverse.])
  ({[.attention-hidden-after-residual] [.post-norm] [.mlp-inverse]}
    qwen3.apply-rmsnorm [normalized-mlp-input.])
  ([.sequence] qwen3.dense-selected-experts [selected-experts.])
  ({[.normalized-mlp-input] [.gate-weight] [.up-weight] [.selected-experts]}
    qwen3.expert-linear-pair
    [normalized-mlp-input-after-pair selected-experts-after-pair gate up.])
  ({[.gate] [.up]} qwen3.dense-activate [activated.])
  ({[.activated] [.down-weight] [.selected-experts-after-pair] [.attention-hidden-after-residual]}
    qwen3.moe-down-residual [activated-after output.])
  ({[.mlp-inverse] [.output]} qwen3.free-f32-before [output-after-mlp-inverse.])
  ({[.normalized-mlp-input-after-pair] [.output-after-mlp-inverse]}
    qwen3.free-f32-before [output-after-normalized.])
  ({[.gate] [.output-after-normalized]} qwen3.free-f32-before [output-after-gate.])
  ({[.up] [.output-after-gate]} qwen3.free-f32-before [output-after-up.])
  ({[.activated-after] [.output-after-up]} qwen3.free-f32-before [output-after-activated.])
  ({[.selected-experts-after-pair] [.output-after-activated]}
    qwen3.free-u64-before [output-after-experts.])
  ({[.attention-hidden-after-residual] [.output-after-experts]}
    qwen3.free-f32-before [output-after-residual.])
  {[.output-after-residual] [.cache-after-attention]}
))

(def program qwen3.qwen35-full-moe-decoder-layer :
  {
    (cap.own mem) (cap.own mem) (u64 val) (cap.own mem)
    (u64 val) (u64 val) (u64 val)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
  }
  ->
  {(cap.own mem) (cap.own mem)}
= ([hidden rope sequence cache token-capacity start layer
    input-norm q-weight k-weight v-weight o-weight q-norm k-norm post-norm
    router-weight expert-gate-weight expert-up-weight expert-down-weight
    shared-router-weight shared-gate-weight shared-up-weight shared-down-weight.]
  ([.hidden] qwen3.rms-inv [attention-inverse.])
  (const.u64.0x{{QWEN35_QUERY_PROJECTION_SIZE}} [qg-features.])
  (const.u64.0x{{KEY_VALUE_SIZE}} [key-value-features.])
  ({[.hidden] [.input-norm] [.q-weight] [.attention-inverse] [.qg-features]}
    qwen3.linear-norm [query-and-gate.])
  ([.query-and-gate] qwen3.qwen35-extract-query [query-raw.])
  ({[.hidden] [.input-norm] [.k-weight] [.attention-inverse] [.key-value-features]}
    qwen3.linear-norm [key-raw.])
  ({[.hidden] [.input-norm] [.v-weight] [.attention-inverse] [.key-value-features]}
    qwen3.linear-norm [value.])
  ({[.query-raw] [.q-norm]} qwen3.head-rmsnorm [query.])
  ({[.key-raw] [.k-norm]} qwen3.head-rmsnorm [key.])
  ({[.cache] [.key] [.rope] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cache-append-key [cache-with-key.])
  ({[.key] [.cache-with-key]} qwen3.free-f32-before [cache-after-key.])
  ({[.cache-after-key] [.value] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cache-append-value [cache-with-value.])
  ({[.value] [.cache-with-value]} qwen3.free-f32-before [cache-after-value.])
  ({[.cache-after-value] [.query] [.rope] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cached-attention [cache-after-attention context.])
  ({[.query-and-gate] [.context]} qwen3.qwen35-gate-context [gated-context.])
  ({[.attention-inverse] [.gated-context]} qwen3.free-f32-before [context-after-inverse.])
  ({[.query] [.context-after-inverse]} qwen3.free-f32-before [context-after-query.])
  (const.u64.0x{{QUERY_SIZE}} [attention-input-features.])
  ({[.context-after-query] [.o-weight] [.hidden] [.attention-input-features]}
    qwen3.linear-residual [attention-hidden.])
  ({[.context-after-query] [.attention-hidden]} qwen3.free-f32-before [attention-after-context.])
  ({[.hidden] [.attention-after-context]} qwen3.free-f32-before [attention-after-residual.])
  ([.attention-after-residual] qwen3.rms-inv [mlp-inverse.])
  ({[.attention-after-residual] [.post-norm] [.mlp-inverse]}
    qwen3.apply-rmsnorm [normalized.])
  ({
    [.normalized] [.attention-after-residual] [.sequence]
    [.router-weight] [.expert-gate-weight] [.expert-up-weight] [.expert-down-weight]
    [.shared-router-weight] [.shared-gate-weight] [.shared-up-weight] [.shared-down-weight]
  } qwen3.qwen35-moe-ffn [output.])
  ({[.mlp-inverse] [.output]} qwen3.free-f32-before [output-after-inverse.])
  {[.output-after-inverse] [.cache-after-attention]}
))

# Copy a contiguous recurrent-cache range while returning the cache owner.
(def program qwen3.qwen35-copy-cache-range-at :
  ([capacity n.] {
    ({cap.ref [.capacity] f32} buf val)
    ({({({[.capacity] u64} :) (u64 val)} *) ([.n] ix val)} *)
  })
  ->
  ([capacity n.] (f32 val))
= ([cache-buffer env.]
  ([.env] *.elim [inputs output-index.])
  ([.inputs] *.elim [capacity-value offset.])
  ([.output-index] ix.to-u64 [local-index.])
  ([.offset local-index] u64.add [cache-index.])
  ({[.capacity-value] [.cache-buffer] [.cache-index]} qwen3.f32-buffer-at [result.])
  [.result]
))

(def program qwen3.qwen35-copy-cache-range :
  {(cap.own mem) (u64 val) (u64 val)}
  ->
  {(cap.own mem) (cap.own mem)}
= ([cache offset len.]
  ([.cache] mem.cast.f32 [cache-count cache-buffer.])
  ([.len] u64.name [copy-count.])
  ({[.cache-count] [.offset]} *.intro [env.])
  {
    [.cache-buffer] [.cache-count] [.copy-count] [.env]
    ({([.cache-count] :.param) ([.copy-count] :.param)} name.qwen3.qwen35-copy-cache-range-at)
  } materializec.borrow [cache-after copied-buffer.]
  {
    ({[.cache-count] [.cache-after]} buf.to-mem)
    ({[.copy-count] [.copied-buffer]} buf.to-mem)
  }
))

# Depthwise causal convolution over one projected token and its ring history.
(def program qwen3.qwen35-conv-term-at :
  ([n k.] {
    ({
      ({({({(cap.own mem) (cap.own mem)} *) (cap.ref mem)} *) (u64 val)} *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env indices.])
  ([.env] *.elim [buffers start.])
  ([.buffers] *.elim [history-and-qkv conv-weight.])
  ([.history-and-qkv] *.elim [history qkv.])
  ([.indices] *.elim [output-index kernel-index.])
  ([.output-index] ix.to-u64 [channel.])
  ([.kernel-index] ix.to-u64 [kernel.])
  (const.u64.0x{{LINEAR_QKV_SIZE}} [qkv-size.])
  (const.u64.0x{{LINEAR_CONV_KERNEL}} [kernel-size.])
  (const.u64.0x0000000000000001 [one.])
  ([.kernel-size one] u64.sub [history-slots.])
  ([.kernel history-slots] u64.ne bool.not [is-current.])
  ([.history-slots kernel] u64.sub [lag.])
  ([.start lag] u64.gte [history-valid.])
  ([.start kernel] u64.add [ring-numerator.])
  ([.ring-numerator history-slots] u64.rem [slot.])
  ([.slot qkv-size] u64.mul [slot-base.])
  ([.slot-base channel] u64.add [history-index.])
  ([.history] mem.cast.f32 [history-count history-buffer.])
  ({[.history-count] [.history-buffer] [.history-index]} qwen3.f32-buffer-at [history-value-raw.])
  (const.u32.0x00000000 u32.bitcast-f32 [zero.])
  ([.history-valid history-value-raw zero] f32.select [history-value.])
  ([.qkv] mem.cast.f32 [qkv-count qkv-buffer.])
  ({[.qkv-count] [.qkv-buffer] [.channel]} qwen3.f32-buffer-at [current-value.])
  ([.is-current current-value history-value] f32.select [input-value.])
  ([.channel kernel-size] u64.mul [weight-row-base.])
  ([.weight-row-base kernel] u64.add [weight-index.])
  ([.conv-weight] mem.cast.f32 [weight-count weight-buffer.])
  ({[.weight-count] [.weight-buffer] [.weight-index]} qwen3.f32-buffer-at [weight-value.])
  ([.input-value weight-value] f32.mul [result.])
  [.result]
))

(def program qwen3.qwen35-conv-epilogue :
  ([n.] {
