(def program qwen3.qwen35-prediction-term-at :
  ([n k.] {
    ({
      ({(cap.own mem) (cap.own mem)} *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
