 ([input weight ibase wbase pair.]
 ([.pair] *.elim [step rest.])
 ([.rest] *.elim [acc proofs.])
 ([.proofs] *.elim [less truth.])
 ([.less] unsafe.discard unit.elim)
 ([.step] :.forget [i.])
 ({[.ibase] [.i]} stdlib.qwen3.memory.u64.add [ii.])
 ({[.wbase] [.i]} stdlib.qwen3.memory.u64.add [wi.])
 ({[.input] [.ii]} stdlib.qwen3.memory.ref-read-f32 [x.])
 ({[.weight] [.wi]} stdlib.qwen3.memory.ref-read-f32 [w.])
 ({[.x] [.w]} stdlib.qwen3.memory.f32.mul [product.])
 ({[.acc] [.product]} stdlib.qwen3.memory.f32.add [value.])
 ({[.value] [.truth]} *.intro)
 ))

