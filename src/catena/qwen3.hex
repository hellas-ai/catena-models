  ([.intermediate-size-value] u64.name [intermediate-size.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.intermediate-size] :.param) name.qwen3.mlp-down-term-at)})
    [.intermediate-size]
  } reducec [projected.])
  ([.residual] mem.cast.f32 [residual-count residual-buffer.])
  ({[.residual-count] [.residual-buffer] [.flat-output-index]}
    qwen3.f32-buffer-at [residual-value.])
  ([.projected residual-value] f32.add [result.])
  [.result]
))

# Compute one SwiGLU/down-projection term at reduce-f32's pair of logical
# coordinates.
(def program qwen3.mlp-down-reduce-term-at :
  ([n k.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
