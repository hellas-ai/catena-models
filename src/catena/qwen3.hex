    ([.is-pair-37 frequency-37 selected-38] f32.select [selected-37.])
    ([.is-pair-36 frequency-36 selected-37] f32.select [selected-36.])
    ([.is-pair-35 frequency-35 selected-36] f32.select [selected-35.])
    ([.is-pair-34 frequency-34 selected-35] f32.select [selected-34.])
    ([.is-pair-33 frequency-33 selected-34] f32.select [selected-33.])
    ([.is-pair-32 frequency-32 selected-33] f32.select [selected-32.])
    ([.is-pair-31 frequency-31 selected-32] f32.select [selected-31.])
