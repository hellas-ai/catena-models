# Materialize the fused SwiGLU/down projection and second residual.
(def program qwen3.mlp-down-residual :
  {(cap.own mem) (cap.own mem) (cap.ref mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([gate up down-weight residual.]
