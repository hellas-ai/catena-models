  (const.u64.0x0000000000000020 [query-head-count.])
  ([.sequence query-head-count] u64.mul [row-count.])
  ([.row-count history] u64.mul [score-count-value.])
  ([.score-count-value] u64.name [score-count.])
  ({[.query] [.rope]} *.intro [query-and-rope.])
  ({[.cache-count] [.query-and-rope]} *.intro [buffer-inputs.])
  ({[.sequence] [.token-capacity]} *.intro [sequence-and-capacity.])
  ({[.start] [.layer]} *.intro [start-and-layer.])
  ({[.sequence-and-capacity] [.start-and-layer]} *.intro [scalar-inputs.])
  ({[.buffer-inputs] [.scalar-inputs]} *.intro [inputs.])
  {
    [.cache-buffer]
    [.cache-count]
    [.score-count]
    [.inputs]
    ({
      ([.cache-count] :.param)
      ([.score-count] :.param)
    } name.qwen3.cached-staged-score-at)
  } materializec.borrow [cache-after scores.]
  {
    ({[.cache-count] [.cache-after]} buf.to-mem)
    ({[.score-count] [.scores]} buf.to-mem)
  }
))

# Read one staged score from a selected softmax row.
