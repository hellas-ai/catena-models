    [.intermediate-size]
    [.buffers]
    ({
      ([.output-count] :.param)
      ([.intermediate-size] :.param)
    } name.qwen3.mlp-down-reduce-term-at)
    (([.output-count] :.param) name.qwen3.mlp-down-reduce-epilogue)
  } materializec.reduce-f32 [output.]
  ({[.output-count] [.output]} buf.to-mem)
