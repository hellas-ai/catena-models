# Qwen3-135M GPU programs.
#
# Allocation-free `*-at` definitions are device-callable producers. Public
# tensor operations arrange their environments and materialize the result.

# Higher-accuracy exponential for model numerics. The stdlib approximation is
# intentionally small, but its degree-3 polynomial accumulates visible error
# through 30 SwiGLU blocks. This uses the same ln(2) range reduction with a
# degree-6 Taylor polynomial on [-ln(2)/2, ln(2)/2].
(def program qwen3.exp-nonneg : (f32 val) -> (f32 val) =
  ([x.]
    (const.u32.0x3FB8AA3B u32.bitcast-f32 [inv-ln2.])
    (const.u32.0x3F317200 u32.bitcast-f32 [ln2-hi.])
    (const.u32.0x35BFBE8E u32.bitcast-f32 [ln2-lo.])
    (const.u32.0x3F800000 u32.bitcast-f32 [c0.])
    (const.u32.0x3F800000 u32.bitcast-f32 [c1.])
    (const.u32.0x3F000000 u32.bitcast-f32 [c2.])
    (const.u32.0x3E2AAAAB u32.bitcast-f32 [c3.])
    (const.u32.0x3D2AAAAB u32.bitcast-f32 [c4.])
    (const.u32.0x3C088889 u32.bitcast-f32 [c5.])
    (const.u32.0x3AB60B61 u32.bitcast-f32 [c6.])
    ([.x inv-ln2] f32.mul [scaled.])
    ([.scaled] f32.round-to-u32 [k-u32.])
    ([.k-u32] u32.to-f32 [k-f32.])
    ([.k-f32 ln2-hi] f32.mul [k-ln2-hi.])
    ([.k-f32 ln2-lo] f32.mul [k-ln2-lo.])
    ([.x k-ln2-hi] f32.sub [r-hi.])
    ([.r-hi k-ln2-lo] f32.sub [r.])
    ([.r c6] f32.mul [r-c6.])
    ([.c5 r-c6] f32.add [p5.])
    ([.r p5] f32.mul [r-p5.])
    ([.c4 r-p5] f32.add [p4.])
    ([.r p4] f32.mul [r-p4.])
    ([.c3 r-p4] f32.add [p3.])
    ([.r p3] f32.mul [r-p3.])
    ([.c2 r-p3] f32.add [p2.])
    ([.r p2] f32.mul [r-p2.])
    ([.c1 r-p2] f32.add [p1.])
    ([.r p1] f32.mul [r-p1.])
    ([.c0 r-p1] f32.add [polynomial.])
    (const.u32.0x0000007F [bias-u32.])
    (const.u32.0x00800000 [exponent-step-u32.])
    ([.k-u32 bias-u32] u32.add [biased-exponent.])
    ([.biased-exponent exponent-step-u32] u32.mul [power-bits.])
    ([.power-bits] u32.bitcast-f32 [power-of-two.])
    ([.polynomial power-of-two] f32.mul [result.])
    [.result]
  )
)

(def program qwen3.exp : (f32 val) -> (f32 val) =
  ([x.]
    (const.u32.0x00000000 u32.to-f32 [zero.])
    (const.u32.0x3F800000 u32.bitcast-f32 [one.])
    ([.x] f32.neg [negated.])
    ([.x zero] f32.lt [is-negative.])
    ([.is-negative negated x] f32.select [magnitude.])
    ([.magnitude] qwen3.exp-nonneg [positive-result.])
    ([.one positive-result] f32.div [reciprocal.])
    ([.is-negative reciprocal positive-result] f32.select [result.])
    [.result]
  )
)

(def program qwen3.silu : (f32 val) -> (f32 val) =
  ([x.]
    (const.u32.0x3F800000 u32.bitcast-f32 [one.])
    ([.x] f32.neg [negative-x.])
    ([.negative-x] qwen3.exp [exp-negative-x.])
    ([.one exp-negative-x] f32.add [denominator.])
    ([.x denominator] f32.div [result.])
    [.result]
  )
)

# Square root with an exponent-derived initial estimate followed by four
# Newton-Raphson refinements. RMS inputs span several orders of magnitude in
# this checkpoint; starting the iteration at x does not converge in a fixed
# six steps once the residual stream becomes large.
(def program qwen3.sqrt : (f32 val) -> (f32 val) =
  ([x.]
    (const.u32.0x00000000 u32.to-f32 [zero.])
    (const.u32.0x00000001 [one-bit.])
    (const.u32.0x1FC00000 [sqrt-bias.])
    (const.u32.0x3F000000 u32.bitcast-f32 [half.])
    ([.x] f32.bitcast-u32 [x-bits.])
    ([.x-bits one-bit] u32.shr [half-exponent-bits.])
    ([.half-exponent-bits sqrt-bias] u32.add [guess-bits.])
    ([.guess-bits] u32.bitcast-f32 [guess0.])
    ([.x guess0] f32.div [ratio0.])
    ([.guess0 ratio0] f32.add [sum0.])
    ([.sum0 half] f32.mul [guess1.])
    ([.x guess1] f32.div [ratio1.])
    ([.guess1 ratio1] f32.add [sum1.])
    ([.sum1 half] f32.mul [guess2.])
    ([.x guess2] f32.div [ratio2.])
    ([.guess2 ratio2] f32.add [sum2.])
    ([.sum2 half] f32.mul [guess3.])
    ([.x guess3] f32.div [ratio3.])
    ([.guess3 ratio3] f32.add [sum3.])
    ([.sum3 half] f32.mul [guess4.])
    ([.x zero] f32.lte [is-nonpositive.])
    ([.is-nonpositive zero guess4] f32.select [result.])
    [.result]
  )
)

# Checked raw-index load from a borrowed u64 buffer.
(def program qwen3.u64-buffer-at :
  ([m n.] {
    ({[.n] u64} :)
    ({[.m n] u64} buf val)
    (u64 val)
  })
  ->
  ([m n.] (u64 val))
= ([len input raw-index.]
  ([.raw-index] u64.name [named-index.])
  ([.len named-index] u64.gt [in-bounds if-in-bounds _if-out-of-bounds.])
  ([.in-bounds if-in-bounds] assert-then [index-proof.])
  ([.named-index len index-proof] u64.to-ix [index.])
  ({[.index input]} ix [result.])
  [.result]
))

# Checked raw-index load from a borrowed f32 buffer.
(def program qwen3.f32-buffer-at :
  ([m n.] {
    ({[.n] u64} :)
    ({[.m n] f32} buf val)
    (u64 val)
  })
  ->
  ([m n.] (f32 val))
= ([len input raw-index.]
  ([.raw-index] u64.name [named-index.])
  ([.len named-index] u64.gt [in-bounds if-in-bounds _if-out-of-bounds.])
  ([.in-bounds if-in-bounds] assert-then [index-proof.])
  ([.named-index len index-proof] u64.to-ix [index.])
  ({[.index input]} ix [result.])
  [.result]
))

# Checked raw-index load from a borrowed BF16 buffer. Checkpoint weights stay
# in their original representation in device memory and are widened only in
# registers for F32 accumulation.
(def program qwen3.bf16-buffer-at :
  ([m n.] {
    ({[.n] u64} :)
    ({[.m n] bf16} buf val)
    (u64 val)
  })
  ->
  ([m n.] (bf16 val))
= ([len input raw-index.]
  ([.raw-index] u64.name [named-index.])
  ([.len named-index] u64.gt [in-bounds if-in-bounds _if-out-of-bounds.])
  ([.in-bounds if-in-bounds] assert-then [index-proof.])
  ([.named-index len index-proof] u64.to-ix [index.])
  ({[.index input]} ix [result.])
  [.result]
))

# Produce one element of [sequence, 2048] token embeddings.
(def program qwen3.embedding-at :
  ([token-count weight-count output-count.] {
    ({
      ({({[.token-count] u64} :) ({cap.ref [.token-count] u64} buf val)} *)
      ({({[.weight-count] u64} :) ({cap.ref [.weight-count] bf16} buf val)} *)
    } *)
    ([.output-count] ix val)
  })
  ->
  ([token-count weight-count output-count.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [token-input weight-input.])
  ([.token-input] *.elim [token-count-value tokens.])
  ([.weight-input] *.elim [weight-count-value weights.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.flat-output-index hidden-size] u64.div [token-position.])
  ([.flat-output-index hidden-size] u64.rem [hidden-channel.])
  ({[.token-count-value] [.tokens] [.token-position]}
    qwen3.u64-buffer-at [token-id.])
  ([.token-id hidden-size] u64.mul [token-row-offset.])
  ([.token-row-offset hidden-channel] u64.add [weight-index.])
  ({[.weight-count-value] [.weights] [.weight-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [result.])
  [.result]
))

# Materialize [sequence, 2048] embeddings from U64 token IDs and BF16 weights.
(def program qwen3.embedding :
  {(cap.ref mem) (cap.ref mem)}
  ->
  (cap.own mem)
= (
  {mem.cast.u64 mem.cast.bf16}
  [token-count tokens weight-count weights.]
    (const.u64.0x0000000000000800 [hidden-size.])
    ([.token-count] :.forget [token-count-value.])
    ([.token-count-value hidden-size] u64.mul [output-count-value.])
    ([.output-count-value] u64.name [output-count.])
    ({[.token-count] [.tokens]} *.intro [token-input.])
    ({[.weight-count] [.weights]} *.intro [weight-input.])
    ({[.token-input] [.weight-input]} *.intro [env.])
    {
      [.output-count]
      ({
        [.output-count]
        [.env]
        ({
          ([.token-count] :.param)
          ([.weight-count] :.param)
          ([.output-count] :.param)
        } name.qwen3.embedding-at)
      } materializec)
    }
    buf.to-mem
))

# Read one squared hidden element for an on-device RMS reduction.
(def program qwen3.rms-square-at :
  ([n.] {
    ({(cap.own mem) (u64 val)} *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env channel-index.]
  ([.env] *.elim [hidden row.])
  ([.hidden] mem.cast.f32 [hidden-count hidden-buffer.])
  ([.channel-index] ix.to-u64 [channel.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.row hidden-size] u64.mul [row-offset.])
  ([.row-offset channel] u64.add [hidden-index.])
  ({[.hidden-count] [.hidden-buffer] [.hidden-index]}
    qwen3.f32-buffer-at [hidden-value.])
  ([.hidden-value hidden-value] f32.mul [squared.])
  [.squared]
))

# Produce one inverse RMS value for each hidden-state row.
(def program qwen3.rms-inv-at :
  ([n.] {(cap.own mem) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([hidden row-index.]
  ([.row-index] ix.to-u64 [row.])
  ({[.hidden] [.row]} *.intro [square-env.])
  (const.u64.0x0000000000000800 [hidden-size-value.])
  ([.hidden-size-value] u64.name [hidden-size.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.square-env] (([.hidden-size] :.param) name.qwen3.rms-square-at)})
    [.hidden-size]
  } reducec [sum-squared.])
  ([.hidden-size] :.forget [hidden-size-f32-source.])
  ([.hidden-size-f32-source] u64.to-f32 [hidden-size-f32.])
  ([.sum-squared hidden-size-f32] f32.div [mean-squared.])
  (const.u32.0x358637BD u32.bitcast-f32 [epsilon.])
  ([.mean-squared epsilon] f32.add [mean-plus-epsilon.])
  ([.mean-plus-epsilon] qwen3.sqrt [rms.])
  (f32.one [one.])
  ([.one rms] f32.div [inverse-rms.])
  [.inverse-rms]
))

# Square one hidden channel for the canonical pairwise RMS reduction.
(def program qwen3.rms-reduce-term-at :
  ([n k.] {
    ({
      (cap.own mem)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [hidden indices.])
  ([.indices] *.elim [row-index channel-index.])
  ([.row-index] ix.to-u64 [row.])
  ({[.hidden] [.row]} *.intro [square-env.])
  ({[.square-env] [.channel-index]} qwen3.rms-square-at)
))

# Convert the exactly reduced sum of squares into inverse RMS.
(def program qwen3.rms-reduce-epilogue :
  ([n.] {
    ({
      (cap.own mem)
      ({([.n] ix val) (f32 val)} *)
    } *)
  })
  ->
  ([n.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [_hidden index-and-sum.])
  ([.index-and-sum] *.elim [_row-index sum-squared.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.hidden-size] u64.to-f32 [hidden-size-f32.])
  ([.sum-squared hidden-size-f32] f32.div [mean-squared.])
  (const.u32.0x358637BD u32.bitcast-f32 [epsilon.])
  ([.mean-squared epsilon] f32.add [mean-plus-epsilon.])
  ([.mean-plus-epsilon] qwen3.sqrt [rms.])
  (f32.one [one.])
  ([.one rms] f32.div [inverse-rms.])
  [.inverse-rms]
))

# Materialize one inverse RMS value per 576-element hidden-state row.
(def program qwen3.rms-inv :
  (cap.own mem)
  ->
  (cap.own mem)
= ([hidden.]
  ([.hidden] mem.cast.f32 [hidden-count _hidden-buffer.])
  ([.hidden-count] :.forget [hidden-count-value.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.hidden-count-value hidden-size] u64.div [row-count-value.])
  ([.row-count-value] u64.name [row-count.])
  ([.hidden-size] u64.name [hidden-size-named.])
  {
    [.row-count]
    [.hidden-size-named]
    [.hidden]
    ({
      ([.row-count] :.param)
      ([.hidden-size-named] :.param)
    } name.qwen3.rms-reduce-term-at)
    (([.row-count] :.param) name.qwen3.rms-reduce-epilogue)
  } materializec.reduce-f32 [output.]
  ({[.row-count] [.output]} buf.to-mem)
))

# Qwen normalizes each 128-channel query/key head independently after its
# projection and before RoPE. These kernels mirror rms-inv/apply-rmsnorm but
# use head rows instead of 2048-channel residual rows.
(def program qwen3.head-rms-square-at :
  ([n.] {({(cap.own mem) (u64 val)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([env channel-index.]
  ([.env] *.elim [projection head.])
  ([.channel-index] ix.to-u64 [channel.])
  (const.u64.0x0000000000000080 [head-dim.])
  ([.head head-dim] u64.mul [head-base.])
  ([.head-base channel] u64.add [projection-index.])
  ([.projection] mem.cast.f32 [projection-count projection-buffer.])
  ({[.projection-count] [.projection-buffer] [.projection-index]}
    qwen3.f32-buffer-at [value.])
  ([.value value] f32.mul [result.])
  [.result]
))

(def program qwen3.head-rms-reduce-term-at :
  ([n k.] {
    ({(cap.own mem) ({([.n] ix val) ([.k] ix val)} *)} *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [projection indices.])
  ([.indices] *.elim [head-index channel-index.])
  ([.head-index] ix.to-u64 [head.])
  ({[.projection] [.head]} *.intro [env.])
  ({[.env] [.channel-index]} qwen3.head-rms-square-at)
))

(def program qwen3.head-rms-reduce-epilogue :
  ([n.] {
    ({(cap.own mem) ({([.n] ix val) (f32 val)} *)} *)
  })
  ->
  ([n.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [_projection index-and-sum.])
  ([.index-and-sum] *.elim [_head-index sum-squared.])
  (const.u64.0x0000000000000080 u64.to-f32 [head-dim.])
  ([.sum-squared head-dim] f32.div [mean-squared.])
  (const.u32.0x358637BD u32.bitcast-f32 [epsilon.])
  ([.mean-squared epsilon] f32.add [mean-plus-epsilon.])
  ([.mean-plus-epsilon] qwen3.sqrt [rms.])
  (f32.one [one.])
  ([.one rms] f32.div [result.])
  [.result]
))

(def program qwen3.head-rms-inv :
  (cap.own mem)
  ->
  (cap.own mem)
= ([projection.]
  ([.projection] mem.cast.f32 [projection-count _projection-buffer.])
  ([.projection-count] :.forget [projection-count-value.])
  (const.u64.0x0000000000000080 [head-dim-value.])
  ([.projection-count-value head-dim-value] u64.div [head-count-value.])
  ([.head-count-value] u64.name [head-count.])
  ([.head-dim-value] u64.name [head-dim.])
  {
    [.head-count]
    [.head-dim]
    [.projection]
    ({
      ([.head-count] :.param)
      ([.head-dim] :.param)
    } name.qwen3.head-rms-reduce-term-at)
    (([.head-count] :.param) name.qwen3.head-rms-reduce-epilogue)
  } materializec.reduce-f32 [output.]
  ({[.head-count] [.output]} buf.to-mem)
))

(def program qwen3.apply-head-rmsnorm-at :
  ([n.] {
    ({({(cap.own mem) (cap.ref mem)} *) (cap.own mem)} *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [projection-and-weight inverse.])
  ([.projection-and-weight] *.elim [projection norm-weight.])
  ([.output-index] ix.to-u64 [flat-index.])
  (const.u64.0x0000000000000080 [head-dim.])
  ([.flat-index head-dim] u64.div [head.])
  ([.flat-index head-dim] u64.rem [channel.])
  ([.projection] mem.cast.f32 [projection-count projection-buffer.])
  ({[.projection-count] [.projection-buffer] [.flat-index]}
    qwen3.f32-buffer-at [projection-value.])
  ([.norm-weight] mem.cast.bf16 [norm-count norm-buffer.])
  ({[.norm-count] [.norm-buffer] [.channel]}
    qwen3.bf16-buffer-at bf16.to-f32 [norm-value.])
  ([.inverse] mem.cast.f32 [inverse-count inverse-buffer.])
  ({[.inverse-count] [.inverse-buffer] [.head]}
    qwen3.f32-buffer-at [inverse-rms.])
  ([.projection-value inverse-rms] f32.mul [normalized.])
  ([.normalized norm-value] f32.mul [result.])
  [.result]
))

(def program qwen3.apply-head-rmsnorm :
  {(cap.own mem) (cap.ref mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([projection norm-weight inverse.]
  ([.projection] mem.cast.f32 [output-count _projection-buffer.])
  ({[.projection] [.norm-weight]} *.intro [projection-and-weight.])
  ({[.projection-and-weight] [.inverse]} *.intro [env.])
  {
    [.output-count]
    ({[.output-count] [.env] (([.output-count] :.param) name.qwen3.apply-head-rmsnorm-at)}
      materializec)
  } buf.to-mem
))

(def program qwen3.head-rmsnorm :
  {(cap.own mem) (cap.ref mem)}
  ->
  (cap.own mem)
= ([projection norm-weight.]
  ([.projection] qwen3.head-rms-inv [inverse.])
  ({[.projection] [.norm-weight] [.inverse]}
    qwen3.apply-head-rmsnorm [normalized.])
  ({[.inverse] [.normalized]}
    qwen3.free-f32-before [normalized-after-inverse.])
  ({[.projection] [.normalized-after-inverse]}
    qwen3.free-f32-before [result.])
  [.result]
))

# Apply learned RMS normalization once and materialize the rounded normalized
# hidden values. Reusing this buffer avoids repeating the same normalization
# loads and multiplies in every projection that consumes a row.
(def program qwen3.apply-rmsnorm-at :
  ([n.] {
    ({
      ({(cap.own mem) (cap.ref mem)} *)
      (cap.own mem)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [hidden-and-weight inverse-buffer.])
  ([.hidden-and-weight] *.elim [hidden norm-weight.])
  ([.output-index] ix.to-u64 [flat-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.flat-index hidden-size] u64.div [row.])
  ([.flat-index hidden-size] u64.rem [channel.])
  ([.hidden] mem.cast.f32 [hidden-count hidden-buffer.])
  ({[.hidden-count] [.hidden-buffer] [.flat-index]}
    qwen3.f32-buffer-at [hidden-value.])
  ([.norm-weight] mem.cast.bf16 [norm-count norm-buffer.])
  ({[.norm-count] [.norm-buffer] [.channel]}
    qwen3.bf16-buffer-at bf16.to-f32 [norm-value.])
  ([.inverse-buffer] mem.cast.f32 [inverse-count inverse-values.])
  ({[.inverse-count] [.inverse-values] [.row]}
    qwen3.f32-buffer-at [inverse-rms.])
  ([.hidden-value norm-value] f32.mul [normalized-unscaled.])
  ([.normalized-unscaled inverse-rms] f32.mul [result.])
  [.result]
))

(def program qwen3.apply-rmsnorm :
  {(cap.own mem) (cap.ref mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([hidden norm-weight inverse-rms.]
  ([.hidden] mem.cast.f32 [output-count _hidden-buffer.])
  ({[.hidden] [.norm-weight]} *.intro [hidden-and-weight.])
  ({[.hidden-and-weight] [.inverse-rms]} *.intro [env.])
  {
    [.output-count]
    ({[.output-count] [.env] (([.output-count] :.param) name.qwen3.apply-rmsnorm-at)}
      materializec)
  } buf.to-mem
))

# One term of a learned-RMSNorm linear projection. The inverse RMS is computed
# once per output thread and captured in this reduction environment.
(def program qwen3.linear-norm-term-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        ({(cap.ref mem) (f32 val)} *)
      } *)
      ({(u64 val) (u64 val)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env input-channel-index.]
  ([.env] *.elim [projection-inputs coordinates.])
  ([.projection-inputs] *.elim [hidden-and-norm weight-and-inverse.])
  ([.hidden-and-norm] *.elim [hidden norm-weight.])
  ([.weight-and-inverse] *.elim [linear-weight inverse-rms.])
  ([.coordinates] *.elim [row output-channel.])
  ([.input-channel-index] ix.to-u64 [input-channel.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.row hidden-size] u64.mul [hidden-row-offset.])
  ([.hidden-row-offset input-channel] u64.add [hidden-index.])
  ([.output-channel hidden-size] u64.mul [weight-row-offset.])
  ([.weight-row-offset input-channel] u64.add [weight-index.])
  ([.hidden] mem.cast.f32 [hidden-count hidden-buffer.])
  ([.norm-weight] mem.cast.bf16 [norm-count norm-buffer.])
  ([.linear-weight] mem.cast.bf16 [weight-count weight-buffer.])
  ({[.hidden-count] [.hidden-buffer] [.hidden-index]}
    qwen3.f32-buffer-at [hidden-value.])
  ({[.norm-count] [.norm-buffer] [.input-channel]}
    qwen3.bf16-buffer-at bf16.to-f32 [norm-value.])
  ({[.weight-count] [.weight-buffer] [.weight-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [weight-value.])
  ([.hidden-value norm-value] f32.mul [normalized-unscaled.])
  ([.normalized-unscaled inverse-rms] f32.mul [normalized.])
  ([.normalized weight-value] f32.mul [term.])
  [.term]
))

# Produce one output of a normalized linear projection.
(def program qwen3.linear-norm-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        ({(cap.ref mem) (cap.own mem)} *)
      } *)
      (u64 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [projection-inputs output-features.])
  ([.projection-inputs] *.elim [hidden-and-norm weight-and-inverse.])
  ([.hidden-and-norm] *.elim [hidden norm-weight.])
  ([.weight-and-inverse] *.elim [linear-weight inverse-rms-buffer.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.flat-output-index output-features] u64.div [row.])
  ([.flat-output-index output-features] u64.rem [output-channel.])
  ([.inverse-rms-buffer] mem.cast.f32 [inverse-count inverse-buffer.])
  ({[.inverse-count] [.inverse-buffer] [.row]}
    qwen3.f32-buffer-at [inverse-rms.])
  ({[.hidden] [.norm-weight]} *.intro [hidden-and-norm-term.])
  ({[.linear-weight] [.inverse-rms]} *.intro [weight-and-inverse-term.])
  ({[.hidden-and-norm-term] [.weight-and-inverse-term]} *.intro [projection-term-inputs.])
  ({[.row] [.output-channel]} *.intro [coordinates.])
  ({[.projection-term-inputs] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000800 [hidden-size-value.])
  ([.hidden-size-value] u64.name [hidden-size.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.hidden-size] :.param) name.qwen3.linear-norm-term-at)})
    [.hidden-size]
  } reducec [result.])
  [.result]
))

# Compute one term for the canonical pairwise reduction used by a normalized
# linear projection. The output coordinate is supplied by reduce-f32 rather
# than captured in a per-output materializec producer.
(def program qwen3.linear-norm-reduce-term-at :
  ([n k.] {
    ({
      ({
        ({
          ({(cap.own mem) (cap.ref mem)} *)
          ({(cap.ref mem) (cap.own mem)} *)
        } *)
        (u64 val)
      } *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env indices.])
  ([.env] *.elim [projection-inputs output-features.])
  ([.projection-inputs] *.elim [hidden-and-norm weight-and-inverse.])
  ([.hidden-and-norm] *.elim [hidden norm-weight.])
  ([.weight-and-inverse] *.elim [linear-weight inverse-rms-buffer.])
  ([.indices] *.elim [output-index input-channel-index.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.flat-output-index output-features] u64.div [row.])
  ([.flat-output-index output-features] u64.rem [output-channel.])
  ([.inverse-rms-buffer] mem.cast.f32 [inverse-count inverse-buffer.])
  ({[.inverse-count] [.inverse-buffer] [.row]}
    qwen3.f32-buffer-at [inverse-rms.])
  ({[.hidden] [.norm-weight]} *.intro [hidden-and-norm-term.])
  ({[.linear-weight] [.inverse-rms]} *.intro [weight-and-inverse-term.])
  ({[.hidden-and-norm-term] [.weight-and-inverse-term]} *.intro [projection-term-inputs.])
  ({[.row] [.output-channel]} *.intro [coordinates.])
  ({[.projection-term-inputs] [.coordinates]} *.intro [term-env.])
  ({[.term-env] [.input-channel-index]} qwen3.linear-norm-term-at)
))

# The reduction itself is the complete normalized projection result.
(def program qwen3.linear-norm-reduce-epilogue :
  ([n.] {
    ({
      ({
        ({
          ({(cap.own mem) (cap.ref mem)} *)
          ({(cap.ref mem) (cap.own mem)} *)
        } *)
        (u64 val)
      } *)
      ({([.n] ix val) (f32 val)} *)
    } *)
  })
  ->
  ([n.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [_env index-and-sum.])
  ([.index-and-sum] *.elim [_index sum.])
  [.sum]
))

# Fused learned RMSNorm and bias-free linear projection. `inverse-rms` must
# contain one value per input row; weights use [output_features, 576] layout.
(def program qwen3.linear-norm :
  {
    (cap.own mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.own mem)
    (u64 val)
  }
  ->
  (cap.own mem)
= ([hidden norm-weight linear-weight inverse-rms output-features.]
  ([.inverse-rms] mem.cast.f32 [row-count _inverse-buffer.])
  ([.row-count] :.forget [row-count-value.])
  ([.row-count-value output-features] u64.mul [output-count-value.])
  ([.output-count-value] u64.name [output-count.])
  ({[.hidden] [.norm-weight]} *.intro [hidden-and-norm.])
  ({[.linear-weight] [.inverse-rms]} *.intro [weight-and-inverse.])
  ({[.hidden-and-norm] [.weight-and-inverse]} *.intro [projection-inputs.])
  ({[.projection-inputs] [.output-features]} *.intro [env.])
  (const.u64.0x0000000000000800 [hidden-size-value.])
  ([.hidden-size-value] u64.name [hidden-size.])
  {
    [.output-count]
    [.hidden-size]
    [.env]
    ({
      ([.output-count] :.param)
      ([.hidden-size] :.param)
    } name.qwen3.linear-norm-reduce-term-at)
    (([.output-count] :.param) name.qwen3.linear-norm-reduce-epilogue)
  } materializec.reduce-f32 [output.]
  ({[.output-count] [.output]} buf.to-mem)
))

# One term of a bias-free projection from an already normalized 576-wide row.
(def program qwen3.linear-reduce-term-at :
  ([n k.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        (u64 val)
      } *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env indices.])
  ([.env] *.elim [input-and-weight output-features.])
  ([.input-and-weight] *.elim [input linear-weight.])
  ([.indices] *.elim [output-index input-index.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.input-index] ix.to-u64 [input-channel.])
  (const.u64.0x0000000000000800 [input-features.])
  ([.flat-output-index output-features] u64.div [row.])
  ([.flat-output-index output-features] u64.rem [output-channel.])
  ([.row input-features] u64.mul [input-row-base.])
  ([.input-row-base input-channel] u64.add [flat-input-index.])
  ([.output-channel input-features] u64.mul [weight-row-base.])
  ([.weight-row-base input-channel] u64.add [weight-index.])
  ([.input] mem.cast.f32 [input-count input-buffer.])
  ({[.input-count] [.input-buffer] [.flat-input-index]}
    qwen3.f32-buffer-at [input-value.])
  ([.linear-weight] mem.cast.bf16 [weight-count weight-buffer.])
  ({[.weight-count] [.weight-buffer] [.weight-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [weight-value.])
  ([.input-value weight-value] f32.mul [result.])
  [.result]
))

(def program qwen3.linear-reduce-epilogue :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        (u64 val)
      } *)
      ({([.n] ix val) (f32 val)} *)
    } *)
  })
  ->
  ([n.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [_env index-and-sum.])
  ([.index-and-sum] *.elim [_index sum.])
  [.sum]
))

(def program qwen3.linear :
  {(cap.own mem) (cap.ref mem) (u64 val)}
  ->
  (cap.own mem)
= ([input linear-weight output-features.]
  ([.input] mem.cast.f32 [input-count _input-buffer.])
  ([.input-count] :.forget [input-count-value.])
  (const.u64.0x0000000000000800 [input-features.])
  ([.input-count-value input-features] u64.div [row-count.])
  ([.row-count output-features] u64.mul [output-count-value.])
  ([.output-count-value] u64.name [output-count.])
  ([.input-features] u64.name [input-feature-count.])
  ({[.input] [.linear-weight]} *.intro [input-and-weight.])
  ({[.input-and-weight] [.output-features]} *.intro [env.])
  {
    [.output-count]
    [.input-feature-count]
    [.env]
    ({
      ([.output-count] :.param)
      ([.input-feature-count] :.param)
    } name.qwen3.linear-reduce-term-at)
    (([.output-count] :.param) name.qwen3.linear-reduce-epilogue)
  } materializec.reduce-f32 [output.]
  ({[.output-count] [.output]} buf.to-mem)
))

# Read one non-interleaved RoPE-rotated channel from a projected tensor.
# Projection layout is [sequence, head-count, 64]; the RoPE buffer contains
# [cos(sequence, 32), sin(sequence, 32)].
(def program qwen3.rope-value :
  {
    (cap.own mem)
    (cap.ref mem)
    (u64 val)
    (u64 val)
    (u64 val)
    (u64 val)
    (u64 val)
  }
  ->
  (f32 val)
= ([projection rope sequence head-count position head channel.]
  (const.u64.0x0000000000000080 [head-dim.])
  (const.u64.0x0000000000000040 [half-head-dim.])
  ([.channel half-head-dim] u64.rem [pair.])
  ([.channel half-head-dim] u64.gte [is-second-half.])
  ([.pair half-head-dim] u64.add [second-channel.])
  ([.is-second-half pair second-channel] u64.select [partner-channel.])
  ([.head-count head-dim] u64.mul [projection-features.])
  ([.position projection-features] u64.mul [projection-row-offset.])
  ([.head head-dim] u64.mul [projection-head-offset.])
  ([.projection-row-offset projection-head-offset] u64.add [projection-head-base.])
  ([.projection-head-base channel] u64.add [projection-index.])
  ([.projection-head-base partner-channel] u64.add [partner-index.])
  ([.projection] mem.cast.f32 [projection-count projection-buffer.])
  ({[.projection-count] [.projection-buffer] [.projection-index]}
    qwen3.f32-buffer-at [projection-value.])
  ({[.projection-count] [.projection-buffer] [.partner-index]}
    qwen3.f32-buffer-at [partner-value.])
  ([.position half-head-dim] u64.mul [rope-row-offset.])
  ([.rope-row-offset pair] u64.add [rope-pair-index.])
  ([.sequence half-head-dim] u64.mul [rope-plane-size.])
  ([.rope-plane-size rope-pair-index] u64.add [rope-sin-index.])
  ([.rope] mem.cast.f32 [rope-count rope-buffer.])
  ({[.rope-count] [.rope-buffer] [.rope-pair-index]}
    qwen3.f32-buffer-at [cosine.])
  ({[.rope-count] [.rope-buffer] [.rope-sin-index]}
    qwen3.f32-buffer-at [sine.])
  ([.projection-value cosine] f32.mul [cosine-term.])
  ([.partner-value sine] f32.mul [sine-term.])
  ([.cosine-term sine-term] f32.sub [rotated-first.])
  ([.cosine-term sine-term] f32.add [rotated-second.])
  ([.is-second-half rotated-second rotated-first] f32.select [result.])
  [.result]
))

# One channel term in a rotary Q/K dot product. Query heads map to shared
# key heads by integer division by three.
(def program qwen3.attention-score-term-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        (cap.ref mem)
      } *)
      ({
        ({(u64 val) (u64 val)} *)
        ({(u64 val) (u64 val)} *)
      } *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env channel-index.]
  ([.env] *.elim [buffer-inputs coordinates.])
  ([.buffer-inputs] *.elim [query-and-key rope.])
  ([.query-and-key] *.elim [query key.])
  ([.coordinates] *.elim [sequence-and-query key-and-head.])
  ([.sequence-and-query] *.elim [sequence query-position.])
  ([.key-and-head] *.elim [key-position query-head.])
  ([.channel-index] ix.to-u64 [channel.])
  (const.u64.0x0000000000000008 [query-heads-per-key-head.])
  ([.query-head query-heads-per-key-head] u64.div [key-head.])
  (const.u64.0x0000000000000020 [query-head-count.])
  (const.u64.0x0000000000000004 [key-head-count.])
  ({[.query] [.rope] [.sequence] [.query-head-count] [.query-position] [.query-head] [.channel]}
    qwen3.rope-value [query-value.])
  ({[.key] [.rope] [.sequence] [.key-head-count] [.key-position] [.key-head] [.channel]}
    qwen3.rope-value [key-value.])
  ([.query-value key-value] f32.mul [term.])
  [.term]
))

# Produce one [query-head, query-position, key-position] attention score.
(def program qwen3.attention-score-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        (cap.ref mem)
      } *)
      (u64 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [buffer-inputs sequence.])
  ([.buffer-inputs] *.elim [query-and-key rope.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.sequence sequence] u64.mul [score-plane-size.])
  ([.flat-output-index score-plane-size] u64.div [query-head.])
  ([.flat-output-index score-plane-size] u64.rem [score-plane-index.])
  ([.score-plane-index sequence] u64.div [query-position.])
  ([.score-plane-index sequence] u64.rem [key-position.])
  ({[.query-and-key] [.rope]} *.intro [term-buffer-inputs.])
  ({[.sequence] [.query-position]} *.intro [sequence-and-query.])
  ({[.key-position] [.query-head]} *.intro [key-and-head.])
  ({[.sequence-and-query] [.key-and-head]} *.intro [coordinates.])
  ({[.term-buffer-inputs] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000080 [head-dim-value.])
  ([.head-dim-value] u64.name [head-dim.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.head-dim] :.param) name.qwen3.attention-score-term-at)})
    [.head-dim]
  } reducec [unscaled-score.])
  (const.u32.0x3DB504F3 u32.bitcast-f32 [attention-scale.])
  ([.unscaled-score attention-scale] f32.mul [scaled-score.])
  ([.key-position query-position] u64.lte [is-causal.])
  (const.u32.0xFF800000 u32.bitcast-f32 [negative-infinity.])
  ([.is-causal scaled-score negative-infinity] f32.select [result.])
  [.result]
))

# Materialize causal rotary-GQA scores in [9, sequence, sequence] layout.
(def program qwen3.attention-scores :
  {(cap.own mem) (cap.own mem) (cap.ref mem) (u64 val)}
  ->
  (cap.own mem)
= ([query key rope sequence.]
  (const.u64.0x0000000000000020 [query-head-count.])
  ([.sequence sequence] u64.mul [score-plane-size.])
  ([.query-head-count score-plane-size] u64.mul [score-count-value.])
  ([.score-count-value] u64.name [score-count.])
  ({[.query] [.key]} *.intro [query-and-key.])
  ({[.query-and-key] [.rope]} *.intro [buffer-inputs.])
  ({[.buffer-inputs] [.sequence]} *.intro [env.])
  {
    [.score-count]
    ({[.score-count] [.env] (([.score-count] :.param) name.qwen3.attention-score-at)}
      materializec)
  }
  buf.to-mem
))

# Read one causal score for a row-wise reduction.
(def program qwen3.attention-row-score-at :
  ([n.] {
    ({
      ({(cap.own mem) (u64 val)} *)
      ({(u64 val) (u64 val)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env key-index.]
  ([.env] *.elim [score-input coordinates.])
  ([.score-input] *.elim [scores sequence.])
  ([.coordinates] *.elim [query-head query-position.])
  ([.key-index] ix.to-u64 [key-position.])
  ([.sequence sequence] u64.mul [score-plane-size.])
  ([.query-head score-plane-size] u64.mul [score-head-offset.])
  ([.query-position sequence] u64.mul [score-row-offset.])
  ([.score-head-offset score-row-offset] u64.add [score-row-base.])
  ([.score-row-base key-position] u64.add [score-index.])
  ([.scores] mem.cast.f32 [score-count score-buffer.])
  ({[.score-count] [.score-buffer] [.score-index]}
    qwen3.f32-buffer-at [result.])
  [.result]
))

# Produce the maximum of one causal attention row.
(def program qwen3.attention-row-max-at :
  ([n.] {
    ({({(cap.own mem) (u64 val)} *) ([.n] ix val)})
  })
  ->
  ([n.] (f32 val))
= ([score-input output-index.]
  ([.score-input] *.elim [scores sequence.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.flat-output-index sequence] u64.div [query-head.])
  ([.flat-output-index sequence] u64.rem [query-position.])
  ({[.scores] [.sequence]} *.intro [term-score-input.])
  ({[.query-head] [.query-position]} *.intro [coordinates.])
  ({[.term-score-input] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000001 [one.])
  ([.query-position one] u64.add [causal-count-value.])
  ([.causal-count-value] u64.name [causal-count.])
  ({
    (const.u32.0xFF800000 u32.bitcast-f32)
    unit.intro
    name.f32.max-env
    ({[.term-env] (([.causal-count] :.param) name.qwen3.attention-row-score-at)})
    [.causal-count]
  } reducec [result.])
  [.result]
))

# Materialize one maximum per [query-head, query-position] score row.
(def program qwen3.attention-row-max :
  {(cap.own mem) (u64 val)}
  ->
  (cap.own mem)
= ([scores sequence.]
  (const.u64.0x0000000000000020 [query-head-count.])
  ([.query-head-count sequence] u64.mul [row-count-value.])
  ([.row-count-value] u64.name [row-count.])
  ({[.scores] [.sequence]} *.intro [score-input.])
  {
    [.row-count]
    ({[.row-count] [.score-input] (([.row-count] :.param) name.qwen3.attention-row-max-at)}
      materializec)
  }
  buf.to-mem
))

# Read exp(score - row_max) for a causal softmax denominator reduction.
(def program qwen3.attention-exp-term-at :
  ([n.] {
    ({
      ({(cap.own mem) (f32 val)} *)
      ({(u64 val) ({(u64 val) (u64 val)} *)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env key-index.]
  ([.env] *.elim [scores-and-max coordinates.])
  ([.scores-and-max] *.elim [scores row-max.])
  ([.coordinates] *.elim [sequence head-and-query.])
  ([.head-and-query] *.elim [query-head query-position.])
  ([.key-index] ix.to-u64 [key-position.])
  ([.sequence sequence] u64.mul [score-plane-size.])
  ([.query-head score-plane-size] u64.mul [score-head-offset.])
  ([.query-position sequence] u64.mul [score-row-offset.])
  ([.score-head-offset score-row-offset] u64.add [score-row-base.])
  ([.score-row-base key-position] u64.add [score-index.])
  ([.scores] mem.cast.f32 [score-count score-buffer.])
  ({[.score-count] [.score-buffer] [.score-index]}
    qwen3.f32-buffer-at [score.])
  ([.score row-max] f32.sub [shifted-score.])
  ([.shifted-score] qwen3.exp [result.])
  [.result]
))

# Produce the stable softmax denominator for one causal attention row.
(def program qwen3.attention-row-denominator-at :
  ([n.] {
    ({
      ({(cap.own mem) (cap.own mem)} *)
      (u64 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [scores-and-max-buffer sequence.])
  ([.scores-and-max-buffer] *.elim [scores row-max-buffer.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.flat-output-index sequence] u64.div [query-head.])
  ([.flat-output-index sequence] u64.rem [query-position.])
  ([.row-max-buffer] mem.cast.f32 [row-max-count row-max-values.])
  ({[.row-max-count] [.row-max-values] [.flat-output-index]}
    qwen3.f32-buffer-at [row-max.])
  ({[.scores] [.row-max]} *.intro [scores-and-max.])
  ({[.query-head] [.query-position]} *.intro [head-and-query.])
  ({[.sequence] [.head-and-query]} *.intro [coordinates.])
  ({[.scores-and-max] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000001 [one.])
  ([.query-position one] u64.add [causal-count-value.])
  ([.causal-count-value] u64.name [causal-count.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.causal-count] :.param) name.qwen3.attention-exp-term-at)})
    [.causal-count]
  } reducec [result.])
  [.result]
))

# Materialize stable softmax denominators in [9, sequence] layout.
(def program qwen3.attention-row-denominator :
  {(cap.own mem) (cap.own mem) (u64 val)}
  ->
  (cap.own mem)
= ([scores row-max sequence.]
  (const.u64.0x0000000000000020 [query-head-count.])
  ([.query-head-count sequence] u64.mul [row-count-value.])
  ([.row-count-value] u64.name [row-count.])
  ({[.scores] [.row-max]} *.intro [scores-and-max-buffer.])
  ({[.scores-and-max-buffer] [.sequence]} *.intro [env.])
  {
    [.row-count]
    ({[.row-count] [.env] (([.row-count] :.param) name.qwen3.attention-row-denominator-at)}
      materializec)
  }
  buf.to-mem
))

# One weighted V term for an attention-context channel.
(def program qwen3.attention-context-term-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        ({(f32 val) (f32 val)} *)
      } *)
      ({
        ({(u64 val) (u64 val)} *)
        ({(u64 val) (u64 val)} *)
      } *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env key-index.]
  ([.env] *.elim [value-inputs coordinates.])
  ([.value-inputs] *.elim [scores-and-value max-and-denominator.])
  ([.scores-and-value] *.elim [scores value.])
  ([.max-and-denominator] *.elim [row-max denominator.])
  ([.coordinates] *.elim [sequence-and-query head-and-channel.])
  ([.sequence-and-query] *.elim [sequence query-position.])
  ([.head-and-channel] *.elim [query-head head-channel.])
  ([.key-index] ix.to-u64 [key-position.])
  ([.sequence sequence] u64.mul [score-plane-size.])
  ([.query-head score-plane-size] u64.mul [score-head-offset.])
  ([.query-position sequence] u64.mul [score-row-offset.])
  ([.score-head-offset score-row-offset] u64.add [score-row-base.])
  ([.score-row-base key-position] u64.add [score-index.])
  ([.scores] mem.cast.f32 [score-count score-buffer.])
  ({[.score-count] [.score-buffer] [.score-index]}
    qwen3.f32-buffer-at [score.])
  ([.score row-max] f32.sub [shifted-score.])
  ([.shifted-score] qwen3.exp [exponential.])
  ([.exponential denominator] f32.div [probability.])
  (const.u64.0x0000000000000008 [query-heads-per-key-head.])
  ([.query-head query-heads-per-key-head] u64.div [key-head.])
  (const.u64.0x0000000000000080 [head-dim.])
  (const.u64.0x0000000000000200 [value-features.])
  ([.key-position value-features] u64.mul [value-row-offset.])
  ([.key-head head-dim] u64.mul [value-head-offset.])
  ([.value-row-offset value-head-offset] u64.add [value-head-base.])
  ([.value-head-base head-channel] u64.add [value-index.])
  ([.value] mem.cast.f32 [value-count value-buffer.])
  ({[.value-count] [.value-buffer] [.value-index]}
    qwen3.f32-buffer-at [value-element.])
  ([.probability value-element] f32.mul [result.])
  [.result]
))

# Produce one [query-position, query-head, head-channel] context value.
(def program qwen3.attention-context-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        ({(cap.own mem) (cap.own mem)} *)
      } *)
      (u64 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [buffers sequence.])
  ([.buffers] *.elim [scores-and-value max-and-denominator-buffer.])
  ([.scores-and-value] *.elim [scores value.])
  ([.max-and-denominator-buffer] *.elim [row-max-buffer denominator-buffer.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  (const.u64.0x0000000000000080 [head-dim.])
  ([.flat-output-index hidden-size] u64.div [query-position.])
  ([.flat-output-index hidden-size] u64.rem [hidden-channel.])
  ([.hidden-channel head-dim] u64.div [query-head.])
  ([.hidden-channel head-dim] u64.rem [head-channel.])
  ([.query-head sequence] u64.mul [row-head-offset.])
  ([.row-head-offset query-position] u64.add [row-index.])
  ([.row-max-buffer] mem.cast.f32 [row-max-count row-max-values.])
  ([.denominator-buffer] mem.cast.f32 [denominator-count denominator-values.])
  ({[.row-max-count] [.row-max-values] [.row-index]}
    qwen3.f32-buffer-at [row-max.])
  ({[.denominator-count] [.denominator-values] [.row-index]}
    qwen3.f32-buffer-at [denominator.])
  ({[.scores] [.value]} *.intro [term-scores-and-value.])
  ({[.row-max] [.denominator]} *.intro [max-and-denominator.])
  ({[.term-scores-and-value] [.max-and-denominator]} *.intro [value-inputs.])
  ({[.sequence] [.query-position]} *.intro [sequence-and-query.])
  ({[.query-head] [.head-channel]} *.intro [head-and-channel.])
  ({[.sequence-and-query] [.head-and-channel]} *.intro [coordinates.])
  ({[.value-inputs] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000001 [one.])
  ([.query-position one] u64.add [causal-count-value.])
  ([.causal-count-value] u64.name [causal-count.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.causal-count] :.param) name.qwen3.attention-context-term-at)})
    [.causal-count]
  } reducec [result.])
  [.result]
))

# Materialize attention context as [sequence, 576].
(def program qwen3.attention-context :
  {
    (cap.own mem)
    (cap.own mem)
    (cap.own mem)
    (cap.own mem)
    (u64 val)
  }
  ->
  (cap.own mem)
= ([scores value row-max denominator sequence.]
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.sequence hidden-size] u64.mul [output-count-value.])
  ([.output-count-value] u64.name [output-count.])
  ({[.scores] [.value]} *.intro [scores-and-value.])
  ({[.row-max] [.denominator]} *.intro [max-and-denominator-buffer.])
  ({[.scores-and-value] [.max-and-denominator-buffer]} *.intro [buffers.])
  ({[.buffers] [.sequence]} *.intro [env.])
  {
    [.output-count]
    ({[.output-count] [.env] (([.output-count] :.param) name.qwen3.attention-context-at)}
      materializec)
  }
  buf.to-mem
))

# Free the first owned buffer only after the second owned buffer exists, then
# pass the second buffer through. Chaining this helper makes deallocation order
# explicit in the dataflow graph instead of relying on source statement order.
# The memory is cast to an owned typed buffer because only `buf.free` exists;
# borrowed buffers and untyped memory have no deallocation operation.
(def program qwen3.free-f32-before :
  {(cap.own mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([memory continuation.]
  ([.memory] mem.cast.f32 [_element-count owned-buffer.])
  ([.owned-buffer] buf.free)
  [.continuation]
))

(def program qwen3.free-u64-before :
  {(cap.own mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([memory continuation.]
  ([.memory] mem.cast.u64 [_element-count owned-buffer.])
  ([.owned-buffer] buf.free)
  [.continuation]
))

# Complete rotary grouped-query attention. Intermediate buffers are released
# only after the context materialization has synchronized.
(def program qwen3.attention :
  {
    (cap.own mem)
    (cap.own mem)
    (cap.own mem)
    (cap.ref mem)
    (u64 val)
  }
  ->
  (cap.own mem)
= ([query key value rope sequence.]
  ({[.query] [.key] [.rope] [.sequence]}
    qwen3.attention-scores [scores.])
  ({[.scores] [.sequence]}
    qwen3.attention-row-max [row-max.])
  ({[.scores] [.row-max] [.sequence]}
    qwen3.attention-row-denominator [denominator.])
  ({[.scores] [.value] [.row-max] [.denominator] [.sequence]}
    qwen3.attention-context [context.])
  ({[.scores] [.context]}
    qwen3.free-f32-before [context-after-scores.])
  ({[.row-max] [.context-after-scores]}
    qwen3.free-f32-before [context-after-row-max.])
  ({[.denominator] [.context-after-row-max]}
    qwen3.free-f32-before [context-after-denominator.])
  [.context-after-denominator]
))

# One term of a bias-free linear projection with a residual epilogue.
(def program qwen3.linear-residual-term-at :
  ([n.] {
    ({
      ({(cap.own mem) (cap.ref mem)} *)
      ({(u64 val) ({(u64 val) (u64 val)} *)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env input-index.]
  ([.env] *.elim [input-and-weight coordinates.])
  ([.input-and-weight] *.elim [input linear-weight.])
  ([.coordinates] *.elim [input-features row-and-output.])
  ([.row-and-output] *.elim [row output-channel.])
  ([.input-index] ix.to-u64 [input-channel.])
  ([.row input-features] u64.mul [input-row-offset.])
  ([.input-row-offset input-channel] u64.add [flat-input-index.])
  ([.output-channel input-features] u64.mul [weight-row-offset.])
  ([.weight-row-offset input-channel] u64.add [weight-index.])
  ([.input] mem.cast.f32 [input-count input-buffer.])
  ([.linear-weight] mem.cast.bf16 [weight-count weight-buffer.])
  ({[.input-count] [.input-buffer] [.flat-input-index]}
    qwen3.f32-buffer-at [input-value.])
  ({[.weight-count] [.weight-buffer] [.weight-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [weight-value.])
  ([.input-value weight-value] f32.mul [result.])
  [.result]
))

# Produce one 576-wide projected value and add its residual element.
(def program qwen3.linear-residual-at :
  ([n.] {
    ({
      ({(cap.own mem) (cap.ref mem)} *)
      ({(cap.own mem) (u64 val)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [input-and-weight residual-and-features.])
  ([.input-and-weight] *.elim [input linear-weight.])
  ([.residual-and-features] *.elim [residual input-features.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.flat-output-index hidden-size] u64.div [row.])
  ([.flat-output-index hidden-size] u64.rem [output-channel.])
  ({[.input] [.linear-weight]} *.intro [term-input-and-weight.])
  ({[.row] [.output-channel]} *.intro [row-and-output.])
  ({[.input-features] [.row-and-output]} *.intro [coordinates.])
  ({[.term-input-and-weight] [.coordinates]} *.intro [term-env.])
  ([.input-features] u64.name [input-feature-count.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.input-feature-count] :.param) name.qwen3.linear-residual-term-at)})
    [.input-feature-count]
  } reducec [projected.])
  ([.residual] mem.cast.f32 [residual-count residual-buffer.])
  ({[.residual-count] [.residual-buffer] [.flat-output-index]}
    qwen3.f32-buffer-at [residual-value.])
  ([.projected residual-value] f32.add [result.])
  [.result]
))

# Compute one matrix term for a residual projection using reduce-f32's output
# and reduction coordinates.
(def program qwen3.linear-residual-reduce-term-at :
  ([n k.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        ({(cap.own mem) (u64 val)} *)
      } *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env indices.])
  ([.env] *.elim [input-and-weight residual-and-features.])
  ([.input-and-weight] *.elim [input linear-weight.])
  ([.residual-and-features] *.elim [_residual input-features.])
  ([.indices] *.elim [output-index input-index.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.flat-output-index hidden-size] u64.div [row.])
  ([.flat-output-index hidden-size] u64.rem [output-channel.])
  ({[.input] [.linear-weight]} *.intro [term-input-and-weight.])
  ({[.row] [.output-channel]} *.intro [row-and-output.])
  ({[.input-features] [.row-and-output]} *.intro [coordinates.])
  ({[.term-input-and-weight] [.coordinates]} *.intro [term-env.])
  ({[.term-env] [.input-index]} qwen3.linear-residual-term-at)
))

# Add the residual only after the canonical pairwise projection reduction.
(def program qwen3.linear-residual-reduce-epilogue :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        ({(cap.own mem) (u64 val)} *)
      } *)
      ({([.n] ix val) (f32 val)} *)
    } *)
  })
  ->
  ([n.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env index-and-sum.])
  ([.env] *.elim [_input-and-weight residual-and-features.])
  ([.residual-and-features] *.elim [residual _input-features.])
  ([.index-and-sum] *.elim [output-index projected.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.residual] mem.cast.f32 [residual-count residual-buffer.])
  ({[.residual-count] [.residual-buffer] [.flat-output-index]}
    qwen3.f32-buffer-at [residual-value.])
  ([.projected residual-value] f32.add [result.])
  [.result]
))

# Materialize a 576-wide linear projection with fused residual addition.
(def program qwen3.linear-residual :
  {(cap.own mem) (cap.ref mem) (cap.own mem) (u64 val)}
  ->
  (cap.own mem)
= ([input linear-weight residual input-features.]
  ([.residual] mem.cast.f32 [output-count _residual-buffer.])
  ({[.input] [.linear-weight]} *.intro [input-and-weight.])
  ({[.residual] [.input-features]} *.intro [residual-and-features.])
  ({[.input-and-weight] [.residual-and-features]} *.intro [env.])
  ([.input-features] u64.name [input-feature-count.])
  {
    [.output-count]
    [.input-feature-count]
    [.env]
    ({
      ([.output-count] :.param)
      ([.input-feature-count] :.param)
    } name.qwen3.linear-residual-reduce-term-at)
    (([.output-count] :.param) name.qwen3.linear-residual-reduce-epilogue)
  } materializec.reduce-f32 [output.]
  ({[.output-count] [.output]} buf.to-mem)
))

# One input-channel term of the fused SwiGLU down projection.
(def program qwen3.mlp-down-term-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        (cap.ref mem)
      } *)
      ({(u64 val) (u64 val)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env input-index.]
  ([.env] *.elim [projection-inputs coordinates.])
  ([.projection-inputs] *.elim [gate-and-up down-weight.])
  ([.gate-and-up] *.elim [gate up.])
  ([.coordinates] *.elim [row output-channel.])
  ([.input-index] ix.to-u64 [input-channel.])
  (const.u64.0x0000000000000300 [intermediate-size.])
  ([.row intermediate-size] u64.mul [mlp-row-offset.])
  ([.mlp-row-offset input-channel] u64.add [mlp-index.])
  ([.output-channel intermediate-size] u64.mul [weight-row-offset.])
  ([.weight-row-offset input-channel] u64.add [weight-index.])
  ([.gate] mem.cast.f32 [gate-count gate-buffer.])
  ([.up] mem.cast.f32 [up-count up-buffer.])
  ([.down-weight] mem.cast.f32 [weight-count weight-buffer.])
  ({[.gate-count] [.gate-buffer] [.mlp-index]}
    qwen3.f32-buffer-at [gate-value.])
  ({[.up-count] [.up-buffer] [.mlp-index]}
    qwen3.f32-buffer-at [up-value.])
  ({[.weight-count] [.weight-buffer] [.weight-index]}
    qwen3.f32-buffer-at [weight-value.])
  ([.gate-value] qwen3.silu [activated-gate.])
  ([.activated-gate up-value] f32.mul [gated-value.])
  ([.gated-value weight-value] f32.mul [result.])
  [.result]
))

# Produce one fused SwiGLU down-projection output plus residual.
(def program qwen3.mlp-down-residual-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        ({(cap.ref mem) (cap.own mem)} *)
      } *)
