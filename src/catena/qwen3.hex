    ([.pair pair-58] u64.ne bool.not [is-pair-58.])
    (const.u64.0x000000000000003B [pair-59.])
    ([.pair pair-59] u64.ne bool.not [is-pair-59.])
    (const.u64.0x000000000000003C [pair-60.])
    ([.pair pair-60] u64.ne bool.not [is-pair-60.])
    (const.u64.0x000000000000003D [pair-61.])
    ([.pair pair-61] u64.ne bool.not [is-pair-61.])
    (const.u64.0x000000000000003E [pair-62.])
    ([.pair pair-62] u64.ne bool.not [is-pair-62.])
    ([.is-pair-62 frequency-62 frequency-63] f32.select [selected-62.])
    ([.is-pair-61 frequency-61 selected-62] f32.select [selected-61.])
    ([.is-pair-60 frequency-60 selected-61] f32.select [selected-60.])
    ([.is-pair-59 frequency-59 selected-60] f32.select [selected-59.])
    ([.is-pair-58 frequency-58 selected-59] f32.select [selected-58.])
    ([.is-pair-57 frequency-57 selected-58] f32.select [selected-57.])
    ([.is-pair-56 frequency-56 selected-57] f32.select [selected-56.])
    ([.is-pair-55 frequency-55 selected-56] f32.select [selected-55.])
    ([.is-pair-54 frequency-54 selected-55] f32.select [selected-54.])
    ([.is-pair-53 frequency-53 selected-54] f32.select [selected-53.])
    ([.is-pair-52 frequency-52 selected-53] f32.select [selected-52.])
    ([.is-pair-51 frequency-51 selected-52] f32.select [selected-51.])
