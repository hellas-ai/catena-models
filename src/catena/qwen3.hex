# Produce one RoPE-applied key cache element from a newly projected K row.
(def program qwen3.cache-key-at :
  ([n.] {
    ({
      ({(cap.own mem) (cap.ref mem)} *)
      (u64 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [key-and-rope sequence.])
  ([.key-and-rope] *.elim [key rope.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000200 [key-features.])
  (const.u64.0x0000000000000080 [head-dim.])
  (const.u64.0x0000000000000004 [key-head-count.])
  ([.flat-output-index key-features] u64.div [position.])
  ([.flat-output-index key-features] u64.rem [key-channel.])
  ([.key-channel head-dim] u64.div [key-head.])
  ([.key-channel head-dim] u64.rem [head-channel.])
  ({[.key] [.rope] [.sequence] [.key-head-count] [.position] [.key-head] [.head-channel]}
    qwen3.rope-value [result.])
  [.result]
))

# Produce one raw value cache element from a newly projected V row.
(def program qwen3.cache-value-at :
  ([n.] {({(cap.own mem) (u64 val)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [value _sequence.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.value] mem.cast.f32 [value-count value-buffer.])
  ({[.value-count] [.value-buffer] [.flat-output-index]}
    qwen3.f32-buffer-at [result.])
  [.result]
))

# Append RoPE-applied keys to one layer's K region. Cache layout is
# [layer, K-or-V, token, 192], with a session-specific token capacity.
(def program qwen3.cache-append-key :
  {
    (cap.own mem)
    (cap.own mem)
    (cap.ref mem)
    (u64 val)
    (u64 val)
    (u64 val)
    (u64 val)
  }
  ->
  (cap.own mem)
= ([cache key rope sequence token-capacity start layer.]
  ([.cache] mem.cast.f32 [cache-count cache-buffer.])
  (const.u64.0x0000000000000200 [key-features.])
  (const.u64.0x0000000000000002 [key-value-planes.])
  ([.token-capacity key-features] u64.mul [plane-stride.])
  ([.plane-stride key-value-planes] u64.mul [layer-stride.])
  ([.layer layer-stride] u64.mul [layer-base.])
  ([.start key-features] u64.mul [start-offset.])
  ([.layer-base start-offset] u64.add [write-offset.])
  ([.sequence key-features] u64.mul [write-count-value.])
  ([.write-count-value] u64.name [write-count.])
  ({[.key] [.rope]} *.intro [key-and-rope.])
  ({[.key-and-rope] [.sequence]} *.intro [env.])
  {
    [.cache-buffer]
    [.cache-count]
    [.write-offset]
    [.write-count]
    [.env]
    (([.write-count] :.param) name.qwen3.cache-key-at)
  } materializec.into [cache-after.]
  ({[.cache-count] [.cache-after]} buf.to-mem)
))

# Append raw values to the matching layer's V region.
(def program qwen3.cache-append-value :
  {
    (cap.own mem)
    (cap.own mem)
    (u64 val)
    (u64 val)
    (u64 val)
    (u64 val)
  }
  ->
  (cap.own mem)
= ([cache value sequence token-capacity start layer.]
  ([.cache] mem.cast.f32 [cache-count cache-buffer.])
  (const.u64.0x0000000000000200 [value-features.])
  (const.u64.0x0000000000000002 [key-value-planes.])
  ([.token-capacity value-features] u64.mul [plane-stride.])
  ([.plane-stride key-value-planes] u64.mul [layer-stride.])
  ([.layer layer-stride] u64.mul [layer-base.])
  ([.layer-base plane-stride] u64.add [value-base.])
  ([.start value-features] u64.mul [start-offset.])
  ([.value-base start-offset] u64.add [write-offset.])
  ([.sequence value-features] u64.mul [write-count-value.])
  ([.write-count-value] u64.name [write-count.])
  ({[.value] [.sequence]} *.intro [env.])
  {
    [.cache-buffer]
    [.cache-count]
    [.write-offset]
    [.write-count]
    [.env]
    (([.write-count] :.param) name.qwen3.cache-value-at)
  } materializec.into [cache-after.]
  ({[.cache-count] [.cache-after]} buf.to-mem)
))

# One channel term in a dot product between a locally projected query and a
# RoPE-applied key already stored in the persistent cache.
(def program qwen3.cached-score-term-at :
  ([cache-count n.] {
    ({
      ({({({[.cache-count] u64} :) ({cap.ref [.cache-count] f32} buf val)} *)
        ({(cap.own mem) (cap.ref mem)} *)} *)
      ({
        ({(u64 val) (u64 val)} *)
        ({({(u64 val) (u64 val)} *) ({({(u64 val) (u64 val)} *) (u64 val)} *)} *)
      } *)
    } *)
    ([.n] ix val)
  })
  ->
  ([cache-count n.] (f32 val))
= ([env channel-index.]
  ([.env] *.elim [buffer-inputs coordinates.])
  ([.buffer-inputs] *.elim [cache-input query-and-rope.])
  ([.cache-input] *.elim [cache-count-value cache-buffer.])
  ([.query-and-rope] *.elim [query rope.])
  ([.coordinates] *.elim [sequence-and-capacity position-inputs.])
  ([.sequence-and-capacity] *.elim [sequence token-capacity.])
  ([.position-inputs] *.elim [start-and-layer query-key-and-head.])
  ([.start-and-layer] *.elim [start layer.])
  ([.query-key-and-head] *.elim [query-and-key query-head.])
  ([.query-and-key] *.elim [query-position key-position.])
  ([.channel-index] ix.to-u64 [channel.])
  (const.u64.0x0000000000000008 [query-heads-per-key-head.])
  ([.query-head query-heads-per-key-head] u64.div [key-head.])
  (const.u64.0x0000000000000020 [query-head-count.])
  ({[.query] [.rope] [.sequence] [.query-head-count] [.query-position] [.query-head] [.channel]}
    qwen3.rope-value [query-value.])
  (const.u64.0x0000000000000200 [key-features.])
  (const.u64.0x0000000000000080 [head-dim.])
  (const.u64.0x0000000000000002 [key-value-planes.])
  ([.token-capacity key-features] u64.mul [plane-stride.])
  ([.plane-stride key-value-planes] u64.mul [layer-stride.])
  ([.layer layer-stride] u64.mul [layer-base.])
  ([.key-position key-features] u64.mul [key-row-offset.])
  ([.key-head head-dim] u64.mul [key-head-offset.])
  ([.layer-base key-row-offset] u64.add [key-row-base.])
  ([.key-row-base key-head-offset] u64.add [key-channel-base.])
  ([.key-channel-base channel] u64.add [cache-index.])
  ({[.cache-count-value] [.cache-buffer] [.cache-index]}
    qwen3.f32-buffer-at [key-value.])
  ([.query-value key-value] f32.mul [result.])
  [.result]
))

# Compute one cached attention score by reducing the 64 head channels.
(def program qwen3.cached-score-at :
  ([cache-count.] {
    ({
      ({
        ({({[.cache-count] u64} :) ({cap.ref [.cache-count] f32} buf val)} *)
        ({(cap.own mem) (cap.ref mem)} *)
      } *)
      ({
        ({(u64 val) (u64 val)} *)
        ({({(u64 val) (u64 val)} *) ({({(u64 val) (u64 val)} *) (u64 val)} *)} *)
      } *)
    } *)
  })
  ->
  ([cache-count.] (f32 val))
= ([score-env.]
  (const.u32.0x00000000 u32.bitcast-f32 [result.])
  [.result]
))

# Adapt a key-position index to the cached score environment.
(def program qwen3.cached-score-for-key-at :
  ([cache-count n.] {
    ({
      ({
        ({
          ({({[.cache-count] u64} :) ({cap.ref [.cache-count] f32} buf val)} *)
          ({(cap.own mem) (cap.ref mem)} *)
        } *)
        ({({(u64 val) (u64 val)} *) ({(u64 val) (u64 val)} *)} *)
      } *)
      ({(u64 val) (u64 val)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([cache-count n.] (f32 val))
= ([env key-index.]
  ([.env] *.elim [base-inputs query-and-head.])
  ([.base-inputs] *.elim [buffer-inputs scalar-inputs.])
  ([.scalar-inputs] *.elim [sequence-and-capacity start-and-layer.])
  ([.query-and-head] *.elim [query-position query-head.])
  ([.key-index] ix.to-u64 [key-position.])
  ({[.query-position] [.key-position]} *.intro [query-and-key.])
  ({[.query-and-key] [.query-head]} *.intro [query-key-and-head.])
  ({[.start-and-layer] [.query-key-and-head]} *.intro [position-inputs.])
  ({[.sequence-and-capacity] [.position-inputs]} *.intro [coordinates.])
  ({[.buffer-inputs] [.coordinates]} *.intro [score-env.])
  ([.score-env] qwen3.cached-score-at [result.])
  [.result]
))

# Stable-softmax exponential term for one cached key position.
(def program qwen3.cached-exp-for-key-at :
  ([cache-count n.] {
    ({
      ({
        ({
          ({
            ({({[.cache-count] u64} :) ({cap.ref [.cache-count] f32} buf val)} *)
            ({(cap.own mem) (cap.ref mem)} *)
          } *)
          ({({(u64 val) (u64 val)} *) ({(u64 val) (u64 val)} *)} *)
        } *)
        ({(u64 val) (u64 val)} *)
      } *)
      (f32 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([cache-count n.] (f32 val))
= ([env key-index.]
  ([.env] *.elim [score-inputs row-max.])
  ({[.score-inputs] [.key-index]}
    qwen3.cached-score-for-key-at [score.])
  ([.score row-max] f32.sub [shifted.])
  ([.shifted] qwen3.exp [result.])
  [.result]
))

# Weighted cached V term for one output channel and key position.
(def program qwen3.cached-value-for-key-at :
  ([cache-count n.] {
    ({
      ({
        ({
          ({
            ({
              ({({[.cache-count] u64} :) ({cap.ref [.cache-count] f32} buf val)} *)
              ({(cap.own mem) (cap.ref mem)} *)
            } *)
            ({({(u64 val) (u64 val)} *) ({(u64 val) (u64 val)} *)} *)
          } *)
          ({(u64 val) (u64 val)} *)
        } *)
        ({(f32 val) (f32 val)} *)
      } *)
      (u64 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([cache-count n.] (f32 val))
= ([env key-index.]
  ([.env] *.elim [probability-inputs head-channel.])
  ([.probability-inputs] *.elim [score-inputs max-and-denominator.])
  ([.score-inputs] *.elim [base-inputs query-and-head.])
  ([.base-inputs] *.elim [buffer-inputs scalar-inputs.])
  ([.buffer-inputs] *.elim [cache-input _query-and-rope.])
  ([.cache-input] *.elim [cache-count-value cache-buffer.])
  ([.scalar-inputs] *.elim [sequence-and-capacity start-and-layer.])
  ([.sequence-and-capacity] *.elim [_sequence token-capacity.])
  ([.start-and-layer] *.elim [_start layer.])
  ([.query-and-head] *.elim [_query-position query-head.])
  ([.max-and-denominator] *.elim [row-max denominator.])
  ({[.score-inputs] [.key-index]}
    qwen3.cached-score-for-key-at [score.])
  ([.score row-max] f32.sub [shifted.])
  ([.shifted] qwen3.exp [exponential.])
  ([.exponential denominator] f32.div [probability.])
  ([.key-index] ix.to-u64 [key-position.])
  (const.u64.0x0000000000000008 [query-heads-per-key-head.])
  ([.query-head query-heads-per-key-head] u64.div [key-head.])
  (const.u64.0x0000000000000200 [value-features.])
  (const.u64.0x0000000000000080 [head-dim.])
  (const.u64.0x0000000000000002 [key-value-planes.])
  ([.token-capacity value-features] u64.mul [plane-stride.])
  ([.plane-stride key-value-planes] u64.mul [layer-stride.])
  ([.layer layer-stride] u64.mul [layer-base.])
  ([.layer-base plane-stride] u64.add [value-base.])
  ([.key-position value-features] u64.mul [value-row-offset.])
  ([.key-head head-dim] u64.mul [value-head-offset.])
  ([.value-base value-row-offset] u64.add [value-row-base.])
  ([.value-row-base value-head-offset] u64.add [value-channel-base.])
  ([.value-channel-base head-channel] u64.add [cache-index.])
  ({[.cache-count-value] [.cache-buffer] [.cache-index]}
    qwen3.f32-buffer-at [value.])
  ([.probability value] f32.mul [result.])
  [.result]
))

# The cache borrow is converted back to a sized `cap.ref mem` before nested
# reductions. This keeps the physical cache length available without threading
# it as an additional dependent parameter through every reduction helper.
(def program qwen3.cached2-score-term-at :
  ([n.] {
    ({
      ({(cap.ref mem) ({(cap.own mem) (cap.ref mem)} *)} *)
      ({
        ({(u64 val) (u64 val)} *)
        ({({(u64 val) (u64 val)} *) ({({(u64 val) (u64 val)} *) (u64 val)} *)} *)
      } *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env channel-index.]
  ([.env] *.elim [buffer-inputs coordinates.])
  ([.buffer-inputs] *.elim [cache query-and-rope.])
  ([.query-and-rope] *.elim [query rope.])
  ([.coordinates] *.elim [sequence-and-capacity position-inputs.])
  ([.sequence-and-capacity] *.elim [sequence token-capacity.])
  ([.position-inputs] *.elim [start-and-layer query-key-and-head.])
  ([.start-and-layer] *.elim [_start layer.])
  ([.query-key-and-head] *.elim [query-and-key query-head.])
  ([.query-and-key] *.elim [query-position key-position.])
  ([.channel-index] ix.to-u64 [channel.])
  (const.u64.0x0000000000000008 [query-heads-per-key-head.])
  ([.query-head query-heads-per-key-head] u64.div [key-head.])
  (const.u64.0x0000000000000020 [query-head-count.])
  ({[.query] [.rope] [.sequence] [.query-head-count] [.query-position] [.query-head] [.channel]}
    qwen3.rope-value [query-value.])
  (const.u64.0x0000000000000200 [key-features.])
  (const.u64.0x0000000000000080 [head-dim.])
  (const.u64.0x0000000000000002 [key-value-planes.])
  ([.token-capacity key-features] u64.mul [plane-stride.])
  ([.plane-stride key-value-planes] u64.mul [layer-stride.])
  ([.layer layer-stride] u64.mul [layer-base.])
  ([.key-position key-features] u64.mul [key-row-offset.])
  ([.key-head head-dim] u64.mul [key-head-offset.])
  ([.layer-base key-row-offset] u64.add [key-row-base.])
  ([.key-row-base key-head-offset] u64.add [key-channel-base.])
  ([.key-channel-base channel] u64.add [cache-index.])
  ([.cache] mem.cast.f32 [cache-count cache-buffer.])
  ({[.cache-count] [.cache-buffer] [.cache-index]}
    qwen3.f32-buffer-at [key-value.])
  ([.query-value key-value] f32.mul [result.])
  [.result]
))

(def program qwen3.cached2-score-at :
  ({
    ({(cap.ref mem) ({(cap.own mem) (cap.ref mem)} *)} *)
    ({
      ({(u64 val) (u64 val)} *)
      ({({(u64 val) (u64 val)} *) ({({(u64 val) (u64 val)} *) (u64 val)} *)} *)
    } *)
  } *)
  ->
  (f32 val)
= ([score-env.]
  (const.u64.0x0000000000000080 [head-dim-value.])
  ([.head-dim-value] u64.name [head-dim.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.score-env] (([.head-dim] :.param) name.qwen3.cached2-score-term-at)})
    [.head-dim]
  } reducec [unscaled.])
  (const.u32.0x3DB504F3 u32.bitcast-f32 [attention-scale.])
  ([.unscaled attention-scale] f32.mul [result.])
  [.result]
))

(def program qwen3.cached2-score-for-key-at :
