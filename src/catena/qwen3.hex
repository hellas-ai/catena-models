(def program qwen3.cached2-value-for-key-at :
  ([n.] {
    ({
      ({
        ({
          ({
            ({(cap.ref mem) ({(cap.own mem) (cap.ref mem)} *)} *)
            ({({(u64 val) (u64 val)} *) ({(u64 val) (u64 val)} *)} *)
          } *)
          ({(u64 val) (u64 val)} *)
        } *)
        ({(f32 val) (f32 val)} *)
      } *)
