# layout. The 64-channel dot product is a fixed left-to-right reducec fold;
# every score is computed exactly once before softmax and context kernels.
(def program qwen3.cached-staged-score-at :
  ([cache-count score-count.] {
    ({cap.ref [.cache-count] f32} buf val)
    ({
      ({
        ({({[.cache-count] u64} :) ({(cap.own mem) (cap.own mem)} *)} *)
        ({({(u64 val) (u64 val)} *) ({(u64 val) (u64 val)} *)} *)
      } *)
      ([.score-count] ix val)
    } *)
  })
  ->
  ([cache-count score-count.] (f32 val))
= ([cache-buffer env.]
  ([.env] *.elim [inputs output-index.])
  ([.inputs] *.elim [buffer-inputs scalar-inputs.])
  ([.buffer-inputs] *.elim [cache-count-value query-and-rope.])
  ([.scalar-inputs] *.elim [sequence-and-capacity start-and-layer.])
  ([.sequence-and-capacity] *.elim [sequence token-capacity.])
  ([.start-and-layer] *.elim [start layer.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.start sequence] u64.add [history.])
  ([.flat-output-index history] u64.div [score-row.])
  ([.flat-output-index history] u64.rem [key-position.])
  (const.u64.0x0000000000000020 [query-head-count.])
  ([.score-row query-head-count] u64.div [query-position.])
  ([.score-row query-head-count] u64.rem [query-head.])
  ({[.cache-count-value] [.cache-buffer]} buf.to-mem [cache-memory.])
  ({[.cache-memory] [.query-and-rope]} *.intro [term-buffer-inputs.])
  ({[.sequence] [.token-capacity]} *.intro [term-sequence-and-capacity.])
  ({[.start] [.layer]} *.intro [term-start-and-layer.])
  ({[.query-position] [.key-position]} *.intro [query-and-key.])
  ({[.query-and-key] [.query-head]} *.intro [query-key-and-head.])
  ({[.term-start-and-layer] [.query-key-and-head]} *.intro [position-inputs.])
  ({[.term-sequence-and-capacity] [.position-inputs]} *.intro [coordinates.])
  ({[.term-buffer-inputs] [.coordinates]} *.intro [score-env.])
  ([.score-env] qwen3.cached2-score-at [scaled-score.])
  ([.start query-position] u64.add [absolute-query-position.])
  ([.key-position absolute-query-position] u64.lte [is-causal.])
  (const.u32.0xFF800000 u32.bitcast-f32 [negative-infinity.])
  ([.is-causal scaled-score negative-infinity] f32.select [result.])
  [.result]
))

# Borrow the persistent cache for the score kernel, returning its owner only
# after all staged scores have been enqueued.
(def program qwen3.cached-staged-scores :
  {
    (cap.own mem)
