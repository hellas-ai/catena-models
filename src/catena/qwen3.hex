# Deterministic sine/cosine for non-negative RoPE angles through the model's
# 32K context. A three-part pi/2 split keeps range-reduction products exact
# enough in F32; fdlibm-derived degree-13/14 kernel polynomials operate on the
# resulting interval of approximately [-pi/4, pi/4]. Every arithmetic step is
# explicit so GPU dialects retain the same specified operation graph.
(def program qwen3.rope-sincos : (f32 val) -> {(f32 val) (f32 val)} =
  ([angle.]
    (const.u32.0x3F22F983 u32.bitcast-f32 [inverse-pi-over-two.])
    (const.u32.0x3FC90000 u32.bitcast-f32 [pi-over-two-1.])
    (const.u32.0x39FDA000 u32.bitcast-f32 [pi-over-two-2.])
    (const.u32.0x33A22169 u32.bitcast-f32 [pi-over-two-3.])
    ([.angle inverse-pi-over-two] f32.mul [scaled-quadrant.])
    ([.scaled-quadrant] f32.round-to-u32 [quadrant-count.])
    ([.quadrant-count] u32.to-f32 [quadrant-count-f32.])
    ([.quadrant-count-f32 pi-over-two-1] f32.mul [range-term-1.])
    ([.angle range-term-1] f32.sub [reduced-1.])
    ([.quadrant-count-f32 pi-over-two-2] f32.mul [range-term-2.])
    ([.reduced-1 range-term-2] f32.sub [reduced-2.])
    ([.quadrant-count-f32 pi-over-two-3] f32.mul [range-term-3.])
    ([.reduced-2 range-term-3] f32.sub [reduced.])
    ([.reduced reduced] f32.mul [squared.])

    (const.u32.0xBE2AAAAB u32.bitcast-f32 [sin-c1.])
    (const.u32.0x3C088889 u32.bitcast-f32 [sin-c2.])
    (const.u32.0xB9500D01 u32.bitcast-f32 [sin-c3.])
    (const.u32.0x3638EF1B u32.bitcast-f32 [sin-c4.])
    (const.u32.0xB2D72F34 u32.bitcast-f32 [sin-c5.])
    (const.u32.0x2F2EC9D3 u32.bitcast-f32 [sin-c6.])
    ([.squared sin-c6] f32.mul [sin-p5-term.])
    ([.sin-c5 sin-p5-term] f32.add [sin-p5.])
    ([.squared sin-p5] f32.mul [sin-p4-term.])
    ([.sin-c4 sin-p4-term] f32.add [sin-p4.])
    ([.squared sin-p4] f32.mul [sin-p3-term.])
    ([.sin-c3 sin-p3-term] f32.add [sin-p3.])
    ([.squared sin-p3] f32.mul [sin-p2-term.])
    ([.sin-c2 sin-p2-term] f32.add [sin-p2.])
    ([.squared sin-p2] f32.mul [sin-p1-term.])
    ([.sin-c1 sin-p1-term] f32.add [sin-p1.])
    ([.reduced squared] f32.mul [reduced-cubed.])
    ([.reduced-cubed sin-p1] f32.mul [sin-tail.])
    ([.reduced sin-tail] f32.add [sine-reduced.])

    (const.u32.0x3D2AAAAB u32.bitcast-f32 [cos-c1.])
    (const.u32.0xBAB60B61 u32.bitcast-f32 [cos-c2.])
    (const.u32.0x37D00D01 u32.bitcast-f32 [cos-c3.])
    (const.u32.0xB493F27C u32.bitcast-f32 [cos-c4.])
    (const.u32.0x310F74F6 u32.bitcast-f32 [cos-c5.])
    (const.u32.0xAD47D74E u32.bitcast-f32 [cos-c6.])
    ([.squared cos-c6] f32.mul [cos-p5-term.])
    ([.cos-c5 cos-p5-term] f32.add [cos-p5.])
    ([.squared cos-p5] f32.mul [cos-p4-term.])
    ([.cos-c4 cos-p4-term] f32.add [cos-p4.])
    ([.squared cos-p4] f32.mul [cos-p3-term.])
    ([.cos-c3 cos-p3-term] f32.add [cos-p3.])
    ([.squared cos-p3] f32.mul [cos-p2-term.])
    ([.cos-c2 cos-p2-term] f32.add [cos-p2.])
    ([.squared cos-p2] f32.mul [cos-p1-term.])
    ([.cos-c1 cos-p1-term] f32.add [cos-p1.])
    ([.squared squared] f32.mul [fourth-power.])
    ([.fourth-power cos-p1] f32.mul [cos-tail.])
    (const.u32.0x3F000000 u32.bitcast-f32 [half.])
    ([.squared half] f32.mul [half-squared.])
    (f32.one [one.])
    ([.one half-squared] f32.sub [cos-head.])
    ([.cos-head cos-tail] f32.add [cosine-reduced.])

    ([.sine-reduced] f32.neg [negative-sine.])
    ([.cosine-reduced] f32.neg [negative-cosine.])
    (const.u32.0x00000003 [quadrant-mask.])
    (const.u32.0x00000000 [quadrant-0.])
    (const.u32.0x00000001 [quadrant-1.])
    (const.u32.0x00000002 [quadrant-2.])
    ([.quadrant-count quadrant-mask] u32.and [quadrant.])
    ([.quadrant quadrant-0] u32.eq [is-quadrant-0.])
    ([.quadrant quadrant-1] u32.eq [is-quadrant-1.])
    ([.quadrant quadrant-2] u32.eq [is-quadrant-2.])
    ([.is-quadrant-2 negative-sine negative-cosine] f32.select [sine-q23.])
    ([.is-quadrant-1 cosine-reduced sine-q23] f32.select [sine-q123.])
    ([.is-quadrant-0 sine-reduced sine-q123] f32.select [sine.])
    ([.is-quadrant-2 negative-cosine sine-reduced] f32.select [cosine-q23.])
    ([.is-quadrant-1 negative-sine cosine-q23] f32.select [cosine-q123.])
    ([.is-quadrant-0 cosine-reduced cosine-q123] f32.select [cosine.])
    {[.sine] [.cosine]}
  )
)

# Materialize [cos(sequence, 64), sin(sequence, 64)] inside Catena from the
# absolute start position. This buffer is constructed once per model call and
# shared by all decoder layers.
(def program qwen3.rope-table-at :
  ([n.] {({(u64 val) (u64 val)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [start sequence.])
  ([.output-index] ix.to-u64 [flat-index.])
  (const.u64.0x0000000000000040 [half-head-dim.])
  ([.sequence half-head-dim] u64.mul [plane-size.])
  ([.flat-index plane-size] u64.gte [is-sine-plane.])
  ([.flat-index plane-size] u64.rem [plane-index.])
  ([.plane-index half-head-dim] u64.div [local-position.])
  ([.plane-index half-head-dim] u64.rem [pair.])
  ([.start local-position] u64.add [absolute-position.])
  ([.absolute-position] u64.to-f32 [position-f32.])
  ([.pair] qwen3.rope-frequency [frequency.])
  ([.position-f32 frequency] f32.mul [angle.])
  ([.angle] qwen3.rope-sincos [sine cosine.])
  ([.is-sine-plane sine cosine] f32.select [result.])
  [.result]
))

(def program qwen3.rope-table :
  {(u64 val) (u64 val)}
  ->
  (cap.own mem)
= ([start sequence.]
  (const.u64.0x0000000000000080 [values-per-position.])
  ([.sequence values-per-position] u64.mul [table-count-value.])
  ([.table-count-value] u64.name [table-count.])
  ({[.start] [.sequence]} *.intro [env.])
  {
    [.table-count]
    ({[.table-count] [.env] (([.table-count] :.param) name.qwen3.rope-table-at)}
      materializec)
  } buf.to-mem
))

# Read one non-interleaved RoPE-rotated channel from a projected tensor.
# Projection layout is [sequence, head-count, 128]; the RoPE buffer contains
# [cos(sequence, 64), sin(sequence, 64)].
(def program qwen3.rope-value :
  {
    (cap.own mem)
    (cap.own mem)
    (u64 val)
    (u64 val)
    (u64 val)
    (u64 val)
    (u64 val)
  }
  ->
  (f32 val)
= ([projection rope sequence head-count position head channel.]
  (const.u64.0x0000000000000080 [head-dim.])
  (const.u64.0x0000000000000040 [half-head-dim.])
  ([.channel half-head-dim] u64.rem [pair.])
  ([.channel half-head-dim] u64.gte [is-second-half.])
  ([.pair half-head-dim] u64.add [second-channel.])
  ([.is-second-half pair second-channel] u64.select [partner-channel.])
  ([.head-count head-dim] u64.mul [projection-features.])
  ([.position projection-features] u64.mul [projection-row-offset.])
  ([.head head-dim] u64.mul [projection-head-offset.])
  ([.projection-row-offset projection-head-offset] u64.add [projection-head-base.])
  ([.projection-head-base channel] u64.add [projection-index.])
  ([.projection-head-base partner-channel] u64.add [partner-index.])
  ([.projection] mem.cast.f32 [projection-count projection-buffer.])
  ({[.projection-count] [.projection-buffer] [.projection-index]}
    qwen3.f32-buffer-at [projection-value.])
  ({[.projection-count] [.projection-buffer] [.partner-index]}
    qwen3.f32-buffer-at [partner-value.])
  ([.position half-head-dim] u64.mul [rope-row-offset.])
  ([.rope-row-offset pair] u64.add [rope-pair-index.])
  ([.sequence half-head-dim] u64.mul [rope-plane-size.])
  ([.rope-plane-size rope-pair-index] u64.add [rope-sin-index.])
  ([.rope] mem.cast.f32 [rope-count rope-buffer.])
  ({[.rope-count] [.rope-buffer] [.rope-pair-index]}
    qwen3.f32-buffer-at [cosine.])
  ({[.rope-count] [.rope-buffer] [.rope-sin-index]}
    qwen3.f32-buffer-at [sine.])
  ([.projection-value cosine] f32.mul [cosine-term.])
  ([.partner-value sine] f32.mul [sine-term.])
  ([.cosine-term sine-term] f32.sub [rotated-first.])
  ([.cosine-term sine-term] f32.add [rotated-second.])
  ([.is-second-half rotated-second rotated-first] f32.select [result.])
  [.result]
))

# One channel term in a rotary Q/K dot product. Query heads map to shared
# key heads by integer division by three.
(def program qwen3.attention-score-term-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        (cap.own mem)
      } *)
      ({
        ({(u64 val) (u64 val)} *)
        ({(u64 val) (u64 val)} *)
      } *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env channel-index.]
  ([.env] *.elim [buffer-inputs coordinates.])
  ([.buffer-inputs] *.elim [query-and-key rope.])
  ([.query-and-key] *.elim [query key.])
  ([.coordinates] *.elim [sequence-and-query key-and-head.])
  ([.sequence-and-query] *.elim [sequence query-position.])
  ([.key-and-head] *.elim [key-position query-head.])
  ([.channel-index] ix.to-u64 [channel.])
  (const.u64.0x0000000000000008 [query-heads-per-key-head.])
  ([.query-head query-heads-per-key-head] u64.div [key-head.])
  (const.u64.0x0000000000000020 [query-head-count.])
  (const.u64.0x0000000000000004 [key-head-count.])
  ({[.query] [.rope] [.sequence] [.query-head-count] [.query-position] [.query-head] [.channel]}
    qwen3.rope-value [query-value.])
  ({[.key] [.rope] [.sequence] [.key-head-count] [.key-position] [.key-head] [.channel]}
    qwen3.rope-value [key-value.])
  ([.query-value key-value] f32.mul [term.])
  [.term]
))

# Produce one [query-head, query-position, key-position] attention score.
(def program qwen3.attention-score-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        (cap.own mem)
      } *)
      (u64 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [buffer-inputs sequence.])
  ([.buffer-inputs] *.elim [query-and-key rope.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.sequence sequence] u64.mul [score-plane-size.])
  ([.flat-output-index score-plane-size] u64.div [query-head.])
  ([.flat-output-index score-plane-size] u64.rem [score-plane-index.])
  ([.score-plane-index sequence] u64.div [query-position.])
  ([.score-plane-index sequence] u64.rem [key-position.])
  ({[.query-and-key] [.rope]} *.intro [term-buffer-inputs.])
  ({[.sequence] [.query-position]} *.intro [sequence-and-query.])
  ({[.key-position] [.query-head]} *.intro [key-and-head.])
  ({[.sequence-and-query] [.key-and-head]} *.intro [coordinates.])
  ({[.term-buffer-inputs] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000080 [head-dim-value.])
  ([.head-dim-value] u64.name [head-dim.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.head-dim] :.param) name.qwen3.attention-score-term-at)})
    [.head-dim]
  } reducec [unscaled-score.])
  (const.u32.0x3DB504F3 u32.bitcast-f32 [attention-scale.])
  ([.unscaled-score attention-scale] f32.mul [scaled-score.])
  ([.key-position query-position] u64.lte [is-causal.])
  (const.u32.0xFF800000 u32.bitcast-f32 [negative-infinity.])
  ([.is-causal scaled-score negative-infinity] f32.select [result.])
  [.result]
))

# Materialize causal rotary-GQA scores in [9, sequence, sequence] layout.
(def program qwen3.attention-scores :
  {(cap.own mem) (cap.own mem) (cap.own mem) (u64 val)}
  ->
  (cap.own mem)
= ([query key rope sequence.]
  (const.u64.0x0000000000000020 [query-head-count.])
  ([.sequence sequence] u64.mul [score-plane-size.])
  ([.query-head-count score-plane-size] u64.mul [score-count-value.])
  ([.score-count-value] u64.name [score-count.])
  ({[.query] [.key]} *.intro [query-and-key.])
  ({[.query-and-key] [.rope]} *.intro [buffer-inputs.])
  ({[.buffer-inputs] [.sequence]} *.intro [env.])
  {
    [.score-count]
    ({[.score-count] [.env] (([.score-count] :.param) name.qwen3.attention-score-at)}
      materializec)
  }
  buf.to-mem
))

# Read one causal score for a row-wise reduction.
(def program qwen3.attention-row-score-at :
  ([n.] {
    ({
      ({(cap.own mem) (u64 val)} *)
      ({(u64 val) (u64 val)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env key-index.]
  ([.env] *.elim [score-input coordinates.])
  ([.score-input] *.elim [scores sequence.])
  ([.coordinates] *.elim [query-head query-position.])
  ([.key-index] ix.to-u64 [key-position.])
  ([.sequence sequence] u64.mul [score-plane-size.])
  ([.query-head score-plane-size] u64.mul [score-head-offset.])
  ([.query-position sequence] u64.mul [score-row-offset.])
  ([.score-head-offset score-row-offset] u64.add [score-row-base.])
  ([.score-row-base key-position] u64.add [score-index.])
  ([.scores] mem.cast.f32 [score-count score-buffer.])
  ({[.score-count] [.score-buffer] [.score-index]}
    qwen3.f32-buffer-at [result.])
  [.result]
))

# Produce the maximum of one causal attention row.
(def program qwen3.attention-row-max-at :
  ([n.] {
    ({({(cap.own mem) (u64 val)} *) ([.n] ix val)})
  })
  ->
  ([n.] (f32 val))
= ([score-input output-index.]
  ([.score-input] *.elim [scores sequence.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.flat-output-index sequence] u64.div [query-head.])
  ([.flat-output-index sequence] u64.rem [query-position.])
  ({[.scores] [.sequence]} *.intro [term-score-input.])
  ({[.query-head] [.query-position]} *.intro [coordinates.])
  ({[.term-score-input] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000001 [one.])
  ([.query-position one] u64.add [causal-count-value.])
  ([.causal-count-value] u64.name [causal-count.])
  ({
    (const.u32.0xFF800000 u32.bitcast-f32)
    unit.intro
    name.f32.max-env
    ({[.term-env] (([.causal-count] :.param) name.qwen3.attention-row-score-at)})
    [.causal-count]
  } reducec [result.])
  [.result]
))

# Materialize one maximum per [query-head, query-position] score row.
(def program qwen3.attention-row-max :
  {(cap.own mem) (u64 val)}
  ->
  (cap.own mem)
= ([scores sequence.]
  (const.u64.0x0000000000000020 [query-head-count.])
  ([.query-head-count sequence] u64.mul [row-count-value.])
  ([.row-count-value] u64.name [row-count.])
  ({[.scores] [.sequence]} *.intro [score-input.])
  {
    [.row-count]
    ({[.row-count] [.score-input] (([.row-count] :.param) name.qwen3.attention-row-max-at)}
      materializec)
  }
  buf.to-mem
))

# Read exp(score - row_max) for a causal softmax denominator reduction.
(def program qwen3.attention-exp-term-at :
  ([n.] {
    ({
      ({(cap.own mem) (f32 val)} *)
      ({(u64 val) ({(u64 val) (u64 val)} *)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env key-index.]
  ([.env] *.elim [scores-and-max coordinates.])
  ([.scores-and-max] *.elim [scores row-max.])
  ([.coordinates] *.elim [sequence head-and-query.])
  ([.head-and-query] *.elim [query-head query-position.])
  ([.key-index] ix.to-u64 [key-position.])
  ([.sequence sequence] u64.mul [score-plane-size.])
  ([.query-head score-plane-size] u64.mul [score-head-offset.])
  ([.query-position sequence] u64.mul [score-row-offset.])
  ([.score-head-offset score-row-offset] u64.add [score-row-base.])
  ([.score-row-base key-position] u64.add [score-index.])
  ([.scores] mem.cast.f32 [score-count score-buffer.])
  ({[.score-count] [.score-buffer] [.score-index]}
    qwen3.f32-buffer-at [score.])
  ([.score row-max] f32.sub [shifted-score.])
  ([.shifted-score] qwen3.exp [result.])
  [.result]
))

# Produce the stable softmax denominator for one causal attention row.
(def program qwen3.attention-row-denominator-at :
  ([n.] {
    ({
      ({(cap.own mem) (cap.own mem)} *)
      (u64 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [scores-and-max-buffer sequence.])
  ([.scores-and-max-buffer] *.elim [scores row-max-buffer.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.flat-output-index sequence] u64.div [query-head.])
  ([.flat-output-index sequence] u64.rem [query-position.])
  ([.row-max-buffer] mem.cast.f32 [row-max-count row-max-values.])
  ({[.row-max-count] [.row-max-values] [.flat-output-index]}
    qwen3.f32-buffer-at [row-max.])
  ({[.scores] [.row-max]} *.intro [scores-and-max.])
  ({[.query-head] [.query-position]} *.intro [head-and-query.])
  ({[.sequence] [.head-and-query]} *.intro [coordinates.])
  ({[.scores-and-max] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000001 [one.])
  ([.query-position one] u64.add [causal-count-value.])
  ([.causal-count-value] u64.name [causal-count.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.causal-count] :.param) name.qwen3.attention-exp-term-at)})
    [.causal-count]
  } reducec [result.])
  [.result]
))

# Materialize stable softmax denominators in [9, sequence] layout.
(def program qwen3.attention-row-denominator :
  {(cap.own mem) (cap.own mem) (u64 val)}
  ->
  (cap.own mem)
= ([scores row-max sequence.]
  (const.u64.0x0000000000000020 [query-head-count.])
  ([.query-head-count sequence] u64.mul [row-count-value.])
  ([.row-count-value] u64.name [row-count.])
  ({[.scores] [.row-max]} *.intro [scores-and-max-buffer.])
  ({[.scores-and-max-buffer] [.sequence]} *.intro [env.])
  {
    [.row-count]
    ({[.row-count] [.env] (([.row-count] :.param) name.qwen3.attention-row-denominator-at)}
      materializec)
  }
  buf.to-mem
))

# One weighted V term for an attention-context channel.
(def program qwen3.attention-context-term-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        ({(f32 val) (f32 val)} *)
      } *)
      ({
        ({(u64 val) (u64 val)} *)
        ({(u64 val) (u64 val)} *)
      } *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env key-index.]
  ([.env] *.elim [value-inputs coordinates.])
  ([.value-inputs] *.elim [scores-and-value max-and-denominator.])
  ([.scores-and-value] *.elim [scores value.])
  ([.max-and-denominator] *.elim [row-max denominator.])
  ([.coordinates] *.elim [sequence-and-query head-and-channel.])
  ([.sequence-and-query] *.elim [sequence query-position.])
  ([.head-and-channel] *.elim [query-head head-channel.])
  ([.key-index] ix.to-u64 [key-position.])
  ([.sequence sequence] u64.mul [score-plane-size.])
  ([.query-head score-plane-size] u64.mul [score-head-offset.])
  ([.query-position sequence] u64.mul [score-row-offset.])
  ([.score-head-offset score-row-offset] u64.add [score-row-base.])
  ([.score-row-base key-position] u64.add [score-index.])
  ([.scores] mem.cast.f32 [score-count score-buffer.])
  ({[.score-count] [.score-buffer] [.score-index]}
    qwen3.f32-buffer-at [score.])
  ([.score row-max] f32.sub [shifted-score.])
  ([.shifted-score] qwen3.exp [exponential.])
  ([.exponential denominator] f32.div [probability.])
  (const.u64.0x0000000000000008 [query-heads-per-key-head.])
  ([.query-head query-heads-per-key-head] u64.div [key-head.])
  (const.u64.0x0000000000000080 [head-dim.])
  (const.u64.0x0000000000000200 [value-features.])
  ([.key-position value-features] u64.mul [value-row-offset.])
  ([.key-head head-dim] u64.mul [value-head-offset.])
  ([.value-row-offset value-head-offset] u64.add [value-head-base.])
  ([.value-head-base head-channel] u64.add [value-index.])
  ([.value] mem.cast.f32 [value-count value-buffer.])
  ({[.value-count] [.value-buffer] [.value-index]}
    qwen3.f32-buffer-at [value-element.])
  ([.probability value-element] f32.mul [result.])
  [.result]
))

# Produce one [query-position, query-head, head-channel] context value.
(def program qwen3.attention-context-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        ({(cap.own mem) (cap.own mem)} *)
      } *)
      (u64 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [buffers sequence.])
  ([.buffers] *.elim [scores-and-value max-and-denominator-buffer.])
  ([.scores-and-value] *.elim [scores value.])
  ([.max-and-denominator-buffer] *.elim [row-max-buffer denominator-buffer.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  (const.u64.0x0000000000000080 [head-dim.])
  ([.flat-output-index hidden-size] u64.div [query-position.])
  ([.flat-output-index hidden-size] u64.rem [hidden-channel.])
  ([.hidden-channel head-dim] u64.div [query-head.])
  ([.hidden-channel head-dim] u64.rem [head-channel.])
  ([.query-head sequence] u64.mul [row-head-offset.])
  ([.row-head-offset query-position] u64.add [row-index.])
  ([.row-max-buffer] mem.cast.f32 [row-max-count row-max-values.])
  ([.denominator-buffer] mem.cast.f32 [denominator-count denominator-values.])
  ({[.row-max-count] [.row-max-values] [.row-index]}
    qwen3.f32-buffer-at [row-max.])
  ({[.denominator-count] [.denominator-values] [.row-index]}
    qwen3.f32-buffer-at [denominator.])
  ({[.scores] [.value]} *.intro [term-scores-and-value.])
  ({[.row-max] [.denominator]} *.intro [max-and-denominator.])
  ({[.term-scores-and-value] [.max-and-denominator]} *.intro [value-inputs.])
  ({[.sequence] [.query-position]} *.intro [sequence-and-query.])
  ({[.query-head] [.head-channel]} *.intro [head-and-channel.])
  ({[.sequence-and-query] [.head-and-channel]} *.intro [coordinates.])
  ({[.value-inputs] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000001 [one.])
  ([.query-position one] u64.add [causal-count-value.])
  ([.causal-count-value] u64.name [causal-count.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.causal-count] :.param) name.qwen3.attention-context-term-at)})
    [.causal-count]
  } reducec [result.])
  [.result]
))

# Materialize attention context as [sequence, 576].
(def program qwen3.attention-context :
  {
    (cap.own mem)
    (cap.own mem)
    (cap.own mem)
    (cap.own mem)
    (u64 val)
  }
  ->
  (cap.own mem)
= ([scores value row-max denominator sequence.]
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.sequence hidden-size] u64.mul [output-count-value.])
  ([.output-count-value] u64.name [output-count.])
  ({[.scores] [.value]} *.intro [scores-and-value.])
  ({[.row-max] [.denominator]} *.intro [max-and-denominator-buffer.])
  ({[.scores-and-value] [.max-and-denominator-buffer]} *.intro [buffers.])
  ({[.buffers] [.sequence]} *.intro [env.])
  {
    [.output-count]
    ({[.output-count] [.env] (([.output-count] :.param) name.qwen3.attention-context-at)}
      materializec)
  }
  buf.to-mem
))

# Free the first owned buffer only after the second owned buffer exists, then
# pass the second buffer through. Chaining this helper makes deallocation order
# explicit in the dataflow graph instead of relying on source statement order.
# The memory is cast to an owned typed buffer because only `buf.free` exists;
# borrowed buffers and untyped memory have no deallocation operation.
(def program qwen3.free-f32-before :
  {(cap.own mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([memory continuation.]
  ([.memory] mem.cast.f32 [_element-count owned-buffer.])
  ([.owned-buffer] buf.free)
  [.continuation]
))

(def program qwen3.free-u64-before :
  {(cap.own mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([memory continuation.]
  ([.memory] mem.cast.u64 [_element-count owned-buffer.])
  ([.owned-buffer] buf.free)
  [.continuation]
))

# Complete rotary grouped-query attention. Intermediate buffers are released
# only after the context materialization has synchronized.
(def program qwen3.attention :
  {
    (cap.own mem)
    (cap.own mem)
    (cap.own mem)
    (cap.own mem)
    (u64 val)
  }
  ->
  (cap.own mem)
= ([query key value rope sequence.]
  ({[.query] [.key] [.rope] [.sequence]}
    qwen3.attention-scores [scores.])
  ({[.scores] [.sequence]}
    qwen3.attention-row-max [row-max.])
  ({[.scores] [.row-max] [.sequence]}
    qwen3.attention-row-denominator [denominator.])
  ({[.scores] [.value] [.row-max] [.denominator] [.sequence]}
    qwen3.attention-context [context.])
  ({[.scores] [.context]}
    qwen3.free-f32-before [context-after-scores.])
  ({[.row-max] [.context-after-scores]}
    qwen3.free-f32-before [context-after-row-max.])
  ({[.denominator] [.context-after-row-max]}
    qwen3.free-f32-before [context-after-denominator.])
  [.context-after-denominator]
))

# One term of a bias-free linear projection with a residual epilogue.
(def program qwen3.linear-residual-term-at :
  ([n.] {
    ({
      ({(cap.own mem) (cap.ref mem)} *)
      ({(u64 val) ({(u64 val) (u64 val)} *)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env input-index.]
  ([.env] *.elim [input-and-weight coordinates.])
  ([.input-and-weight] *.elim [input linear-weight.])
  ([.coordinates] *.elim [input-features row-and-output.])
  ([.row-and-output] *.elim [row output-channel.])
  ([.input-index] ix.to-u64 [input-channel.])
  ([.row input-features] u64.mul [input-row-offset.])
  ([.input-row-offset input-channel] u64.add [flat-input-index.])
  ([.output-channel input-features] u64.mul [weight-row-offset.])
  ([.weight-row-offset input-channel] u64.add [weight-index.])
  ([.input] mem.cast.f32 [input-count input-buffer.])
  ([.linear-weight] mem.cast.bf16 [weight-count weight-buffer.])
  ({[.input-count] [.input-buffer] [.flat-input-index]}
    qwen3.f32-buffer-at [input-value.])
  ({[.weight-count] [.weight-buffer] [.weight-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [weight-value.])
  ([.input-value weight-value] f32.mul [result.])
  [.result]
))

# Produce one 576-wide projected value and add its residual element.
(def program qwen3.linear-residual-at :
  ([n.] {
    ({
      ({(cap.own mem) (cap.ref mem)} *)
      ({(cap.own mem) (u64 val)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [input-and-weight residual-and-features.])
  ([.input-and-weight] *.elim [input linear-weight.])
  ([.residual-and-features] *.elim [residual input-features.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.flat-output-index hidden-size] u64.div [row.])
  ([.flat-output-index hidden-size] u64.rem [output-channel.])
  ({[.input] [.linear-weight]} *.intro [term-input-and-weight.])
  ({[.row] [.output-channel]} *.intro [row-and-output.])
  ({[.input-features] [.row-and-output]} *.intro [coordinates.])
  ({[.term-input-and-weight] [.coordinates]} *.intro [term-env.])
  ([.input-features] u64.name [input-feature-count.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.input-feature-count] :.param) name.qwen3.linear-residual-term-at)})
    [.input-feature-count]
  } reducec [projected.])
  ([.residual] mem.cast.f32 [residual-count residual-buffer.])
  ({[.residual-count] [.residual-buffer] [.flat-output-index]}
    qwen3.f32-buffer-at [residual-value.])
  ([.projected residual-value] f32.add [result.])
  [.result]
))

# Compute one matrix term for a residual projection using reduce-f32's output
# and reduction coordinates.
(def program qwen3.linear-residual-reduce-term-at :
  ([n k.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        ({(cap.own mem) (u64 val)} *)
      } *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env indices.])
  ([.env] *.elim [input-and-weight residual-and-features.])
  ([.input-and-weight] *.elim [input linear-weight.])
  ([.residual-and-features] *.elim [_residual input-features.])
  ([.indices] *.elim [output-index input-index.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.flat-output-index hidden-size] u64.div [row.])
  ([.flat-output-index hidden-size] u64.rem [output-channel.])
  ({[.input] [.linear-weight]} *.intro [term-input-and-weight.])
  ({[.row] [.output-channel]} *.intro [row-and-output.])
  ({[.input-features] [.row-and-output]} *.intro [coordinates.])
  ({[.term-input-and-weight] [.coordinates]} *.intro [term-env.])
  ({[.term-env] [.input-index]} qwen3.linear-residual-term-at)
))

# Add the residual only after the canonical pairwise projection reduction.
(def program qwen3.linear-residual-reduce-epilogue :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        ({(cap.own mem) (u64 val)} *)
      } *)
      ({([.n] ix val) (f32 val)} *)
    } *)
  })
  ->
  ([n.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env index-and-sum.])
  ([.env] *.elim [_input-and-weight residual-and-features.])
  ([.residual-and-features] *.elim [residual _input-features.])
  ([.index-and-sum] *.elim [output-index projected.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.residual] mem.cast.f32 [residual-count residual-buffer.])
  ({[.residual-count] [.residual-buffer] [.flat-output-index]}
    qwen3.f32-buffer-at [residual-value.])
  ([.projected residual-value] f32.add [result.])
  [.result]
))

# Materialize a 576-wide linear projection with fused residual addition.
(def program qwen3.linear-residual :
  {(cap.own mem) (cap.ref mem) (cap.own mem) (u64 val)}
  ->
  (cap.own mem)
= ([input linear-weight residual input-features.]
  ([.residual] mem.cast.f32 [output-count _residual-buffer.])
  ({[.input] [.linear-weight]} *.intro [input-and-weight.])
  ({[.residual] [.input-features]} *.intro [residual-and-features.])
  ({[.input-and-weight] [.residual-and-features]} *.intro [env.])
  ([.input-features] u64.name [input-feature-count.])
  {
    [.output-count]
    [.input-feature-count]
    [.env]
    ({
      ([.output-count] :.param)
      ([.input-feature-count] :.param)
    } name.qwen3.linear-residual-reduce-term-at)
    (([.output-count] :.param) name.qwen3.linear-residual-reduce-epilogue)
  } materializec.reduce-f32 [output.]
  ({[.output-count] [.output]} buf.to-mem)
))

# One input-channel term of the fused SwiGLU down projection.
(def program qwen3.mlp-down-term-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        (cap.ref mem)
      } *)
      ({(u64 val) (u64 val)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env input-index.]
  ([.env] *.elim [projection-inputs coordinates.])
  ([.projection-inputs] *.elim [gate-and-up down-weight.])
  ([.gate-and-up] *.elim [gate up.])
  ([.coordinates] *.elim [row output-channel.])
  ([.input-index] ix.to-u64 [input-channel.])
  (const.u64.0x0000000000000300 [intermediate-size.])
  ([.row intermediate-size] u64.mul [mlp-row-offset.])
  ([.mlp-row-offset input-channel] u64.add [mlp-index.])
  ([.output-channel intermediate-size] u64.mul [weight-row-offset.])
  ([.weight-row-offset input-channel] u64.add [weight-index.])
  ([.gate] mem.cast.f32 [gate-count gate-buffer.])
  ([.up] mem.cast.f32 [up-count up-buffer.])
  ([.down-weight] mem.cast.f32 [weight-count weight-buffer.])
  ({[.gate-count] [.gate-buffer] [.mlp-index]}
    qwen3.f32-buffer-at [gate-value.])
  ({[.up-count] [.up-buffer] [.mlp-index]}
    qwen3.f32-buffer-at [up-value.])
  ({[.weight-count] [.weight-buffer] [.weight-index]}
    qwen3.f32-buffer-at [weight-value.])
  ([.gate-value] qwen3.silu [activated-gate.])
  ([.activated-gate up-value] f32.mul [gated-value.])
  ([.gated-value weight-value] f32.mul [result.])
  [.result]
))

# Produce one fused SwiGLU down-projection output plus residual.
(def program qwen3.mlp-down-residual-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        ({(cap.ref mem) (cap.own mem)} *)
      } *)
      ([.n] ix val)
    })
  })
  ->
  ([n.] (f32 val))
= ([buffers output-index.]
