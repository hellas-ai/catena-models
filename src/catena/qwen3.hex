    [.cache-buffer]
    [.cache-count]
    [.output-count]
    [.history-count]
    [.inputs]
    ({
      ([.cache-count] :.param)
      ([.output-count] :.param)
      ([.history-count] :.param)
    } name.qwen3.cached-staged-context-reduce-term-at)
    ({
      ([.cache-count] :.param)
      ([.output-count] :.param)
    } name.qwen3.cached-staged-context-reduce-epilogue)
  } materializec.borrow-reduce-f32 [cache-after context.]
  {
    ({[.cache-count] [.cache-after]} buf.to-mem)
    ({[.output-count] [.context]} buf.to-mem)
  }
))

# Fused cached attention: each output producer computes its stable softmax and
# weighted V reduction directly, avoiding score/statistic allocations.
(def program qwen3.cached-attention-context-at :
  ([cache-count output-count.] {
    ({cap.ref [.cache-count] f32} buf val)
    ({
      ({
        ({({[.cache-count] u64} :) ({(cap.own mem) (cap.ref mem)} *)} *)
        ({({(u64 val) (u64 val)} *) ({(u64 val) (u64 val)} *)} *)
      } *)
      ([.output-count] ix val)
    } *)
  })
  ->
  ([cache-count output-count.] (f32 val))
= ([cache-buffer env.]
  ([.env] *.elim [inputs output-index.])
  ([.inputs] *.elim [buffer-inputs scalar-inputs.])
  ([.buffer-inputs] *.elim [cache-count-value query-and-rope.])
  ([.scalar-inputs] *.elim [sequence-and-capacity start-and-layer.])
  ([.sequence-and-capacity] *.elim [sequence token-capacity.])
  ([.start-and-layer] *.elim [start layer.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  (const.u64.0x0000000000000080 [head-dim.])
  ([.flat-output-index hidden-size] u64.div [query-position.])
  ([.flat-output-index hidden-size] u64.rem [hidden-channel.])
  ([.hidden-channel head-dim] u64.div [query-head.])
  ([.hidden-channel head-dim] u64.rem [head-channel.])
  ({[.cache-count-value] [.cache-buffer]} buf.to-mem [cache-memory.])
  ({[.cache-memory] [.query-and-rope]} *.intro [term-buffer-inputs.])
  ({[.sequence] [.token-capacity]} *.intro [term-sequence-and-capacity.])
  ({[.start] [.layer]} *.intro [term-start-and-layer.])
  ({[.term-sequence-and-capacity] [.term-start-and-layer]} *.intro [term-scalars.])
  ({[.term-buffer-inputs] [.term-scalars]} *.intro [base-inputs.])
  ({[.query-position] [.query-head]} *.intro [query-and-head.])
  ({[.base-inputs] [.query-and-head]} *.intro [score-inputs.])
  (const.u64.0x0000000000000001 [one.])
  ([.start query-position] u64.add [absolute-query-position.])
  ([.absolute-query-position one] u64.add [causal-count-value.])
  ([.causal-count-value] u64.name [causal-count.])
  ({
    (const.u32.0xFF800000 u32.bitcast-f32)
    unit.intro
    name.f32.max-env
    ({[.score-inputs] (([.causal-count] :.param) name.qwen3.cached2-score-for-key-at)})
    [.causal-count]
  } reducec [row-max.])
  ({[.score-inputs] [.row-max]} *.intro [exp-inputs.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.exp-inputs] (([.causal-count] :.param) name.qwen3.cached2-exp-for-key-at)})
    [.causal-count]
  } reducec [denominator.])
  ({[.row-max] [.denominator]} *.intro [max-and-denominator.])
  ({[.score-inputs] [.max-and-denominator]} *.intro [probability-inputs.])
  ({[.probability-inputs] [.head-channel]} *.intro [value-inputs.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.value-inputs] (([.causal-count] :.param) name.qwen3.cached2-value-for-key-at)})
    [.causal-count]
  } reducec [result.])
  [.result]
))

(def program qwen3.cached-attention :
  {
    (cap.own mem)
    (cap.own mem)
    (cap.ref mem)
    (u64 val)
    (u64 val)
    (u64 val)
    (u64 val)
  }
  ->
  {(cap.own mem) (cap.own mem)}
= ([cache query rope sequence token-capacity start layer.]
  ({[.cache] [.query] [.rope] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cached-staged-scores [cache-after-scores scores.])
  ([.start sequence] u64.add [history.])
  ({[.scores] [.history]}
    qwen3.cached-staged-softmax [probabilities.])
  ({[.cache-after-scores] [.probabilities] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cached-staged-context [cache-after-context context.])
  ({[.probabilities] [.context]}
    qwen3.free-f32-before [context-after-probabilities.])
  {
    [.cache-after-context]
    [.context-after-probabilities]
  }
))

# Count how many router logits sort ahead of one candidate. Ties use the lower
# expert index, matching the stable top-k behavior used by Transformers.
(def program qwen3.router-rank-term-at :
  ([n.] {
    ({
      ({(cap.own mem) (u64 val)} *)
      ({(u64 val) (f32 val)} *)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env rival-index.]
  ([.env] *.elim [router-and-row candidate-and-logit.])
  ([.router-and-row] *.elim [router row.])
  ([.candidate-and-logit] *.elim [candidate candidate-logit.])
  ([.rival-index] ix.to-u64 [rival.])
  (const.u64.0x0000000000000080 [expert-count.])
  ([.row expert-count] u64.mul [router-row-base.])
  ([.router-row-base rival] u64.add [rival-flat-index.])
  ([.router] mem.cast.f32 [router-count router-buffer.])
  ({[.router-count] [.router-buffer] [.rival-flat-index]}
    qwen3.f32-buffer-at [rival-logit.])
  ([.rival-logit candidate-logit] f32.gt [is-greater.])
  ([.rival-logit candidate-logit] f32.eq [is-equal.])
  ([.rival candidate] u64.lt [is-lower-index.])
  ([.is-equal is-lower-index] bool.and [wins-tie.])
  ([.is-greater wins-tie] bool.or [ranks-ahead.])
  (f32.one [one.])
  (const.u32.0x00000000 u32.bitcast-f32 [zero.])
  ([.ranks-ahead one zero] f32.select [result.])
  [.result]
))

# Produce (expert ID, eligible logit) for one candidate and requested top-k
# slot. Only the candidate with exactly that rank keeps its logit.
(def program qwen3.router-ranked-pair-at :
  ([n.] {
    ({({(cap.own mem) (u64 val)} *) (u64 val)} *)
    ([.n] ix val)
  })
  ->
  ([n.] ({(u64 val) (f32 val)} *))
= ([env candidate-index.]
  ([.env] *.elim [router-and-row slot.])
  ([.router-and-row] *.elim [router row.])
  ([.candidate-index] ix.to-u64 [candidate.])
  (const.u64.0x0000000000000080 [expert-count-value.])
  ([.row expert-count-value] u64.mul [router-row-base.])
  ([.router-row-base candidate] u64.add [candidate-flat-index.])
  ([.router] mem.cast.f32 [router-count router-buffer.])
  ({[.router-count] [.router-buffer] [.candidate-flat-index]}
    qwen3.f32-buffer-at [candidate-logit.])
  ({[.router] [.row]} *.intro [rank-router-and-row.])
  ({[.candidate] [.candidate-logit]} *.intro [candidate-and-logit.])
  ({[.rank-router-and-row] [.candidate-and-logit]} *.intro [rank-env.])
  ([.expert-count-value] u64.name [expert-count.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.rank-env] (([.expert-count] :.param) name.qwen3.router-rank-term-at)})
    [.expert-count]
  } reducec [rank.])
  ([.slot] u64.to-f32 [slot-f32.])
  ([.rank slot-f32] f32.eq [is-selected.])
  (const.u32.0xFF800000 u32.bitcast-f32 [negative-infinity.])
  ([.is-selected candidate-logit negative-infinity] f32.select [eligible-logit.])
  ({[.candidate] [.eligible-logit]} *.intro [result.])
  [.result]
))

# Select one expert ID for each [row, top-8 slot] entirely on device.
(def program qwen3.router-selected-expert-at :
  ([n.] {(cap.own mem) ([.n] ix val)})
  ->
  ([n.] (u64 val))
= ([router output-index.]
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000008 [experts-per-token.])
  ([.flat-output-index experts-per-token] u64.div [row.])
  ([.flat-output-index experts-per-token] u64.rem [slot.])
  ({[.router] [.row]} *.intro [router-and-row.])
  ({[.router-and-row] [.slot]} *.intro [ranked-env.])
  (const.u64.0x0000000000000080 [expert-count-value.])
  ([.expert-count-value] u64.name [expert-count.])
  (const.u64.0x0000000000000000 [zero-id.])
  (const.u32.0xFF800000 u32.bitcast-f32 [negative-infinity.])
  ({[.zero-id] [.negative-infinity]} *.intro [initial.])
  ({
    [.initial]
    unit.intro
    name.tensor.argmax-env
    ({[.ranked-env] (([.expert-count] :.param) name.qwen3.router-ranked-pair-at)})
    [.expert-count]
  } reducec [selected.])
  ([.selected] *.elim [expert _logit.])
  [.expert]
))

(def program qwen3.router-select-experts :
  (cap.own mem)
  ->
  {(cap.own mem) (cap.own mem)}
= ([router.]
  ([.router] mem.cast.f32 [router-count router-buffer.])
  ([.router-count] :.forget [router-count-value.])
  (const.u64.0x0000000000000080 [expert-count.])
  (const.u64.0x0000000000000008 [experts-per-token.])
  ([.router-count-value expert-count] u64.div [row-count.])
  ([.row-count experts-per-token] u64.mul [output-count-value.])
  ([.row-count] u64.name [row-count-named.])
  ([.output-count-value] u64.name [output-count.])
  {
    [.router-buffer]
    [.router-count]
    [.row-count-named]
    [.output-count]
    [.expert-count]
    [.experts-per-token]
  } materializec.borrow-topk-f32 [router-after selected-experts.]
  {
    ({[.router-count] [.router-after]} buf.to-mem)
    ({[.output-count] [.selected-experts]} buf.to-mem)
  }
))

# Load one selected router logit using a U64 expert-ID buffer.
(def program qwen3.selected-router-logit :
  {({(cap.own mem) (cap.own mem)} *) (u64 val) (u64 val)}
  ->
  (f32 val)
= ([router-and-experts row slot.]
  ([.router-and-experts] *.elim [router selected-experts.])
  (const.u64.0x0000000000000008 [experts-per-token.])
  (const.u64.0x0000000000000080 [expert-count.])
  ([.row experts-per-token] u64.mul [selected-row-base.])
  ([.selected-row-base slot] u64.add [selected-flat-index.])
  ([.selected-experts] mem.cast.u64 [selected-count selected-buffer.])
  ({[.selected-count] [.selected-buffer] [.selected-flat-index]}
    qwen3.u64-buffer-at [expert.])
  ([.row expert-count] u64.mul [router-row-base.])
  ([.router-row-base expert] u64.add [router-flat-index.])
  ([.router] mem.cast.f32 [router-count router-buffer.])
  ({[.router-count] [.router-buffer] [.router-flat-index]}
    qwen3.f32-buffer-at [result.])
  [.result]
))

(def program qwen3.selected-router-logit-at :
  ([n.] {
    ({({(cap.own mem) (cap.own mem)} *) (u64 val)} *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env selected-index.]
  ([.env] *.elim [router-and-experts row.])
  ([.selected-index] ix.to-u64 [slot.])
  ({[.router-and-experts] [.row] [.slot]}
    qwen3.selected-router-logit [result.])
  [.result]
))

(def program qwen3.selected-router-exp-at :
  ([n.] {
    ({({({(cap.own mem) (cap.own mem)} *) (u64 val)} *) (f32 val)} *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env selected-index.]
  ([.env] *.elim [logit-env maximum.])
  ({[.logit-env] [.selected-index]} qwen3.selected-router-logit-at [logit.])
  ([.logit maximum] f32.sub [shifted.])
  ([.shifted] qwen3.exp [result.])
  [.result]
))

# Compute normalized top-8 routing weights. The full 128-way softmax cancels
# algebraically when Qwen renormalizes the selected probabilities.
(def program qwen3.routing-weight-at :
  ([n.] {({(cap.own mem) (cap.own mem)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([router-and-experts output-index.]
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000008 [experts-per-token-value.])
  ([.flat-output-index experts-per-token-value] u64.div [row.])
  ([.flat-output-index experts-per-token-value] u64.rem [slot.])
  ({[.router-and-experts] [.row]} *.intro [logit-env.])
  ([.experts-per-token-value] u64.name [experts-per-token.])
  ({
    (const.u32.0xFF800000 u32.bitcast-f32)
    unit.intro
    name.f32.max-env
    ({[.logit-env] (([.experts-per-token] :.param) name.qwen3.selected-router-logit-at)})
    [.experts-per-token]
  } reducec [maximum.])
  ({[.logit-env] [.maximum]} *.intro [exp-env.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.exp-env] (([.experts-per-token] :.param) name.qwen3.selected-router-exp-at)})
    [.experts-per-token]
  } reducec [denominator.])
  ({[.router-and-experts] [.row] [.slot]}
    qwen3.selected-router-logit [selected-logit.])
  ([.selected-logit maximum] f32.sub [shifted.])
  ([.shifted] qwen3.exp [numerator.])
  ([.numerator denominator] f32.div [result.])
  [.result]
))

(def program qwen3.routing-weights :
  {(cap.own mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([router selected-experts.]
  ([.selected-experts] mem.cast.u64 [output-count _selected-buffer.])
  ({[.router] [.selected-experts]} *.intro [env.])
  {
    [.output-count]
    ({[.output-count] [.env] (([.output-count] :.param) name.qwen3.routing-weight-at)}
      materializec)
  } buf.to-mem
))

# One pair of terms from an active expert's gate and up projections. Shared
# index arithmetic and the input/router loads are evaluated only once.
(def program qwen3.expert-linear-pair-term-at :
  ([n k.] {
    ({
      ({({(cap.own mem) ({(cap.ref mem) (cap.ref mem)} *)} *) (cap.own mem)} *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] ({(f32 val) (f32 val)} *))
= ([arguments.]
  ([.arguments] *.elim [env indices.])
  ([.env] *.elim [input-and-weights selected-experts.])
  ([.input-and-weights] *.elim [input expert-weights.])
  ([.expert-weights] *.elim [gate-weight up-weight.])
  ([.indices] *.elim [output-index input-index.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.input-index] ix.to-u64 [input-channel.])
  (const.u64.0x0000000000001800 [active-intermediate-row.])
  (const.u64.0x0000000000000300 [intermediate-size.])
  (const.u64.0x0000000000000008 [experts-per-token.])
  (const.u64.0x0000000000000800 [hidden-size.])
  (const.u64.0x0000000000180000 [expert-stride.])
  ([.flat-output-index active-intermediate-row] u64.div [row.])
  ([.flat-output-index active-intermediate-row] u64.rem [row-element.])
  ([.row-element intermediate-size] u64.div [slot.])
  ([.row-element intermediate-size] u64.rem [intermediate-channel.])
  ([.row experts-per-token] u64.mul [selected-row-base.])
  ([.selected-row-base slot] u64.add [selected-index.])
  ([.selected-experts] mem.cast.u64 [selected-count selected-buffer.])
  ({[.selected-count] [.selected-buffer] [.selected-index]}
    qwen3.u64-buffer-at [expert.])
  ([.row hidden-size] u64.mul [input-row-base.])
  ([.input-row-base input-channel] u64.add [input-flat-index.])
  ([.expert expert-stride] u64.mul [expert-base.])
  ([.intermediate-channel hidden-size] u64.mul [weight-row-base.])
  ([.expert-base weight-row-base] u64.add [expert-row-base.])
  ([.expert-row-base input-channel] u64.add [weight-index.])
  ([.input] mem.cast.f32 [input-count input-buffer.])
  ({[.input-count] [.input-buffer] [.input-flat-index]}
    qwen3.f32-buffer-at [input-value.])
  ([.gate-weight] mem.cast.bf16 [gate-weight-count gate-weight-buffer.])
  ({[.gate-weight-count] [.gate-weight-buffer] [.weight-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [gate-weight-value.])
  ([.up-weight] mem.cast.bf16 [up-weight-count up-weight-buffer.])
  ({[.up-weight-count] [.up-weight-buffer] [.weight-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [up-weight-value.])
  ([.input-value gate-weight-value] f32.mul [gate-result.])
  ([.input-value up-weight-value] f32.mul [up-result.])
  ({[.gate-result] [.up-result]} *.intro)
))

(def program qwen3.expert-linear-pair-epilogue :
  ([n.] {
    ({
      ({({(cap.own mem) ({(cap.ref mem) (cap.ref mem)} *)} *) (cap.own mem)} *)
      ({([.n] ix val) ({(f32 val) (f32 val)} *)} *)
    } *)
  })
  ->
  ([n.] ({(f32 val) (f32 val)} *))
= ([arguments.]
  ([.arguments] *.elim [_env index-and-sums.])
  ([.index-and-sums] *.elim [_index sums.])
  [.sums]
))

(def program qwen3.expert-linear-pair :
  {(cap.own mem) (cap.ref mem) (cap.ref mem) (cap.own mem)}
  ->
  {(cap.own mem) (cap.own mem) (cap.own mem) (cap.own mem)}
= ([input gate-weight up-weight selected-experts.]
  ([.input] mem.cast.f32 [input-count input-buffer.])
  ([.gate-weight] mem.cast.bf16 [gate-count gate-buffer.])
  ([.up-weight] mem.cast.bf16 [up-count up-buffer.])
  ([.selected-experts] mem.cast.u64 [selected-count selected-buffer.])
  ([.input-count] :.forget [input-count-value.])
  (const.u64.0x0000000000000800 [hidden-size-value.])
  (const.u64.0x0000000000001800 [active-intermediate-row.])
  (const.u64.0x0000000000000300 [intermediate-size.])
  (const.u64.0x0000000000000008 [experts-per-token.])
  ([.input-count-value hidden-size-value] u64.div [row-count.])
  ([.row-count active-intermediate-row] u64.mul [output-count-value.])
  ([.output-count-value] u64.name [output-count.])
  ([.hidden-size-value] u64.name [hidden-size.])
  {
    [.input-buffer]
    [.input-count]
    [.gate-buffer]
    [.gate-count]
    [.up-buffer]
    [.up-count]
    [.selected-buffer]
    [.selected-count]
    [.output-count]
    [.hidden-size]
    [.experts-per-token]
    [.intermediate-size]
  } materializec.borrow-routed-bf16-gemv-pair
    [input-after selected-after gate up.]
  {
    ({[.input-count] [.input-after]} buf.to-mem)
    ({[.selected-count] [.selected-after]} buf.to-mem)
    ({[.output-count] [.gate]} buf.to-mem)
    ({[.output-count] [.up]} buf.to-mem)
  }
))

# Activate and route each selected expert intermediate exactly once. Keeping
# SiLU outside the 2048-output down projection avoids recomputing the expensive
# exponential 2048 times for every active intermediate.
(def program qwen3.moe-activate-at :
  ([n.] {
    ({({(cap.own mem) (cap.own mem)} *) (cap.own mem)} *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env output-index.]
  ([.env] *.elim [gate-and-up routing-weights.])
  ([.gate-and-up] *.elim [gate up.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000001800 [active-intermediate-row.])
  (const.u64.0x0000000000000300 [intermediate-size.])
  (const.u64.0x0000000000000008 [experts-per-token.])
  ([.flat-output-index active-intermediate-row] u64.div [row.])
  ([.flat-output-index active-intermediate-row] u64.rem [row-element.])
  ([.row-element intermediate-size] u64.div [slot.])
  ([.row experts-per-token] u64.mul [routing-row-base.])
  ([.routing-row-base slot] u64.add [routing-index.])
  ([.gate] mem.cast.f32 [gate-count gate-buffer.])
  ({[.gate-count] [.gate-buffer] [.flat-output-index]}
    qwen3.f32-buffer-at [gate-value.])
  ([.up] mem.cast.f32 [up-count up-buffer.])
  ({[.up-count] [.up-buffer] [.flat-output-index]}
    qwen3.f32-buffer-at [up-value.])
  ([.routing-weights] mem.cast.f32 [routing-count routing-buffer.])
  ({[.routing-count] [.routing-buffer] [.routing-index]}
    qwen3.f32-buffer-at [routing-weight.])
  ([.gate-value] qwen3.silu [activated-gate.])
  ([.activated-gate up-value] f32.mul [expert-hidden.])
  ([.expert-hidden routing-weight] f32.mul [result.])
  [.result]
))

(def program qwen3.moe-activate :
  {(cap.own mem) (cap.own mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([gate up routing-weights.]
  ([.gate] mem.cast.f32 [output-count _gate-buffer.])
  ({[.gate] [.up]} *.intro [gate-and-up.])
  ({[.gate-and-up] [.routing-weights]} *.intro [env.])
  {
    [.output-count]
    ({[.output-count] [.env] (([.output-count] :.param) name.qwen3.moe-activate-at)}
      materializec)
  } buf.to-mem
))

# One down-projection term over the 6144 already activated-and-routed values.
(def program qwen3.moe-down-term-at :
  ([active-count output-count k.] {
    ({cap.ref [.active-count] f32} buf val)
    ({
      ({({[.active-count] u64} :) ({(cap.ref mem) (cap.own mem)} *)} *)
      (cap.own mem)
    } *)
    ({([.output-count] ix val) ([.k] ix val)} *)
  })
  ->
  ([active-count output-count k.] (f32 val))
= ([active-buffer env indices.]
  ([.env] *.elim [active-count-and-weights _residual.])
  ([.active-count-and-weights] *.elim [active-count-value down-and-experts.])
  ([.down-and-experts] *.elim [down-weight selected-experts.])
  ([.indices] *.elim [output-index reduction-index.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.reduction-index] ix.to-u64 [flat-reduction-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  (const.u64.0x0000000000000300 [intermediate-size.])
  (const.u64.0x0000000000000008 [experts-per-token.])
  (const.u64.0x0000000000001800 [active-intermediate-row.])
  (const.u64.0x0000000000180000 [down-expert-stride.])
  ([.flat-output-index hidden-size] u64.div [row.])
  ([.flat-output-index hidden-size] u64.rem [output-channel.])
  ([.flat-reduction-index intermediate-size] u64.div [slot.])
  ([.flat-reduction-index intermediate-size] u64.rem [intermediate-channel.])
  ([.row active-intermediate-row] u64.mul [active-row-base.])
  ([.active-row-base flat-reduction-index] u64.add [active-index.])
  ({[.active-count-value] [.active-buffer] [.active-index]}
    qwen3.f32-buffer-at [active-value.])
  ([.row experts-per-token] u64.mul [selected-row-base.])
  ([.selected-row-base slot] u64.add [selected-index.])
  ([.selected-experts] mem.cast.u64 [selected-count selected-buffer.])
  ({[.selected-count] [.selected-buffer] [.selected-index]}
    qwen3.u64-buffer-at [expert.])
  ([.expert down-expert-stride] u64.mul [expert-base.])
  ([.output-channel intermediate-size] u64.mul [down-row-base.])
  ([.expert-base down-row-base] u64.add [expert-row-base.])
  ([.expert-row-base intermediate-channel] u64.add [down-index.])
  ([.down-weight] mem.cast.bf16 [down-count down-buffer.])
  ({[.down-count] [.down-buffer] [.down-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [down-value.])
  ([.active-value down-value] f32.mul [result.])
  [.result]
))

(def program qwen3.moe-down-epilogue :
  ([active-count output-count.] {
    ({cap.ref [.active-count] f32} buf val)
    ({
      ({({[.active-count] u64} :) ({(cap.ref mem) (cap.own mem)} *)} *)
      (cap.own mem)
    } *)
    ({([.output-count] ix val) (f32 val)} *)
  })
  ->
  ([active-count output-count.] (f32 val))
= ([_active-buffer env index-and-sum.]
  ([.env] *.elim [_active-count-and-weights residual.])
  ([.index-and-sum] *.elim [output-index projected.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.residual] mem.cast.f32 [residual-count residual-buffer.])
  ({[.residual-count] [.residual-buffer] [.flat-output-index]}
    qwen3.f32-buffer-at [residual-value.])
  ([.projected residual-value] f32.add [result.])
  [.result]
))

(def program qwen3.moe-down-residual :
  {(cap.own mem) (cap.ref mem) (cap.own mem) (cap.own mem)}
  ->
  {(cap.own mem) (cap.own mem)}
= ([activated down-weight selected-experts residual.]
  ([.activated] mem.cast.f32 [active-count active-buffer.])
  ([.residual] mem.cast.f32 [output-count _residual-buffer.])
  ({[.down-weight] [.selected-experts]} *.intro [down-and-experts.])
  ({[.active-count] [.down-and-experts]} *.intro [active-count-and-weights.])
  ({[.active-count-and-weights] [.residual]} *.intro [env.])
  (const.u64.0x0000000000001800 [active-intermediate-value.])
  ([.active-intermediate-value] u64.name [active-intermediate.])
  {
    [.active-buffer]
    [.active-count]
    [.output-count]
    [.active-intermediate]
    [.env]
    ({
      ([.active-count] :.param)
      ([.output-count] :.param)
      ([.active-intermediate] :.param)
    } name.qwen3.moe-down-term-at)
    ({
      ([.active-count] :.param)
      ([.output-count] :.param)
    } name.qwen3.moe-down-epilogue)
  } materializec.borrow-reduce-f32 [activated-after output.]
  {
    ({[.active-count] [.activated-after]} buf.to-mem)
    ({[.output-count] [.output]} buf.to-mem)
  }
))

# One complete pre-norm Qwen3 decoder layer. All dense and reduction work is
# inside the materializations above; this definition only sequences kernels and
# releases owned intermediates after their final consumer has synchronized.
(def program qwen3.decoder-layer :
  {
    (cap.own mem)
    (cap.ref mem)
    (u64 val)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
  }
  ->
  (cap.own mem)
= ([hidden rope sequence input-norm q-weight k-weight v-weight o-weight post-norm gate-weight up-weight down-weight.]
  ([.hidden] qwen3.rms-inv [attention-inverse.])
  (const.u64.0x0000000000000800 [query-features.])
  (const.u64.0x0000000000000200 [key-value-features.])
  ({[.hidden] [.input-norm] [.q-weight] [.attention-inverse] [.query-features]}
    qwen3.linear-norm [query.])
  ({[.hidden] [.input-norm] [.k-weight] [.attention-inverse] [.key-value-features]}
    qwen3.linear-norm [key.])
  ({[.hidden] [.input-norm] [.v-weight] [.attention-inverse] [.key-value-features]}
    qwen3.linear-norm [value.])
  ({[.query] [.key] [.value] [.rope] [.sequence]}
    qwen3.attention [context.])
  ({[.attention-inverse] [.context]}
    qwen3.free-f32-before [context-after-attention-inverse.])
  ({[.query] [.context-after-attention-inverse]}
    qwen3.free-f32-before [context-after-query.])
  ({[.key] [.context-after-query]}
    qwen3.free-f32-before [context-after-key.])
  ({[.value] [.context-after-key]}
    qwen3.free-f32-before [context-after-value.])
  (const.u64.0x0000000000000800 [attention-input-features.])
  ({[.context-after-value] [.o-weight] [.hidden] [.attention-input-features]}
    qwen3.linear-residual [attention-hidden.])
  ({[.context-after-value] [.attention-hidden]}
    qwen3.free-f32-before [attention-hidden-after-context.])
  ({[.hidden] [.attention-hidden-after-context]}
    qwen3.free-f32-before [attention-hidden-after-residual.])
  ([.attention-hidden-after-residual] qwen3.rms-inv [mlp-inverse.])
  (const.u64.0x0000000000000300 [intermediate-features.])
  ({[.attention-hidden-after-residual] [.post-norm] [.gate-weight] [.mlp-inverse] [.intermediate-features]}
    qwen3.linear-norm [gate.])
  ({[.attention-hidden-after-residual] [.post-norm] [.up-weight] [.mlp-inverse] [.intermediate-features]}
    qwen3.linear-norm [up.])
  ({[.gate] [.up] [.down-weight] [.attention-hidden-after-residual]}
    qwen3.mlp-down-residual [output.])
  ({[.mlp-inverse] [.output]}
    qwen3.free-f32-before [output-after-mlp-inverse.])
  ({[.gate] [.output-after-mlp-inverse]}
    qwen3.free-f32-before [output-after-gate.])
  ({[.up] [.output-after-gate]}
    qwen3.free-f32-before [output-after-up.])
  ({[.attention-hidden-after-residual] [.output-after-up]}
    qwen3.free-f32-before [output-after-residual.])
  [.output-after-residual]
))

# Decoder layer for both prefill and decode. New K/V rows are appended to the
# owned persistent cache before the fused attention producer borrows it.
(def program qwen3.cached-decoder-layer :
  {
    (cap.own mem)
    (cap.ref mem)
    (u64 val)
    (cap.own mem)
    (u64 val)
    (u64 val)
    (u64 val)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.ref mem)
  }
  ->
  {(cap.own mem) (cap.own mem)}
= ([hidden rope sequence cache token-capacity start layer input-norm q-weight k-weight v-weight o-weight q-norm k-norm post-norm router-weight expert-gate-weight expert-up-weight expert-down-weight.]
  ([.hidden] qwen3.rms-inv [attention-inverse.])
  (const.u64.0x0000000000001000 [query-features.])
  (const.u64.0x0000000000000200 [key-value-features.])
  ({[.hidden] [.input-norm] [.q-weight] [.attention-inverse] [.query-features]}
    qwen3.linear-norm [query-raw.])
  ({[.hidden] [.input-norm] [.k-weight] [.attention-inverse] [.key-value-features]}
    qwen3.linear-norm [key-raw.])
  ({[.hidden] [.input-norm] [.v-weight] [.attention-inverse] [.key-value-features]}
    qwen3.linear-norm [value.])
  ({[.query-raw] [.q-norm]} qwen3.head-rmsnorm [query.])
  ({[.key-raw] [.k-norm]} qwen3.head-rmsnorm [key.])
  ({[.cache] [.key] [.rope] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cache-append-key [cache-with-key.])
  ({[.key] [.cache-with-key]}
    qwen3.free-f32-before [cache-after-key.])
  ({[.cache-after-key] [.value] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cache-append-value [cache-with-value.])
  ({[.value] [.cache-with-value]}
    qwen3.free-f32-before [cache-after-value.])
  ({[.cache-after-value] [.query] [.rope] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cached-attention [cache-after-attention context.])
  ({[.attention-inverse] [.context]}
    qwen3.free-f32-before [context-after-attention-inverse.])
  ({[.query] [.context-after-attention-inverse]}
    qwen3.free-f32-before [context-after-query.])
  (const.u64.0x0000000000001000 [attention-input-features.])
  ({[.context-after-query] [.o-weight] [.hidden] [.attention-input-features]}
    qwen3.linear-residual [attention-hidden.])
  ({[.context-after-query] [.attention-hidden]}
    qwen3.free-f32-before [attention-hidden-after-context.])
  ({[.hidden] [.attention-hidden-after-context]}
    qwen3.free-f32-before [attention-hidden-after-residual.])
  ([.attention-hidden-after-residual] qwen3.rms-inv [mlp-inverse.])
  ({[.attention-hidden-after-residual] [.post-norm] [.mlp-inverse]}
    qwen3.apply-rmsnorm [normalized-mlp-input.])
  (const.u64.0x0000000000000080 [router-features.])
  ({[.normalized-mlp-input] [.router-weight] [.router-features]}
    qwen3.linear [router-logits.])
  ([.router-logits] qwen3.router-select-experts [router-logits-after-select selected-experts.])
  ({[.router-logits-after-select] [.selected-experts]}
    qwen3.routing-weights [routing-weights.])
  ({
    [.normalized-mlp-input]
    [.expert-gate-weight]
    [.expert-up-weight]
    [.selected-experts]
  } qwen3.expert-linear-pair
    [normalized-mlp-input-after-expert selected-experts-after-expert expert-gate expert-up.])
  ({[.expert-gate] [.expert-up] [.routing-weights]}
    qwen3.moe-activate [expert-activated.])
  ({[.expert-activated] [.expert-down-weight] [.selected-experts-after-expert] [.attention-hidden-after-residual]}
    qwen3.moe-down-residual [expert-activated-after output.])
  ({[.mlp-inverse] [.output]}
    qwen3.free-f32-before [output-after-mlp-inverse.])
  ({[.normalized-mlp-input-after-expert] [.output-after-mlp-inverse]}
    qwen3.free-f32-before [output-after-normalized.])
  ({[.router-logits-after-select] [.output-after-normalized]}
    qwen3.free-f32-before [output-after-router.])
  ({[.expert-gate] [.output-after-router]}
    qwen3.free-f32-before [output-after-gate.])
  ({[.expert-up] [.output-after-gate]}
    qwen3.free-f32-before [output-after-up.])
  ({[.expert-activated-after] [.output-after-up]}
    qwen3.free-f32-before [output-after-activated.])
  ({[.routing-weights] [.output-after-activated]}
    qwen3.free-f32-before [output-after-routing.])
  ({[.selected-experts-after-expert] [.output-after-routing]}
    qwen3.free-u64-before [output-after-experts.])
  ({[.attention-hidden-after-residual] [.output-after-experts]}
    qwen3.free-f32-before [output-after-residual.])
  {[.output-after-residual] [.cache-after-attention]}
))

# Produce one vocabulary logit from the final sequence row.
(def program qwen3.final-logit-at :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        ({(cap.ref mem) (cap.own mem)} *)
      } *)
      (u64 val)
    } *)
    ([.n] ix val)
  })
  ->
  ([n.] (f32 val))
= ([env vocabulary-index.]
  ([.env] *.elim [projection-inputs sequence.])
  ([.projection-inputs] *.elim [hidden-and-norm embedding-and-inverse.])
  ([.hidden-and-norm] *.elim [hidden norm-weight.])
  ([.embedding-and-inverse] *.elim [embedding inverse-buffer.])
  ([.vocabulary-index] ix.to-u64 [vocabulary-channel.])
  (const.u64.0x0000000000000001 [one.])
  ([.sequence one] u64.sub [last-row.])
  ([.inverse-buffer] mem.cast.f32 [inverse-count inverse-values.])
  ({[.inverse-count] [.inverse-values] [.last-row]}
    qwen3.f32-buffer-at [inverse-rms.])
  ({[.hidden] [.norm-weight]} *.intro [hidden-and-norm-term.])
  ({[.embedding] [.inverse-rms]} *.intro [weight-and-inverse-term.])
  ({[.hidden-and-norm-term] [.weight-and-inverse-term]} *.intro [term-projection-inputs.])
  ({[.last-row] [.vocabulary-channel]} *.intro [coordinates.])
  ({[.term-projection-inputs] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000800 [hidden-size-value.])
  ([.hidden-size-value] u64.name [hidden-size.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.hidden-size] :.param) name.qwen3.linear-norm-term-at)})
    [.hidden-size]
  } reducec [result.])
  [.result]
))

# Compute one LM-head term for one vocabulary output and one hidden
# channel in the canonical reduce-f32 tree.
(def program qwen3.final-logit-reduce-term-at :
  ([n k.] {
    ({
      ({
        ({
          ({(cap.own mem) (cap.ref mem)} *)
          ({(cap.ref mem) (cap.own mem)} *)
        } *)
        (u64 val)
      } *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env indices.])
  ([.env] *.elim [projection-inputs sequence.])
  ([.projection-inputs] *.elim [hidden-and-norm embedding-and-inverse.])
  ([.hidden-and-norm] *.elim [hidden norm-weight.])
  ([.embedding-and-inverse] *.elim [embedding inverse-buffer.])
  ([.indices] *.elim [vocabulary-index input-channel-index.])
  ([.vocabulary-index] ix.to-u64 [vocabulary-channel.])
  (const.u64.0x0000000000000001 [one.])
  ([.sequence one] u64.sub [last-row.])
  ([.inverse-buffer] mem.cast.f32 [inverse-count inverse-values.])
  ({[.inverse-count] [.inverse-values] [.last-row]}
    qwen3.f32-buffer-at [inverse-rms.])
  ({[.hidden] [.norm-weight]} *.intro [hidden-and-norm-term.])
  ({[.embedding] [.inverse-rms]} *.intro [weight-and-inverse-term.])
  ({[.hidden-and-norm-term] [.weight-and-inverse-term]} *.intro [term-projection-inputs.])
  ({[.last-row] [.vocabulary-channel]} *.intro [coordinates.])
  ({[.term-projection-inputs] [.coordinates]} *.intro [term-env.])
  ({[.term-env] [.input-channel-index]} qwen3.linear-norm-term-at)
))

# One LM-head term from an already materialized learned-RMSNorm row.
(def program qwen3.final-normalized-logit-term-at :
  ([n k.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        (u64 val)
      } *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env indices.])
  ([.env] *.elim [normalized-and-embedding sequence.])
  ([.normalized-and-embedding] *.elim [normalized embedding.])
  ([.indices] *.elim [vocabulary-index channel-index.])
  ([.vocabulary-index] ix.to-u64 [vocabulary-channel.])
  ([.channel-index] ix.to-u64 [channel.])
  (const.u64.0x0000000000000001 [one.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.sequence one] u64.sub [last-row.])
  ([.last-row hidden-size] u64.mul [normalized-row-base.])
  ([.normalized-row-base channel] u64.add [normalized-index.])
  ([.vocabulary-channel hidden-size] u64.mul [weight-row-base.])
  ([.weight-row-base channel] u64.add [weight-index.])
  ([.normalized] mem.cast.f32 [normalized-count normalized-buffer.])
  ({[.normalized-count] [.normalized-buffer] [.normalized-index]}
    qwen3.f32-buffer-at [normalized-value.])
  ([.embedding] mem.cast.bf16 [weight-count weight-buffer.])
  ({[.weight-count] [.weight-buffer] [.weight-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [weight-value.])
  ([.normalized-value weight-value] f32.mul [result.])
  [.result]
))

(def program qwen3.final-normalized-logit-epilogue :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        (u64 val)
      } *)
      ({([.n] ix val) (f32 val)} *)
    } *)
  })
  ->
  ([n.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [_env index-and-sum.])
  ([.index-and-sum] *.elim [_index sum.])
  [.sum]
))

# Materialize final-row logits using Qwen's untied BF16 LM head.
(def program qwen3.final-logits :
  {
    (cap.own mem)
    (cap.ref mem)
    (cap.ref mem)
    (cap.own mem)
    (u64 val)
  }
  ->
  (cap.own mem)
= ([hidden norm-weight embedding inverse-rms sequence.]
  ({[.hidden] [.norm-weight] [.inverse-rms]}
    qwen3.apply-rmsnorm [normalized.])
  (const.u64.0x0000000000025180 [vocabulary-size-value.])
  ([.vocabulary-size-value] u64.name [vocabulary-size.])
  ({[.normalized] [.embedding]} *.intro [normalized-and-embedding.])
  ({[.normalized-and-embedding] [.sequence]} *.intro [env.])
  (const.u64.0x0000000000000800 [hidden-size-value.])
  ([.hidden-size-value] u64.name [hidden-size.])
  {
    [.vocabulary-size]
    [.hidden-size]
    [.env]
    ({
      ([.vocabulary-size] :.param)
      ([.hidden-size] :.param)
    } name.qwen3.final-normalized-logit-term-at)
    (([.vocabulary-size] :.param) name.qwen3.final-normalized-logit-epilogue)
  } materializec.reduce-f32 [logits-buffer.]
  ({[.vocabulary-size] [.logits-buffer]} buf.to-mem [logits.])
  ({[.normalized] [.logits]}
    qwen3.free-f32-before [logits-after-normalized.])
  [.logits-after-normalized]
))
