  ([.gate-and-up] *.elim [gate up.])
  ([.weight-and-residual] *.elim [down-weight residual.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.flat-output-index hidden-size] u64.div [row.])
  ([.flat-output-index hidden-size] u64.rem [output-channel.])
  ({[.gate] [.up]} *.intro [term-gate-and-up.])
  ({[.term-gate-and-up] [.down-weight]} *.intro [projection-inputs.])
  ({[.row] [.output-channel]} *.intro [coordinates.])
  ({[.projection-inputs] [.coordinates]} *.intro [term-env.])
  (const.u64.0x0000000000000300 [intermediate-size-value.])
  ([.intermediate-size-value] u64.name [intermediate-size.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro
    name.f32.add-env
    ({[.term-env] (([.intermediate-size] :.param) name.qwen3.mlp-down-term-at)})
    [.intermediate-size]
  } reducec [projected.])
  ([.residual] mem.cast.f32 [residual-count residual-buffer.])
  ({[.residual-count] [.residual-buffer] [.flat-output-index]}
    qwen3.f32-buffer-at [residual-value.])
  ([.projected residual-value] f32.add [result.])
  [.result]
))

# Compute one SwiGLU/down-projection term at reduce-f32's pair of logical
# coordinates.
(def program qwen3.mlp-down-reduce-term-at :
  ([n k.] {
    ({
      ({
        ({(cap.own mem) (cap.own mem)} *)
        ({(cap.ref mem) (cap.own mem)} *)
      } *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [buffers indices.])
  ([.buffers] *.elim [gate-and-up weight-and-residual.])
  ([.gate-and-up] *.elim [gate up.])
  ([.weight-and-residual] *.elim [down-weight _residual.])
  ([.indices] *.elim [output-index input-index.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x0000000000000800 [hidden-size.])
  ([.flat-output-index hidden-size] u64.div [row.])
  ([.flat-output-index hidden-size] u64.rem [output-channel.])
  ({[.gate] [.up]} *.intro [term-gate-and-up.])
  ({[.term-gate-and-up] [.down-weight]} *.intro [projection-inputs.])
  ({[.row] [.output-channel]} *.intro [coordinates.])
  ({[.projection-inputs] [.coordinates]} *.intro [term-env.])
  ({[.term-env] [.input-index]} qwen3.mlp-down-term-at)
))

# Add the decoder residual after the exactly specified projection tree.
(def program qwen3.mlp-down-reduce-epilogue :
  ([n.] {
    ({
