# Native Qwen3: explicit typed memory and guarded launches.
# A one-iteration host fold returns each launched buffer as loop state. This
# preserves an ordering edge after unit ports are erased by product unpacking.

(def program stdlib.qwen3.argmax-step : {((cap.own mem) val) ({(u64 val) ({(u64 val) (f32 val)} *)} *)} -> ({(u64 val) (f32 val)} *) =
 ([logits pair.]
  ([.pair] *.elim [i acc.])
  ([.acc] *.elim [token maximum.])
  ({[.logits] [.i]} stdlib.qwen3.memory.own-read-bf16 [bf.])
  ([.bf] bf16.to-f32 [value.])
  ({[.value] [.maximum]} stdlib.qwen3.memory.f32.greater [larger.])
  ({[.larger] [.i] [.token]} stdlib.qwen3.memory.select-u64 [next-token.])
  ({[.larger] [.value] [.maximum]} stdlib.qwen3.memory.select-f32 [next-max.])
  ({[.next-token] [.next-max]} *.intro)
 ))
(def program stdlib.qwen3.argmax-step.fold : {((cap.own mem) val) ({({master.index32 u32} :) ({({(u64 val) (f32 val)} *) ({(({master.index32 master.end32} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({({(u64 val) (f32 val)} *) (prop.Truth |-)} *) =
 ([logits pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ([.index] :.forget stdlib.qwen3.memory.u32.to-u64 [i.])
  ({[.i] [.value]} *.intro [arguments.])
  ({[.logits] [.arguments]} stdlib.qwen3.argmax-step [result.])
  ({[.result] [.truth]} *.intro)
 ))
(def program stdlib.qwen3.argmax : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val)} -> 1 =
 ([logits out vocabulary index.]
  ({[.logits]} partial.stdlib.qwen3.argmax-step.fold.1 [callback.])
  ([.vocabulary] stdlib.qwen3.memory.fold-count-u32 [fold-vocabulary.])
  ({[.fold-vocabulary] (unit.intro meta.master.end32)} smolcat.value.named_at [end.])
  ({[.end] ({(const.u64.0x0000000000000000) (const.u32.0xFF800000 u32.bitcast-f32)} *.intro) [.callback] core.truth} core.fold.bounded [ best proof.])
  ([.proof] unsafe.discard unit.elim)
  ([.best] *.elim [token maximum.])
  ({[.out] (const.u64.0x0000000000000000) [.token]} stdlib.qwen3.memory.write-u64)
  (unit.elim)
  (unit.intro)
 ))
(def program stdlib.qwen3.argmax.yes : {((cap.own mem) val) ((cap.own mem) val) (u64 val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([logits out vocabulary pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  ([.unit] unit.elim)
  ({[.logits] [.out] [.vocabulary] [.index]} stdlib.qwen3.argmax)

 ))
(def program stdlib.qwen3.argmax.no : {((cap.own mem) val) ((cap.own mem) val) (u64 val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([logits out vocabulary pair.]
  ([.pair] *.elim [index proofs.])
  ([.proofs] *.elim [proof unit.])
  ([.proof] unsafe.discard unit.elim)
  [.unit]
 ))
(def program stdlib.qwen3.argmax.launch : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val) ({({master.block ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid} stdlib.gpu.geometry.type.Block)} :) (({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid master.block} stdlib.gpu.geometry.type.Thread) val)} *)} -> 1 =
 ([logits out vocabulary count pair.]
  ([.pair] stdlib.qwen3.memory.thread-index [index.])
  ({[.index] [.count]} stdlib.qwen3.memory.u64.less [valid.])
  ({[.valid] (unit.intro meta.master.predicate)} smolcat.value.named_at :.forget [condition.])
  ({[.logits] [.out] [.vocabulary]} partial.stdlib.qwen3.argmax.yes.3 [yes.])
  ({[.logits] [.out] [.vocabulary]} partial.stdlib.qwen3.argmax.no.3 [no.])
  ({[.condition] [.index] [.yes] [.no] unit.intro} core.if)
 ))
(def program qwen3.argmax : {((cap.own mem) val)} -> ((cap.own mem) val) =
 ([logits.]
  ([.logits] stdlib.qwen3.memory.own-count-bf16 [count.])
  ({(const.u64.0x0000000000000001)} stdlib.qwen3.memory.alloc-u64 [out.])
  (const.u64.0x0000000000000001 [one.])
  ({[.one] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
  ({[.padded] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.div [blocks.])
  ([.blocks] stdlib.qwen3.memory.grid [grid.])
  ({[.logits] [.out] [.count] [.one] [.grid]} partial.stdlib.qwen3.argmax.host-step.5 [host-callback.])
  ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [host-end.])
  ({[.host-end] [.out] [.host-callback] core.truth} core.fold.bounded_u64 [complete proof.])
  ([.proof] unsafe.discard unit.elim)
  [.complete]
 ))

(def program stdlib.qwen3.argmax.host-step : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val) ({master.grid ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2)} stdlib.gpu.geometry.type.Grid)} :) ({({master.index u64} :) ({((cap.own mem) val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({((cap.own mem) val) (prop.Truth |-)} *) =
 ([logits out count one grid pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ({[.logits] [.out] [.count] [.one]} partial.stdlib.qwen3.argmax.launch.4 [kernel.])
  ({[.grid] [.kernel]} unsafe.launch unit.elim)
  ({[.value] [.truth]} *.intro)
 ))

