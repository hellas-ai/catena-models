 [.result]
 ))


(def program qwen3.copy-buffer : {((cap.ref mem) val) (u64 val)} -> ((cap.own mem) val) =
 ([input count.] ({[.input] [.count] [.count] [.count]} stdlib.models.session.copy-words.run)))

(def program qwen3.copy-buffer-16 : {((cap.ref mem) val) (u64 val)} -> ((cap.own mem) val) =
 ([input count.] ({[.input] [.count] [.count] [.count]} stdlib.models.session.copy-halves.run)))
