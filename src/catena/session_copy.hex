(def program stdlib.models.session.copy-halves.host : {((cap.ref mem) val) (u64 val) ((cap.own mem) val) (u64 val) ({master.grid ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2)} stdlib.gpu.geometry.type.Grid)} :) ({({master.index u64} :) ({((cap.own mem) val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({((cap.own mem) val) (prop.Truth |-)} *) =
 ([x count out work grid pair.]
 ([.pair] *.elim [step rest.])
 ([.rest] *.elim [value proofs.])
 ([.proofs] *.elim [less truth.])
 ([.less] unsafe.discard unit.elim)
 ({[.x] [.count] [.out] [.work]} partial.stdlib.models.session.copy-halves.launch.4 [kernel.])
