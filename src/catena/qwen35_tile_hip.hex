# Native HIP 16x16 BF16 tile. All 32 lanes must participate.
(def program stdlib.qwen35.tile.row : {(u64 val) (u64 val)} -> (u64 val) =
 ([tid j.]
  ({[.tid] (const.u64.0x0000000000000010)} stdlib.models.memory.u64.div [lane.])
  ({[.j] (const.u64.0x0000000000000002)} stdlib.models.memory.u64.mul [offset.])
  ({[.lane] [.offset]} stdlib.models.memory.u64.add [result.])
  [.result]
 ))
(def program stdlib.qwen35.tile.col : {(u64 val) (u64 val)} -> (u64 val) =
 ([tid j.]
  ({[.tid] (const.u64.0x0000000000000010)} stdlib.models.memory.u64.rem [lane.])
  ([.lane] [result.])
  [.result]
 ))
(def program stdlib.qwen35.tile.a-row : {(u64 val) (u64 val)} -> (u64 val) =
 ([tid j.]
  ({[.tid] (const.u64.0x0000000000000010)} stdlib.models.memory.u64.rem [result.])
  [.result]
 ))
(def program stdlib.qwen35.tile.a-k : {(u64 val) (u64 val) (u64 val)} -> (u64 val) =
 ([tid k j.]
  ({[.k] [.j]} stdlib.models.memory.u64.add [result.])
  [.result]
 ))
(def program stdlib.qwen35.tile.b-row : {(u64 val) (u64 val)} -> (u64 val) =
 ([tid j.]
  ({[.tid] (const.u64.0x0000000000000010)} stdlib.models.memory.u64.rem [result.])
  [.result]
 ))
(def program stdlib.qwen35.tile.b-k : {(u64 val) (u64 val) (u64 val)} -> (u64 val) =
 ([tid k j.]
  ({[.k] [.j]} stdlib.models.memory.u64.add [result.])
  [.result]
 ))
(def program stdlib.qwen35.tile.dot : {({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) (bf16x2 val)} *)} *)} *)} *)} *)} *)} *) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) (bf16x2 val)} *)} *)} *)} *)} *)} *)} *) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) (f32 val)} *)} *)} *)} *)} *)} *)} *)} -> ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) (f32 val)} *)} *)} *)} *)} *)} *)} *) =
 ([a b acc.]
  ([.a] *.elim [a0 atail0.])
  ([.atail0] *.elim [a1 atail1.])
  ([.atail1] *.elim [a2 atail2.])
  ([.atail2] *.elim [a3 atail3.])
  ([.atail3] *.elim [a4 atail4.])
  ([.atail4] *.elim [a5 atail5.])
  ([.atail5] *.elim [a6 a7.])
  ([.b] *.elim [b0 btail0.])
  ([.btail0] *.elim [b1 btail1.])
  ([.btail1] *.elim [b2 btail2.])
  ([.btail2] *.elim [b3 btail3.])
  ([.btail3] *.elim [b4 btail4.])
  ([.btail4] *.elim [b5 btail5.])
  ([.btail5] *.elim [b6 b7.])
  ([.acc] *.elim [c0 ctail0.])
  ([.ctail0] *.elim [c1 ctail1.])
  ([.ctail1] *.elim [c2 ctail2.])
  ([.ctail2] *.elim [c3 ctail3.])
  ([.ctail3] *.elim [c4 ctail4.])
  ([.ctail4] *.elim [c5 ctail5.])
  ([.ctail5] *.elim [c6 c7.])
  ({[.a0] [.a1] [.a2] [.a3] [.a4] [.a5] [.a6] [.a7]} wmma.bf16x16.pack [af.])
  ({[.b0] [.b1] [.b2] [.b3] [.b4] [.b5] [.b6] [.b7]} wmma.bf16x16.pack [bf.])
  ({[.c0] [.c1] [.c2] [.c3] [.c4] [.c5] [.c6] [.c7]} wmma.f32x8.pack [cf.])
  ({[.af] [.bf] [.cf]} wmma.mma-bf16-f32 [df.])
  ({[.df] (const.u32.0x00000000)} wmma.f32x8.get [d0.])
  ({[.df] (const.u32.0x00000001)} wmma.f32x8.get [d1.])
  ({[.df] (const.u32.0x00000002)} wmma.f32x8.get [d2.])
  ({[.df] (const.u32.0x00000003)} wmma.f32x8.get [d3.])
  ({[.df] (const.u32.0x00000004)} wmma.f32x8.get [d4.])
  ({[.df] (const.u32.0x00000005)} wmma.f32x8.get [d5.])
  ({[.df] (const.u32.0x00000006)} wmma.f32x8.get [d6.])
  ({[.df] (const.u32.0x00000007)} wmma.f32x8.get [d7.])
  ({[.d6] [.d7]} *.intro [p6.])
  ({[.d5] [.p6]} *.intro [p5.])
  ({[.d4] [.p5]} *.intro [p4.])
  ({[.d3] [.p4]} *.intro [p3.])
  ({[.d2] [.p3]} *.intro [p2.])
  ({[.d1] [.p2]} *.intro [p1.])
  ({[.d0] [.p1]} *.intro [p0.])
  [.p0]
 ))
