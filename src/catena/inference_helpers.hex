# Generic non-learned input conversion and generated state allocation.
(def program inference.zero-bf16-at : ([n.] {(u64 val) ([.n] ix val)}) -> ([n.] (bf16 val))
= ([ignored index.] (const.u32.0x00000000 u32.bitcast-f32 f32.to-bf16)))
(def program inference.zeros-bf16 : (u64 val) -> (cap.own mem)
= ([count.] ([.count] u64.name [n.])
 {[.n] ({[.n] (const.u64.0x0000000000000000) (([.n] :.param) name.inference.zero-bf16-at)} materializec)} buf.to-mem))
(def program inference.zero-u64-at : ([n.] {(u64 val) ([.n] ix val)}) -> ([n.] (u64 val))
= ([ignored index.] (const.u64.0x0000000000000000)))
(def program inference.zeros-u64 : (u64 val) -> (cap.own mem)
= ([count.] ([.count] u64.name [n.])
 {[.n] ({[.n] (const.u64.0x0000000000000000) (([.n] :.param) name.inference.zero-u64-at)} materializec)} buf.to-mem))
(def program inference.f32-to-bf16-at : ([n.] {(cap.ref mem) ([.n] ix val)}) -> ([n.] (bf16 val))
= ([input index.] ([.input] mem.cast.f32 [count buffer.]) ([.index] ix.to-u64 [i.])
 ({[.count] [.buffer] [.i]} qwen3.f32-buffer-at f32.to-bf16)))
(def program inference.f32-to-bf16 : {(cap.ref mem) (u64 val)} -> (cap.own mem)
= ([input count.] ([.count] u64.name [n.])
 {[.n] ({[.n] [.input] (([.n] :.param) name.inference.f32-to-bf16-at)} materializec)} buf.to-mem))
