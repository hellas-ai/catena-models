  ({[.j] (const.u64.0x0000000000000004)} stdlib.models.memory.u64.rem [reg.])
  ({[.reg] (const.u64.0x0000000000000002)} stdlib.models.memory.u64.rem [hi.])
  ({[.hi] (const.u64.0x0000000000000008)} stdlib.models.memory.u64.mul [offset.])
  ({[.g] [.offset]} stdlib.models.memory.u64.add [result.])
  [.result]
 ))
