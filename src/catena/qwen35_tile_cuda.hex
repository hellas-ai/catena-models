# Native CUDA 16x16 BF16 tile. All 32 lanes must participate.
# PTX lane group g=tid/4, pair t=tid%4. A registers select rows g/g+8
# and K pairs t/t+4; B registers select columns g/g+8 and K pairs t/t+4.
# Output slots 0..3 and 4..7 are the two native m16n8 accumulator fragments.
(def program stdlib.qwen35.tile.row : {(u64 val) (u64 val)} -> (u64 val) =
 ([tid j.]
  ({[.tid] (const.u64.0x0000000000000004)} stdlib.models.memory.u64.div [g.])
  ({[.j] (const.u64.0x0000000000000004)} stdlib.models.memory.u64.rem [i.])
  ({[.i] (const.u64.0x0000000000000002)} stdlib.models.memory.u64.div [half.])
  ({[.half] (const.u64.0x0000000000000008)} stdlib.models.memory.u64.mul [offset.])
  ({[.g] [.offset]} stdlib.models.memory.u64.add [result.])
  [.result]
 ))
(def program stdlib.qwen35.tile.col : {(u64 val) (u64 val)} -> (u64 val) =
 ([tid j.]
  ({[.tid] (const.u64.0x0000000000000004)} stdlib.models.memory.u64.rem [t.])
  ({[.t] (const.u64.0x0000000000000002)} stdlib.models.memory.u64.mul [base.])
  ({[.j] (const.u64.0x0000000000000002)} stdlib.models.memory.u64.rem [odd.])
  ({[.j] (const.u64.0x0000000000000004)} stdlib.models.memory.u64.div [half.])
  ({[.half] (const.u64.0x0000000000000008)} stdlib.models.memory.u64.mul [offset.])
  ({[.base] [.odd]} stdlib.models.memory.u64.add [v.])
  ({[.v] [.offset]} stdlib.models.memory.u64.add [result.])
  [.result]
 ))
