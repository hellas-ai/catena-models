 ([tid k j.]
  ({[.tid] (const.u64.0x0000000000000004)} stdlib.models.memory.u64.rem [t.])
  ({[.j] (const.u64.0x0000000000000004)} stdlib.models.memory.u64.rem [reg.])
  ({[.reg] (const.u64.0x0000000000000002)} stdlib.models.memory.u64.div [hi.])
  ({[.hi] (const.u64.0x0000000000000004)} stdlib.models.memory.u64.mul [offset.])
  ({[.k] [.t]} stdlib.models.memory.u64.add [kt.])
  ({[.kt] [.offset]} stdlib.models.memory.u64.add [result.])
  [.result]
 ))
