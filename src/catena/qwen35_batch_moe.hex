# The default routing denominator is reducec: a left-to-right scalar sum,
# not the adjacent-pair reduction used by normalization/router projection.

(def program stdlib.qwen35.batch.moe.prob-sum : {(u64 val) (({({perf.blocks perf.one} stdlib.gpu.geometry.sort.D2) ({perf.threads perf.one} stdlib.gpu.geometry.sort.D2) perf.grid ({({({perf.float-slot} stdlib.gpu.memory.type.SlotName) perf.float-count f32} stdlib.gpu.memory.sort.Slot) ({({({perf.pair-slot} stdlib.gpu.memory.type.SlotName) perf.pair-count bf16x2} stdlib.gpu.memory.sort.Slot) list.Nil} list.Cons)} list.Cons) perf.memory perf.block ({perf.float-slot} stdlib.gpu.memory.type.SlotName) perf.float-count f32} stdlib.gpu.memory.type.Shared) val) ({(u64 val) (f32 val)} *)} -> (f32 val) =
 ([token shared pair.]
  ([.pair] *.elim [i acc.])
  ({[.shared] [.i]} stdlib.models.coop.read [term.])
  ({[.acc] [.term]} stdlib.models.memory.f32.add [sum.])
  [.sum]
 ))

