  ({[.value] [.candidate]} stdlib.models.memory.f32.greater [smaller.])
  ({[.i] [.expert]} stdlib.models.memory.u64.less [earlier.])
  ({[.smaller] (const.u64.0x0000000000000000) (const.u64.0x0000000000000001)} stdlib.models.memory.select-u64 [not-smaller.])
