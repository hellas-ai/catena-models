# Whisper BF16 kernels, using only generic GPU primitives.
# The shared model graph owns allocation, lifetime, caches and generation.

(def program stdlib.whisper.linear : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) (u64 val) (u64 val)} -> ((cap.own mem) val) =
 ([input weight rows ci co.]
 ({[.input] [.weight] [.ci] [.co]} stdlib.qwen35.batch.project)
 ))
(def program stdlib.whisper.gelu : {(f32 val)} -> (f32 val)
= ([x.]
 ((const.u32.0x00000000 u32.bitcast-f32) [zero.])
 ((const.u32.0x3F800000 u32.bitcast-f32) [one.])
 ((const.u32.0x3F000000 u32.bitcast-f32) [half.])
 ((const.u32.0x3F3504F3 u32.bitcast-f32) [invroot.])
 ((const.u32.0x3EA7BA05 u32.bitcast-f32) [p.])
 ((const.u32.0x3E827906 u32.bitcast-f32) [a1.])
 ((const.u32.0xBE91A98E u32.bitcast-f32) [a2.])
 ((const.u32.0x3FB5F0E3 u32.bitcast-f32) [a3.])
 ((const.u32.0xBFBA00E3 u32.bitcast-f32) [a4.])
 ((const.u32.0x3F87DC22 u32.bitcast-f32) [a5.])
 ([.x zero] stdlib.qwen3.memory.f32.less [negative.]) ([.x] stdlib.qwen3.memory.f32.negate [nx.])
 ([.negative nx x] stdlib.qwen3.memory.select-f32 [absx.]) ([.absx invroot] stdlib.qwen3.memory.f32.mul [z.])
 ([.p z] stdlib.qwen3.memory.f32.mul [pz.]) ([.one pz] stdlib.qwen3.memory.f32.add [den.]) ([.one den] stdlib.qwen3.memory.f32.div [t.])
 ([.a5 t] stdlib.qwen3.memory.f32.mul [b4.]) ([.b4 a4] stdlib.qwen3.memory.f32.add [v4.])
 ([.v4 t] stdlib.qwen3.memory.f32.mul [b3.]) ([.b3 a3] stdlib.qwen3.memory.f32.add [v3.])
 ([.v3 t] stdlib.qwen3.memory.f32.mul [b2.]) ([.b2 a2] stdlib.qwen3.memory.f32.add [v2.])
 ([.v2 t] stdlib.qwen3.memory.f32.mul [b1.]) ([.b1 a1] stdlib.qwen3.memory.f32.add [v1.])
 ([.v1 t] stdlib.qwen3.memory.f32.mul [poly.]) ([.z z] stdlib.qwen3.memory.f32.mul stdlib.qwen3.memory.f32.negate stdlib.whisper.exp-nonpositive [ex.])
 ([.poly ex] stdlib.qwen3.memory.f32.mul [tail.]) ([.one tail] stdlib.qwen3.memory.f32.sub [erf.])
 ([.erf] stdlib.qwen3.memory.f32.negate [nerf.]) ([.negative nerf erf] stdlib.qwen3.memory.select-f32 [signed.])
 ([.one signed] stdlib.qwen3.memory.f32.add [gate.]) ([.x half] stdlib.qwen3.memory.f32.mul [xh.]) ([.xh gate] stdlib.qwen3.memory.f32.mul)
))


(def program stdlib.whisper.bias-gelu.element : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) (u64 val) ((cap.own mem) val) (u64 val)} -> 1 =
 ([input bias cols activate out element.]
 ({[.element] [.cols]} stdlib.qwen3.memory.u64.rem [col.])
 ({[.input] [.element]} stdlib.qwen3.memory.own-read-bf16 [x-bf.])
 ([.x-bf] bf16.to-f32 [x.])
 ({[.bias] [.col]} stdlib.qwen3.memory.ref-read-bf16 [b-bf.])
 ([.b-bf] bf16.to-f32 [b.])
 ({[.x] [.b]} stdlib.qwen3.memory.f32.add [sum.])
 ({[.sum]} stdlib.whisper.gelu [gelu.])
 ({(const.u64.0x0000000000000000) [.activate]} stdlib.qwen3.memory.u64.less [use.])
 ({[.use] [.gelu] [.sum]} stdlib.qwen3.memory.select-f32 [value.])
 ([.value] f32.to-bf16 [rounded.])
 ({[.out] [.element] [.rounded]} stdlib.qwen3.memory.write-bf16)
 (unit.elim)
 (unit.intro)
 ))

(def program stdlib.whisper.bias-gelu.yes : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) (u64 val) ((cap.own mem) val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([input bias cols activate out pair.]
 ([.pair] *.elim [element proofs.])
 ([.proofs] *.elim [proof unit.])
 ([.proof] unsafe.discard unit.elim)
 ([.unit] unit.elim)
 ({[.input] [.bias] [.cols] [.activate] [.out] [.element]} stdlib.whisper.bias-gelu.element)
 ))

