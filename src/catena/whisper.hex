(def program stdlib.whisper.bias-gelu.run : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) (u64 val) (u64 val) (u64 val)} -> ((cap.own mem) val) =
 ([input bias cols activate count elements.]
 ([.elements] stdlib.qwen3.memory.alloc-bf16 [out.])
 ({[.count] (const.u64.0x00000000000000FF)} stdlib.qwen3.memory.u64.add [padded.])
 ({[.padded] (const.u64.0x0000000000000100)} stdlib.qwen3.memory.u64.div [blocks.])
 ({[.blocks]} stdlib.qwen3.memory.grid [grid.])
 ({[.input] [.bias] [.cols] [.activate] [.out] [.count] [.grid]} partial.stdlib.whisper.bias-gelu.host.7 [host.])
