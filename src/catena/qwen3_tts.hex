# Qwen3-TTS CustomVoice device-side conditioning and sampling.

# The flag is written once per frame and is uniform across each launch.
(def program stdlib.qwen-tts.active-count : {((cap.own mem) val) (u64 val)} -> (u64 val) =
 ([progress count.]
  ({[.progress] (const.u64.0x0000000000000001)} stdlib.models.memory.own-read-u64 [flag.])
  ({[.flag] (const.u64.0x0000000000000000)} stdlib.models.memory.u64.equal [active.])
  ({[.active] [.count] (const.u64.0x0000000000000000)} stdlib.models.memory.select-u64)
 ))

(def program stdlib.qwen-tts.affine-value : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) (u64 val)} -> (f32 val) =
 ([input bias width i.]
  ({[.i] [.width]} stdlib.models.memory.u64.rem [column.])
  ({[.input] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [value.])
  ({[.bias] [.column]} stdlib.models.memory.ref-read-bf16 bf16.to-f32 [shift.])
  ({[.value] [.shift]} stdlib.models.memory.f32.add f32.to-bf16 bf16.to-f32)
 ))

(def program stdlib.qwen-tts.seen-code :
 {((cap.own mem) val) (u64 val)
  ({({master.index32 u32} :) ({(bool val) ({(({master.index32 master.end32} prop.Less) |-) (prop.Truth |-)} *)} *)} *)}
 -> ({(bool val) (prop.Truth |-)} *) =
 ([history code pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [found proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ([.index] :.forget stdlib.models.memory.u32.to-u64 [i.])
  ({[.i] (const.u64.0x0000000000000010)} stdlib.models.memory.u64.mul [offset.])
  ({[.history] [.offset]} stdlib.models.memory.own-read-u64 [prior.])
  ({[.prior] [.code]} stdlib.models.memory.u64.equal [same.])
  ({[.found] [.same]} stdlib.boolean.or [seen.])
  ({[.seen] [.truth]} *.intro)
 ))

# Monotonic keys across negative and positive IEEE floats. Binary search
# finds the k-th key, retaining every token tied at the threshold.
(def program stdlib.qwen-tts.score-key : {(f32 val)} -> (u32 val) =
 ([score.]
  ([.score] stdlib.math.f32_bits [bits.])
  ({[.bits] (const.u32.0x80000000)} stdlib.models.memory.u32.less [nonnegative.])
  ({[.bits] (const.u32.0x80000000)} stdlib.models.memory.u32.add [upper.])
  ({(const.u32.0xFFFFFFFF) [.bits]} stdlib.models.memory.u32.sub [lower.])
  ({[.nonnegative] [.upper] [.lower]} stdlib.models.memory.select-u32)
 ))

# Per-frame and per-codebook seeded Gumbel noise for categorical sampling.
(def program stdlib.qwen-tts.gumbel : {(u64 val) (u64 val) (u64 val) (u64 val)} -> (f32 val) =
 ([seed frame group i.]
  ({[.frame] (const.u64.0x0000000000000010)} stdlib.models.memory.u64.mul [frame-offset.])
  ({[.frame-offset] [.group]} stdlib.models.memory.u64.add [stream.])
  ({[.stream] (const.u64.0x0000000000000801)} stdlib.models.memory.u64.mul [offset.])
  ({[.offset] [.i]} stdlib.models.memory.u64.add [counter.])
  ({[.seed] (const.u64.0x0000000000000020)} stdlib.models.memory.u64.shr stdlib.models.memory.fold-count-u32 [high.])
  ({[.seed] (const.u64.0x0000000100000000)} stdlib.models.memory.u64.rem stdlib.models.memory.fold-count-u32 [low.])
  ([.counter] stdlib.models.memory.fold-count-u32 [ctr.])
  ({[.high] (const.u32.0x9E3779B9)} stdlib.models.memory.u32.mul [mixed-high.])
  ({[.low] [.mixed-high]} tts.xor [key.])
  ({[.key] [.ctr]} stdlib.models.memory.u32.add [x.])
  ({[.x] (const.u32.0x00000010)} stdlib.math.shift_right [x-hi.])
  ({[.x] [.x-hi]} tts.xor [x-mix.])
  ({[.x-mix] (const.u32.0x7FEB352D)} stdlib.models.memory.u32.mul [y.])
  ({[.y] (const.u32.0x0000000F)} stdlib.math.shift_right [y-hi.])
  ({[.y] [.y-hi]} tts.xor [y-mix.])
  ({[.y-mix] (const.u32.0x846CA68B)} stdlib.models.memory.u32.mul [z.])
  ({[.z] (const.u32.0x00000010)} stdlib.math.shift_right [z-hi.])
  ({[.z] [.z-hi]} tts.xor [bits.])
  ({[.bits] (const.u32.0x00000009)} stdlib.math.shift_right stdlib.models.memory.u32.to-f32 [mantissa.])
  ({[.mantissa] (const.u32.0x3F000000 u32.bitcast-f32)} stdlib.models.memory.f32.add [centered.])
  ({[.centered] (const.u32.0x34000000 u32.bitcast-f32)} stdlib.models.memory.f32.mul [uniform.])
  ([.uniform] stdlib.models.math.log-positive stdlib.models.memory.f32.negate stdlib.models.math.log-positive stdlib.models.memory.f32.negate)
 ))

# Element bodies
# Element zero-u64
  ({[.out] [.i] (const.u64.0x0000000000000000)} stdlib.models.memory.write-u64 unit.elim)
# Element row
  ({[.row] [.width]} stdlib.models.memory.u64.mul [offset.])
  ({[.offset] [.i]} stdlib.models.memory.u64.add [index.])
  ({[.input] [.index]} stdlib.models.memory.own-read-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element prompt-text
  ({[.i] [.width]} stdlib.models.memory.u64.div [row.])
  ({[.i] [.width]} stdlib.models.memory.u64.rem [column.])
  ({[.row] [.instruction-len]} stdlib.models.memory.u64.less [is-instruction.])
  ({[.is-instruction] [.row] (const.u64.0x0000000000000000)} stdlib.models.memory.select-u64 [instruction-row.])
  ({[.instruction] [.instruction-row]} stdlib.models.memory.ref-read-u64 [instruction-id.])
  ({[.row] [.instruction-len]} stdlib.models.memory.u64.sub [local-raw.])
  ({[.is-instruction] (const.u64.0x0000000000000000) [.local-raw]} stdlib.models.memory.select-u64 [local.])
  ({[.local] (const.u64.0x0000000000000003)} stdlib.models.memory.u64.less [is-role.])
  ({[.local] [.codec-len]} stdlib.models.memory.u64.sub [content-row.])
  ({[.content-row] [.text-len]} stdlib.models.memory.u64.less [content-in-bounds.])
  ({(const.u64.0x0000000000000003) [.content-row]} stdlib.models.memory.u64.less_equal [after-role.])
  ({[.content-in-bounds] [.after-role]} stdlib.boolean.and [is-content.])
  ({[.is-content] [.content-row] (const.u64.0x0000000000000000)} stdlib.models.memory.select-u64 [safe-content.])
  ({[.is-role] [.local] [.safe-content]} stdlib.models.memory.select-u64 [text-row.])
  ({[.text] [.text-row]} stdlib.models.memory.ref-read-u64 [text-id.])
  ({[.text-len] [.codec-len]} stdlib.models.memory.u64.add [eos-row.])
  ({[.local] [.eos-row]} stdlib.models.memory.u64.equal [is-eos.])
  ({[.codec-len] (const.u64.0x0000000000000002)} stdlib.models.memory.u64.add [bos-row.])
  ({[.local] [.bos-row]} stdlib.models.memory.u64.equal [is-bos.])
  ({[.is-bos] [.bos] [.pad]} stdlib.models.memory.select-u64 [pad-or-bos.])
  ({[.is-eos] [.eos] [.pad-or-bos]} stdlib.models.memory.select-u64 [special-id.])
  ({[.is-role] [.is-content]} stdlib.boolean.or [is-text.])
  ({[.is-text] [.text-id] [.special-id]} stdlib.models.memory.select-u64 [id.])
  ({[.is-instruction] [.instruction-id] [.id]} stdlib.models.memory.select-u64 [token.])
  ({[.token] [.width]} stdlib.models.memory.u64.mul [offset.])
  ({[.offset] [.column]} stdlib.models.memory.u64.add [index.])
  ({[.embedding] [.index]} stdlib.models.memory.ref-read-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element prompt-codec
  ({[.i] [.width]} stdlib.models.memory.u64.div [row.])
  ({[.i] [.width]} stdlib.models.memory.u64.rem [column.])
  ({[.instruction-len] (const.u64.0x0000000000000003)} stdlib.models.memory.u64.add [codec-start.])
  ({[.codec-start] [.row]} stdlib.models.memory.u64.less_equal [add-codec.])
  ({[.row] [.codec-start]} stdlib.models.memory.u64.sub [codec-row.])
  ({[.codec-row] [.codec-len]} stdlib.models.memory.u64.less [is-prefix.])
  ({[.is-prefix] [.codec-row] (const.u64.0x0000000000000000)} stdlib.models.memory.select-u64 [prefix-row.])
  ({[.codec] [.prefix-row]} stdlib.models.memory.ref-read-u64 [prefix-id.])
  ({[.prompt-rows] (const.u64.0x0000000000000001)} stdlib.models.memory.u64.sub [last.])
  ({[.row] [.last]} stdlib.models.memory.u64.equal [is-last.])
  ({[.is-last] [.bos] [.pad]} stdlib.models.memory.select-u64 [after-prefix.])
  ({[.is-prefix] [.prefix-id] [.after-prefix]} stdlib.models.memory.select-u64 [token.])
  ({[.token] [.width]} stdlib.models.memory.u64.mul [offset.])
  ({[.offset] [.column]} stdlib.models.memory.u64.add [index.])
  ({[.embedding] [.index]} stdlib.models.memory.ref-read-bf16 bf16.to-f32 [codec-value.])
  ({[.add-codec] [.codec-value] (const.u32.0x00000000 u32.bitcast-f32)} stdlib.models.memory.select-f32 [addition.])
  ({[.projected] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [text-value.])
  ({[.text-value] [.addition]} stdlib.models.memory.f32.add f32.to-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element bias
  ({[.input] [.bias] [.width] [.i]} stdlib.qwen-tts.affine-value f32.to-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element bias-silu
  ({[.input] [.bias] [.width] [.i]} stdlib.qwen-tts.affine-value stdlib.models.math.silu f32.to-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element embed-code
  ({[.code] (const.u64.0x0000000000000000)} stdlib.models.memory.own-read-u64 [token.])
  ({[.token] [.width]} stdlib.models.memory.u64.mul [offset.])
  ({[.offset] [.i]} stdlib.models.memory.u64.add [index.])
  ({[.embedding] [.index]} stdlib.models.memory.ref-read-bf16 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-bf16 unit.elim)
# Element progress
  ({[.code] (const.u64.0x0000000000000000)} stdlib.models.memory.own-read-u64 [token.])
  ({[.out] (const.u64.0x0000000000000001)} stdlib.models.memory.own-read-u64 [prior-stop.])
  ({[.out] (const.u64.0x0000000000000000)} stdlib.models.memory.own-read-u64 [prior-count.])
  ({[.token] [.eos]} stdlib.models.memory.u64.equal [end.])
  ({[.prior-stop] (const.u64.0x0000000000000001)} stdlib.models.memory.u64.equal [stopped.])
  ({[.end] [.stopped]} stdlib.boolean.or [done.])
  ({[.frame] (const.u64.0x0000000000000001)} stdlib.models.memory.u64.add [next.])
  ({[.done] [.prior-count] [.next]} stdlib.models.memory.select-u64 [count.])
  ({[.done] (const.u64.0x0000000000000001) (const.u64.0x0000000000000000)} stdlib.models.memory.select-u64 [stop.])
  ({[.out] (const.u64.0x0000000000000000) [.count]} stdlib.models.memory.write-u64 unit.elim)
  ({[.out] (const.u64.0x0000000000000001) [.stop]} stdlib.models.memory.write-u64 unit.elim)
# Element store-code
  ({[.code] (const.u64.0x0000000000000000)} stdlib.models.memory.own-read-u64 [token.])
  ({[.out] [.offset] [.token]} stdlib.models.memory.write-u64 unit.elim)
# Element init-sum
  ({[.input] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-f32 unit.elim)
# Element sum-embeddings
  ({[.input] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [next.])
  ({[.out] [.i]} stdlib.models.memory.own-read-f32 [sum.])
  ({[.sum] [.next]} stdlib.models.memory.f32.add [value.])
  ({[.out] [.i] [.value]} stdlib.models.memory.write-f32 unit.elim)
# Element sum-pad
  ({[.sum] [.i]} stdlib.models.memory.own-read-f32 f32.to-bf16 bf16.to-f32 [value.])
  ({[.pad] [.i]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [padding.])
  ({[.value] [.padding]} stdlib.models.memory.f32.add f32.to-bf16 [result.])
  ({[.out] [.i] [.result]} stdlib.models.memory.write-bf16 unit.elim)
# Element sample-logits
  ({[.eos] (const.u64.0x0000000000000800)} stdlib.models.memory.u64.equal [predictor.])
  ({[.i] (const.u64.0x0000000000000800)} stdlib.models.memory.u64.equal [special.])
  ({[.predictor] (const.u64.0x0000000000000000) [.eos]} stdlib.models.memory.select-u64 [safe-eos.])
  ({[.special] [.safe-eos] [.i]} stdlib.models.memory.select-u64 [index.])
  ({[.input] [.index]} stdlib.models.memory.own-read-bf16 bf16.to-f32 [logit.])
  ({[.predictor] (const.u64.0x0000000000000000) [.frame]} stdlib.models.memory.select-u64 [history-available.])
  ({[.progress] [.history-available]} stdlib.qwen-tts.active-count [history-rows.])
  ({[.history] [.i]} partial.stdlib.qwen-tts.seen-code.2 [check.])
  ({([.history-rows] stdlib.models.memory.fold-count-u32) (unit.intro meta.master.end32)} smolcat.value.named_at [end.])
  ({[.end] ({(const.u64.0x0000000000000000) (const.u64.0x0000000000000001)} stdlib.models.memory.u64.equal) [.check] core.truth} core.fold.bounded [seen proof.])
  ([.proof] unsafe.discard unit.elim)
  ({[.logit] (const.u32.0x00000000 u32.bitcast-f32)} stdlib.models.memory.f32.less [negative.])
  ({[.logit] [.penalty]} stdlib.models.memory.f32.mul [negative-penalty.])
  ({[.logit] [.penalty]} stdlib.models.memory.f32.div [positive-penalty.])
  ({[.negative] [.negative-penalty] [.positive-penalty]} stdlib.models.memory.select-f32 [adjusted.])
  ({[.seen] [.adjusted] [.logit]} stdlib.models.memory.select-f32 [score.])
  ({[.score] [.temperature]} stdlib.models.memory.f32.div [scaled.])
  ({[.frame] (const.u64.0x0000000000000002)} stdlib.models.memory.u64.less [too-soon.])
  ({[.predictor] [.too-soon]} stdlib.boolean.or [no-eos.])
  ({[.special] [.no-eos]} stdlib.boolean.and [suppress.])
  ({[.suppress] (const.u32.0xFF800000 u32.bitcast-f32) [.scaled]} stdlib.models.memory.select-f32 [eligible.])
  ({[.out] [.i] [.eligible]} stdlib.models.memory.write-f32 unit.elim)
# Element sample-noise
  ({[.scores] [.i]} stdlib.models.memory.own-read-f32 [score.])
  ([.score] stdlib.qwen-tts.score-key stdlib.models.memory.u32.to-u64 [key.])
  ({[.threshold] (const.u64.0x0000000000000000)} stdlib.models.memory.own-read-u64 [cutoff.])
  ({[.cutoff] [.key]} stdlib.models.memory.u64.less_equal [eligible.])
  ({[.seed] [.frame] [.group] [.i]} stdlib.qwen-tts.gumbel [noise.])
  ({[.score] [.noise]} stdlib.models.memory.f32.add [perturbed.])
  ({[.eligible] [.perturbed] (const.u32.0xFF800000 u32.bitcast-f32)} stdlib.models.memory.select-f32 f32.to-bf16 [result.])
  ({[.out] [.i] [.result]} stdlib.models.memory.write-bf16 unit.elim)
# Element sample-code
  ({[.token] (const.u64.0x0000000000000000)} stdlib.models.memory.own-read-u64 [code.])
  ({[.code] (const.u64.0x0000000000000800)} stdlib.models.memory.u64.equal [special.])
  ({[.special] [.eos] [.code]} stdlib.models.memory.select-u64 [result.])
  ({[.out] [.i] [.result]} stdlib.models.memory.write-u64 unit.elim)
