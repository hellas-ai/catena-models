# Two-stage vocabulary argmax. Contiguous partitions preserve first-token ties.
(def program stdlib.qwen3.fused.argmax.scan : {((cap.own mem) val) (u64 val) ({(u64 val) ({(u64 val) (f32 val)} *)} *)} -> ({(u64 val) (f32 val)} *) =
 ([logits base pair.]
  ([.pair] *.elim [i acc.])
  ([.acc] *.elim [token maximum.])
  ({[.base] [.i]} stdlib.qwen3.memory.u64.add [offset.])
  ({[.logits] [.offset]} stdlib.qwen3.memory.own-read-bf16 [bf.])
  ([.bf] bf16.to-f32 [v.])
  ({[.v] [.maximum]} stdlib.qwen3.memory.f32.greater [larger.])
  ({[.larger] [.offset] [.token]} stdlib.qwen3.memory.select-u64 [next-token.])
  ({[.larger] [.v] [.maximum]} stdlib.qwen3.memory.select-f32 [next-max.])
  ({[.next-token] [.next-max]} *.intro)
 ))
