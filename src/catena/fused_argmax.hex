(def program stdlib.qwen3.fused.argmax.partials : {((cap.own mem) val) ((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val) (u64 val)} -> 1 =
 ([logits tokens maxima vocabulary chunk index.]
  ({[.index] [.chunk]} stdlib.qwen3.memory.u64.mul [base.])
  ({[.base] [.vocabulary]} stdlib.qwen3.memory.u64.less [active.])
