 ([.proofs] *.elim [proof unit.])
 ([.proof] unsafe.discard unit.elim)
 ([.unit] unit.elim)
 ({[.input] [.peak] [.samples] [.out] [.element]} stdlib.omnivoice.waveform.element)
 ))

