# OmniVoice device kernels. Audio codes and logits are frame-major.

(def program stdlib.omnivoice.fill-codes.element : {((cap.own mem) val) (u64 val)} -> 1 =
 ([out element.]
  ({[.out] [.element] (const.u64.0x0000000000000400)} stdlib.models.memory.write-u64 unit.elim)
  (unit.intro)
 ))

(def program stdlib.omnivoice.fill-codes.yes : {((cap.own mem) val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([out pair.]
 ([.pair] *.elim [element proofs.])
 ([.proofs] *.elim [proof unit.])
 ([.proof] unsafe.discard unit.elim)
 ([.unit] unit.elim)
 ({[.out] [.element]} stdlib.omnivoice.fill-codes.element)
 ))

(def program stdlib.omnivoice.fill-codes.no : {((cap.own mem) val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([out pair.]
 ([.pair] *.elim [element proofs.])
 ([.proofs] *.elim [proof unit.])
 ([.proof] unsafe.discard unit.elim)
 [.unit]
 ))

(def program stdlib.omnivoice.fill-codes.launch : {((cap.own mem) val) (u64 val) ({({master.block ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid} stdlib.gpu.geometry.type.Block)} :) (({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2) master.grid master.block} stdlib.gpu.geometry.type.Thread) val)} *)} -> 1 =
 ([out work thread.]
 ([.thread] stdlib.models.memory.thread-index [element.])
 ({[.element] [.work]} stdlib.models.memory.u64.less [in-bounds.])
 ({[.in-bounds] (unit.intro meta.master.predicate)} smolcat.value.named_at :.forget [condition.])
 ({[.out]} partial.stdlib.omnivoice.fill-codes.yes.1 [yes.])
 ({[.out]} partial.stdlib.omnivoice.fill-codes.no.1 [no.])
 ({[.condition] [.element] [.yes] [.no] unit.intro} core.if)
 ))

(def program stdlib.omnivoice.fill-codes.host : {((cap.own mem) val) (u64 val) ({master.grid ({({master.blocks master.one} stdlib.gpu.geometry.sort.D2) ({master.threads master.one} stdlib.gpu.geometry.sort.D2)} stdlib.gpu.geometry.type.Grid)} :) ({({master.index u64} :) ({((cap.own mem) val) ({(({master.index master.end} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({((cap.own mem) val) (prop.Truth |-)} *) =
 ([out work grid pair.]
 ([.pair] *.elim [step rest.])
 ([.rest] *.elim [value proofs.])
 ([.proofs] *.elim [less truth.])
 ([.less] unsafe.discard unit.elim)
 ({[.out] [.work]} partial.stdlib.omnivoice.fill-codes.launch.2 [kernel.])
 ({[.grid] [.kernel]} unsafe.launch)
 (unit.elim)
 ({[.value] [.truth]} *.intro)
 ))

(def program stdlib.omnivoice.fill-codes.run : {(u64 val) (u64 val)} -> ((cap.own mem) val) =
 ([work elements.]
 ([.elements] stdlib.models.memory.alloc-u64 [out.])
 ({[.work] (const.u64.0x00000000000000FF)} stdlib.models.memory.u64.add [padded.])
 ({[.padded] (const.u64.0x0000000000000100)} stdlib.models.memory.u64.div [blocks.])
 ({[.blocks]} stdlib.models.memory.grid [grid.])
 ({[.out] [.work] [.grid]} partial.stdlib.omnivoice.fill-codes.host.3 [host.])
 ({(const.u64.0x0000000000000001) (unit.intro meta.master.end)} smolcat.value.named_at [end.])
 ({[.end] [.out] [.host] core.truth} core.fold.bounded_u64 [result proof.])
 ([.proof] unsafe.discard unit.elim)
 [.result]
 ))

