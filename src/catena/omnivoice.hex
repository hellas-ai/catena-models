(def program stdlib.omnivoice.embedding-sum : {((cap.own mem) val) ((cap.ref mem) val) (u64 val) (u64 val) ({({master.index32 u32} :) ({(f32 val) ({(({master.index32 master.end32} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({(f32 val) (prop.Truth |-)} *) =
 ([codes audio-embedding frame channel pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [acc proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ([.index] :.forget stdlib.models.memory.u32.to-u64 [i.])
  ({[.frame] (const.u64.0x0000000000000008)} stdlib.models.memory.u64.mul [v0.])
  ({[.v0] [.i]} stdlib.models.memory.u64.add [v1.])
  ({[.codes] [.v1]} stdlib.models.memory.own-read-u64 [v2.])
  ({[.i] (const.u64.0x0000000000000401)} stdlib.models.memory.u64.mul [v3.])
  ({[.v3] [.v2]} stdlib.models.memory.u64.add [v4.])
  ({[.v4] (const.u64.0x0000000000000400)} stdlib.models.memory.u64.mul [v5.])
  ({[.v5] [.channel]} stdlib.models.memory.u64.add [v6.])
  ({[.audio-embedding] [.v6]} stdlib.models.memory.ref-read-bf16 [v7.])
  ({[.v7]} bf16.to-f32 [v8.])
  ({[.acc] [.v8]} stdlib.models.memory.f32.add [v9.])
  ({[.v9] [.truth]} *.intro)
 ))

(def program stdlib.omnivoice.embed.element : {((cap.own mem) val) ((cap.ref mem) val) ((cap.ref mem) val) ((cap.ref mem) val) (u64 val) ((cap.own mem) val) (u64 val)} -> 1 =
 ([codes text text-embedding audio-embedding prefix out element.]
  ({[.element] (const.u64.0x0000000000000400)} stdlib.models.memory.u64.div [v0.])
  ({[.element] (const.u64.0x0000000000000400)} stdlib.models.memory.u64.rem [v1.])
  ({[.v0] [.prefix]} stdlib.models.memory.u64.less [v2.])
  ({[.v2] [.v0] (const.u64.0x0000000000000000)} stdlib.models.memory.select-u64 [v3.])
  ({[.text] [.v3]} stdlib.models.memory.ref-read-u64 [v4.])
  ({[.v4] (const.u64.0x0000000000000400)} stdlib.models.memory.u64.mul [v5.])
  ({[.v5] [.v1]} stdlib.models.memory.u64.add [v6.])
  ({[.text-embedding] [.v6]} stdlib.models.memory.ref-read-bf16 [v7.])
  ({[.v7]} bf16.to-f32 [v8.])
  ({[.v0] [.prefix]} stdlib.models.memory.u64.sub [v9.])
  ({[.v2] (const.u64.0x0000000000000000) [.v9]} stdlib.models.memory.select-u64 [v10.])
  ({[.codes] [.audio-embedding] [.v10] [.v1]} partial.stdlib.omnivoice.embedding-sum.4 [v11.])
  ({((const.u64.0x0000000000000008) stdlib.models.memory.fold-count-u32) (unit.intro meta.master.end32)} smolcat.value.named_at [v12.])
  ({[.v12] (const.u32.0x00000000 u32.bitcast-f32) [.v11] core.truth} core.fold.bounded [audio-value proof-audio-value.])
  ([.proof-audio-value] unsafe.discard unit.elim)
  ({[.v2] [.v8] [.audio-value]} stdlib.models.memory.select-f32 [v13.])
  ({[.v13]} f32.to-bf16 [v14.])
  ({[.out] [.element] [.v14]} stdlib.models.memory.write-bf16 unit.elim)
  (unit.intro)
 ))

