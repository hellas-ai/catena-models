# SIMT online cached attention: eight keys per tile, 32 lanes per dot.
# Shared Hex exponential, F32 online normalization; BF16 context rounding before Q gate.

(def program stdlib.qwen35.online.dot : {((cap.own mem) val) ((cap.own mem) val) (u64 val) (u64 val) (u64 val) ({(u64 val) (f32 val)} *)} -> (f32 val) =
 ([query cache qb kb lane pair.]
  ([.pair] *.elim [i acc.])
  ({[.i] (const.u64.0x0000000000000020)} stdlib.models.memory.u64.mul [stride.])
  ({[.stride] [.lane]} stdlib.models.memory.u64.add [ch.])
  ({[.qb] [.ch]} stdlib.models.memory.u64.add [qi.])
  ({[.kb] [.ch]} stdlib.models.memory.u64.add [ki.])
  ({[.query] [.qi]} stdlib.models.memory.own-read-bf16 [q.])
  ({[.cache] [.ki]} stdlib.models.memory.own-read-bf16 [k.])
  ([.q] bf16.to-f32 [qf.])
  ([.k] bf16.to-f32 [kf.])
  ({[.qf] [.kf]} stdlib.models.memory.f32.mul [product.])
  ({[.acc] [.product]} stdlib.models.memory.f32.add [sum.])
  [.sum]
 ))

