 ([query cache qb kb lane pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [fold-value proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ([.index] :.forget stdlib.models.memory.u32.to-u64 [i.])
  ({[.i] [.fold-value]} *.intro [arguments.])
  ({[.query] [.cache] [.qb] [.kb] [.lane] [.arguments]} stdlib.qwen35.online.dot [fold-result.])
  ({[.fold-result] [.truth]} *.intro)
 ))

