(def program flux.noise-to-bf16-at : ([n.] {({(cap.ref mem) (u64 val)} *) ([.n] ix val)}) -> ([n.] (bf16 val))
= ([env index.] ([.env] *.elim [x count.]) ([.index] ix.to-u64 [i.])
 ({[.x] [.i]} flux.read-f32 [value.]) ([.value] f32.to-bf16)
))
(def program flux.noise-to-bf16 : {(cap.ref mem) (u64 val)} -> (cap.own mem)
= ([x count.]
 ([.count] u64.name [n.])
 ({[.x] [.count]} *.intro [env.])
 {[.n] ({[.n] [.env] (([.n] :.param) name.flux.noise-to-bf16-at)} materializec)} buf.to-mem
))

