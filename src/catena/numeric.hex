# Dimension-free model numerics. Arithmetic order and F32 boundaries are intentional.
#
# Exponential adapted from FreeBSD lib/msun/src/e_expf.c (fdlibm).
# Conversion to float by Ian Lance Taylor, Cygnus Support, ian@cygnus.com.
# Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
# Developed at SunPro, a Sun Microsystems, Inc. business.
# Permission to use, copy, modify, and distribute this software is freely
# granted, provided that this notice is preserved.
#
# Round-to-nearest F32, no FMA contraction. Range reduction uses split ln(2)
# and the fdlibm rational approximation. Scaling uses integer bits, including
# nearest-even subnormal rounding, so it never needs subnormal F32 arithmetic.
# NaNs are canonicalized; exception flags and other rounding modes are not modeled.

# Keep packed loads, but accumulate low then high using ordinary F32 operations.
# Each multiply/add rounds separately; this intentionally differs from AMD dot2.
(def program stdlib.models.math.dot-pair-f32 : {(bf16x2 val) (bf16x2 val) (f32 val)} -> (f32 val) =
 ([a b acc.]
  ([.a] bf16x2.low bf16.to-f32 [a-low.])
  ([.b] bf16x2.low bf16.to-f32 [b-low.])
  ([.a] bf16x2.high bf16.to-f32 [a-high.])
  ([.b] bf16x2.high bf16.to-f32 [b-high.])
  ({[.a-low] [.b-low]} stdlib.models.memory.f32.mul [low.])
  ({[.acc] [.low]} stdlib.models.memory.f32.add [partial.])
  ({[.a-high] [.b-high]} stdlib.models.memory.f32.mul [high.])
  ({[.partial] [.high]} stdlib.models.memory.f32.add [result.])
  [.result]
 ))

(def program stdlib.models.math.exp-scale : {(f32 val) (u32 val) (bool val)} -> (f32 val) =
 ([y n negative.]
  ({[.y]} stdlib.math.f32_bits [y-bits.])
  ({[.y-bits] (const.u32.0x00000017)} stdlib.math.shift_right [exponent.])
  ({[.exponent] [.n]} stdlib.models.memory.u32.less_equal [subnormal.])
  ({[.n] [.exponent]} stdlib.models.memory.u32.sub [shift-raw.])
  ({[.shift-raw] (const.u32.0x00000001)} stdlib.models.memory.u32.add [shift-plus-one.])
  ({[.subnormal] [.shift-plus-one] (const.u32.0x00000001)} stdlib.models.memory.select-u32 [shift.])
  ({[.y-bits] (const.u32.0x00800000)} stdlib.models.memory.u32.rem [fraction.])
  ({[.fraction] (const.u32.0x00800000)} stdlib.models.memory.u32.add [significand.])
  ({[.significand] [.shift]} stdlib.math.shift_right [truncated.])
  ({(const.u32.0x0000001F) [.shift]} stdlib.models.memory.u32.sub [power-shift.])
  ({(const.u32.0x80000000) [.power-shift]} stdlib.math.shift_right [power.])
  ({[.truncated] [.power]} stdlib.models.memory.u32.mul [restored.])
  ({[.significand] [.restored]} stdlib.models.memory.u32.sub [remainder.])
  ({[.power] (const.u32.0x00000001)} stdlib.math.shift_right [half.])
  ({[.half] [.remainder]} stdlib.models.memory.u32.less [above-half.])
  ({[.half] [.remainder]} stdlib.models.memory.u32.equal [at-half.])
  ({[.truncated] (const.u32.0x00000002)} stdlib.models.memory.u32.rem [parity.])
  ({[.parity] (const.u32.0x00000001)} stdlib.models.memory.u32.equal [odd.])
  ({[.at-half] [.odd]} stdlib.boolean.and [odd-tie.])
  ({[.above-half] [.odd-tie]} stdlib.boolean.or [round-up.])
  ({[.round-up] (const.u32.0x00000001) (const.u32.0x00000000)} stdlib.models.memory.select-u32 [increment.])
  ({[.truncated] [.increment]} stdlib.models.memory.u32.add [subnormal-bits.])
  ({[.n] (const.u32.0x00800000)} stdlib.models.memory.u32.mul [offset.])
  ({[.y-bits] [.offset]} stdlib.models.memory.u32.sub [down-bits.])
  ({[.y-bits] [.offset]} stdlib.models.memory.u32.add [up-bits.])
  ({[.subnormal] [.subnormal-bits] [.down-bits]} stdlib.models.memory.select-u32 [down-result.])
  ({[.negative] [.down-result] [.up-bits]} stdlib.models.memory.select-u32 [result-bits.])
  ({[.result-bits]} u32.bitcast-f32 [result.])
  [.result]
 ))

(def program stdlib.models.math.exp : (f32 val) -> (f32 val) =
 ([x.]
  ({[.x]} stdlib.math.f32_bits [bits.])
  ({[.bits] (const.u32.0x80000000)} stdlib.models.memory.u32.rem [magnitude.])
  ({(const.u32.0x80000000) [.bits]} stdlib.models.memory.u32.less_equal [negative.])
  ({(const.u32.0x7F800000) [.magnitude]} stdlib.models.memory.u32.less [nan.])
  ({[.negative] (const.u32.0x42CFF1B5) (const.u32.0x42B17218)} stdlib.models.memory.select-u32 [limit.])
  ({[.magnitude] [.limit]} stdlib.models.memory.u32.less [finite-range.])
  ({[.finite-range] [.x] (const.u32.0x00000000 u32.bitcast-f32)} stdlib.models.memory.select-f32 [safe-x.])
  ({[.safe-x]} stdlib.models.memory.f32.negate [minus-x.])
  ({[.negative] [.minus-x] [.safe-x]} stdlib.models.memory.select-f32 [absolute.])
  ({[.absolute] (const.u32.0x3FB8AA3B u32.bitcast-f32)} stdlib.models.memory.f32.mul [scaled.])
  ({[.scaled]} stdlib.math.round_to_u32 [n.])
  ({[.n]} stdlib.models.memory.u32.to-f32 [nf.])
  ({[.nf]} stdlib.models.memory.f32.negate [minus-nf.])
  ({[.negative] [.minus-nf] [.nf]} stdlib.models.memory.select-f32 [k.])
  ({[.k] (const.u32.0x3F317200 u32.bitcast-f32)} stdlib.models.memory.f32.mul [k-hi.])
  ({[.safe-x] [.k-hi]} stdlib.models.memory.f32.sub [hi.])
  ({[.k] (const.u32.0x35BFBE8E u32.bitcast-f32)} stdlib.models.memory.f32.mul [lo.])
  ({[.hi] [.lo]} stdlib.models.memory.f32.sub [r.])
  ({[.r] [.r]} stdlib.models.memory.f32.mul [square.])
  ({[.square] (const.u32.0xBB355215 u32.bitcast-f32)} stdlib.models.memory.f32.mul [p2-term.])
  ({(const.u32.0x3E2AAA8F u32.bitcast-f32) [.p2-term]} stdlib.models.memory.f32.add [polynomial.])
  ({[.square] [.polynomial]} stdlib.models.memory.f32.mul [correction.])
  ({[.r] [.correction]} stdlib.models.memory.f32.sub [c.])
  ({[.r] [.c]} stdlib.models.memory.f32.mul [numerator.])
  ({(const.u32.0x40000000 u32.bitcast-f32) [.c]} stdlib.models.memory.f32.sub [denominator.])
  ({[.numerator] [.denominator]} stdlib.models.memory.f32.div [ratio.])
  ({[.lo] [.ratio]} stdlib.models.memory.f32.sub [tail.])
  ({[.tail] [.hi]} stdlib.models.memory.f32.sub [adjustment.])
  ({(const.u32.0x3F800000 u32.bitcast-f32) [.adjustment]} stdlib.models.memory.f32.sub [y.])
  ({[.y] [.n] [.negative]} stdlib.models.math.exp-scale [scaled-result.])
  ({[.magnitude] (const.u32.0x39000000)} stdlib.models.memory.u32.less [tiny.])
  ({(const.u32.0x3F800000 u32.bitcast-f32) [.safe-x]} stdlib.models.memory.f32.add [tiny-result.])
  ({[.tiny] [.tiny-result] [.scaled-result]} stdlib.models.memory.select-f32 [finite-result.])
  ({[.negative] (const.u32.0x00000000 u32.bitcast-f32) (const.u32.0x7F800000 u32.bitcast-f32)} stdlib.models.memory.select-f32 [exceptional.])
  ({[.finite-range] [.finite-result] [.exceptional]} stdlib.models.memory.select-f32 [classified.])
  ({[.nan] (const.u32.0x7FC00000 u32.bitcast-f32) [.classified]} stdlib.models.memory.select-f32 [result.])
  [.result]
 ))

(def program stdlib.models.math.silu : (f32 val) -> (f32 val) =
  ([x.]
    (const.u32.0x3F800000 u32.bitcast-f32 [one.])
    ([.x] stdlib.models.memory.f32.negate [negative-x.])
    ([.negative-x] stdlib.models.math.exp [exp-negative-x.])
    ([.one exp-negative-x] stdlib.models.memory.f32.add [denominator.])
    ([.x denominator] stdlib.models.memory.f32.div [result.])
    [.result]
  )
)

(def program stdlib.models.math.sigmoid : (f32 val) -> (f32 val) =
  ([x.]
    (const.u32.0x3F800000 u32.bitcast-f32 [one.])
    ([.x] stdlib.models.memory.f32.negate [negative-x.])
    ([.negative-x] stdlib.models.math.exp [exp-negative-x.])
    ([.one exp-negative-x] stdlib.models.memory.f32.add [denominator.])
    ([.one denominator] stdlib.models.memory.f32.div [result.])
    [.result]
  )
)

# Stable softplus: max(x, 0) + log(1 + exp(-abs(x))). DeltaNet only uses
# this in F32 for the decay time-step projection.
(def program stdlib.models.math.softplus : (f32 val) -> (f32 val) =
  ([x.]
    (const.u32.0x00000000 u32.bitcast-f32 [zero.])
    (const.u32.0x3F800000 u32.bitcast-f32 [one.])
    ([.x zero] stdlib.models.memory.f32.greater [positive.])
    ([.positive x zero] stdlib.models.memory.select-f32 [maximum.])
    ([.x] stdlib.models.memory.f32.negate [negative.])
    ([.positive negative x] stdlib.models.memory.select-f32 [negative-absolute.])
    ([.negative-absolute] stdlib.models.math.exp [exponential.])
    # log(1 + e) = 2 * atanh(e / (2 + e)), e in [0, 1].
    # Avoid the generic cubic log approximation: its absolute error dominates
    # small negative softplus inputs and changes trained DeltaNet decay gates.
    (const.u32.0x40000000 u32.bitcast-f32 [two.])
    ([.two exponential] stdlib.models.memory.f32.add [denominator.])
    ([.exponential denominator] stdlib.models.memory.f32.div [z.])
    ([.z z] stdlib.models.memory.f32.mul [z2.])
    (const.u32.0x3D70F0F1 u32.bitcast-f32 [c17.])
    (const.u32.0x3D888889 u32.bitcast-f32 [c15.])
    ([.z2 c17] stdlib.models.memory.f32.mul [tail15.])
    ([.c15 tail15] stdlib.models.memory.f32.add [p15.])
    (const.u32.0x3D9D89D9 u32.bitcast-f32 [c13.])
    ([.z2 p15] stdlib.models.memory.f32.mul [tail13.])
    ([.c13 tail13] stdlib.models.memory.f32.add [p13.])
    (const.u32.0x3DBA2E8C u32.bitcast-f32 [c11.])
    ([.z2 p13] stdlib.models.memory.f32.mul [tail11.])
    ([.c11 tail11] stdlib.models.memory.f32.add [p11.])
    (const.u32.0x3DE38E39 u32.bitcast-f32 [c9.])
    ([.z2 p11] stdlib.models.memory.f32.mul [tail9.])
    ([.c9 tail9] stdlib.models.memory.f32.add [p9.])
    (const.u32.0x3E124925 u32.bitcast-f32 [c7.])
    ([.z2 p9] stdlib.models.memory.f32.mul [tail7.])
    ([.c7 tail7] stdlib.models.memory.f32.add [p7.])
    (const.u32.0x3E4CCCCD u32.bitcast-f32 [c5.])
    ([.z2 p7] stdlib.models.memory.f32.mul [tail5.])
    ([.c5 tail5] stdlib.models.memory.f32.add [p5.])
    (const.u32.0x3EAAAAAB u32.bitcast-f32 [c3.])
    ([.z2 p5] stdlib.models.memory.f32.mul [tail3.])
    ([.c3 tail3] stdlib.models.memory.f32.add [p3.])
    (const.u32.0x3F800000 u32.bitcast-f32 [c1.])
    ([.z2 p3] stdlib.models.memory.f32.mul [tail1.])
    ([.c1 tail1] stdlib.models.memory.f32.add [p1.])
    ([.z p1] stdlib.models.memory.f32.mul [half-logarithm.])
    ([.two half-logarithm] stdlib.models.memory.f32.mul [logarithm.])
    ([.maximum logarithm] stdlib.models.memory.f32.add [result.])
    [.result]
  )
)

# Square root with an exponent-derived initial estimate followed by four
# Newton-Raphson refinements. RMS inputs span several orders of magnitude in
# this checkpoint; starting the iteration at x does not converge in a fixed
# six steps once the residual stream becomes large.
(def program stdlib.models.math.sqrt : (f32 val) -> (f32 val) =
  ([x.]
    (const.u32.0x00000000 stdlib.models.memory.u32.to-f32 [zero.])
    (const.u32.0x00000001 [one-bit.])
    (const.u32.0x1FC00000 [sqrt-bias.])
    (const.u32.0x3F000000 u32.bitcast-f32 [half.])
    ([.x] stdlib.math.f32_bits [x-bits.])
    ([.x-bits one-bit] stdlib.math.shift_right [half-exponent-bits.])
    ([.half-exponent-bits sqrt-bias] stdlib.models.memory.u32.add [guess-bits.])
    ([.guess-bits] u32.bitcast-f32 [guess0.])
    ([.x guess0] stdlib.models.memory.f32.div [ratio0.])
    ([.guess0 ratio0] stdlib.models.memory.f32.add [sum0.])
    ([.sum0 half] stdlib.models.memory.f32.mul [guess1.])
    ([.x guess1] stdlib.models.memory.f32.div [ratio1.])
    ([.guess1 ratio1] stdlib.models.memory.f32.add [sum1.])
    ([.sum1 half] stdlib.models.memory.f32.mul [guess2.])
    ([.x guess2] stdlib.models.memory.f32.div [ratio2.])
    ([.guess2 ratio2] stdlib.models.memory.f32.add [sum2.])
    ([.sum2 half] stdlib.models.memory.f32.mul [guess3.])
    ([.x guess3] stdlib.models.memory.f32.div [ratio3.])
    ([.guess3 ratio3] stdlib.models.memory.f32.add [sum3.])
    ([.sum3 half] stdlib.models.memory.f32.mul [guess4.])
    ([.x zero] stdlib.models.memory.f32.less_equal [is-nonpositive.])
    ([.is-nonpositive zero guess4] stdlib.models.memory.select-f32 [result.])
    [.result]
  )
)

(def program stdlib.models.math.rope-sincos : (f32 val) -> {(f32 val) (f32 val)} =
  ([angle.]
    (const.u32.0x3F22F983 u32.bitcast-f32 [inverse-pi-over-two.])
    (const.u32.0x3FC90000 u32.bitcast-f32 [pi-over-two-1.])
    (const.u32.0x39FDA000 u32.bitcast-f32 [pi-over-two-2.])
    (const.u32.0x33A22169 u32.bitcast-f32 [pi-over-two-3.])
    ([.angle inverse-pi-over-two] stdlib.models.memory.f32.mul [scaled-quadrant.])
    ([.scaled-quadrant] stdlib.math.round_to_u32 [quadrant-count.])
    ([.quadrant-count] stdlib.models.memory.u32.to-f32 [quadrant-count-f32.])
    ([.quadrant-count-f32 pi-over-two-1] stdlib.models.memory.f32.mul [range-term-1.])
    ([.angle range-term-1] stdlib.models.memory.f32.sub [reduced-1.])
    ([.quadrant-count-f32 pi-over-two-2] stdlib.models.memory.f32.mul [range-term-2.])
    ([.reduced-1 range-term-2] stdlib.models.memory.f32.sub [reduced-2.])
    ([.quadrant-count-f32 pi-over-two-3] stdlib.models.memory.f32.mul [range-term-3.])
    ([.reduced-2 range-term-3] stdlib.models.memory.f32.sub [reduced.])
    ([.reduced reduced] stdlib.models.memory.f32.mul [squared.])

    (const.u32.0xBE2AAAAB u32.bitcast-f32 [sin-c1.])
    (const.u32.0x3C088889 u32.bitcast-f32 [sin-c2.])
    (const.u32.0xB9500D01 u32.bitcast-f32 [sin-c3.])
    (const.u32.0x3638EF1B u32.bitcast-f32 [sin-c4.])
    (const.u32.0xB2D72F34 u32.bitcast-f32 [sin-c5.])
    (const.u32.0x2F2EC9D3 u32.bitcast-f32 [sin-c6.])
    ([.squared sin-c6] stdlib.models.memory.f32.mul [sin-p5-term.])
    ([.sin-c5 sin-p5-term] stdlib.models.memory.f32.add [sin-p5.])
    ([.squared sin-p5] stdlib.models.memory.f32.mul [sin-p4-term.])
    ([.sin-c4 sin-p4-term] stdlib.models.memory.f32.add [sin-p4.])
    ([.squared sin-p4] stdlib.models.memory.f32.mul [sin-p3-term.])
    ([.sin-c3 sin-p3-term] stdlib.models.memory.f32.add [sin-p3.])
    ([.squared sin-p3] stdlib.models.memory.f32.mul [sin-p2-term.])
    ([.sin-c2 sin-p2-term] stdlib.models.memory.f32.add [sin-p2.])
    ([.squared sin-p2] stdlib.models.memory.f32.mul [sin-p1-term.])
    ([.sin-c1 sin-p1-term] stdlib.models.memory.f32.add [sin-p1.])
    ([.reduced squared] stdlib.models.memory.f32.mul [reduced-cubed.])
    ([.reduced-cubed sin-p1] stdlib.models.memory.f32.mul [sin-tail.])
    ([.reduced sin-tail] stdlib.models.memory.f32.add [sine-reduced.])

    (const.u32.0x3D2AAAAB u32.bitcast-f32 [cos-c1.])
    (const.u32.0xBAB60B61 u32.bitcast-f32 [cos-c2.])
    (const.u32.0x37D00D01 u32.bitcast-f32 [cos-c3.])
    (const.u32.0xB493F27C u32.bitcast-f32 [cos-c4.])
    (const.u32.0x310F74F6 u32.bitcast-f32 [cos-c5.])
    (const.u32.0xAD47D74E u32.bitcast-f32 [cos-c6.])
    ([.squared cos-c6] stdlib.models.memory.f32.mul [cos-p5-term.])
    ([.cos-c5 cos-p5-term] stdlib.models.memory.f32.add [cos-p5.])
    ([.squared cos-p5] stdlib.models.memory.f32.mul [cos-p4-term.])
    ([.cos-c4 cos-p4-term] stdlib.models.memory.f32.add [cos-p4.])
    ([.squared cos-p4] stdlib.models.memory.f32.mul [cos-p3-term.])
    ([.cos-c3 cos-p3-term] stdlib.models.memory.f32.add [cos-p3.])
    ([.squared cos-p3] stdlib.models.memory.f32.mul [cos-p2-term.])
    ([.cos-c2 cos-p2-term] stdlib.models.memory.f32.add [cos-p2.])
    ([.squared cos-p2] stdlib.models.memory.f32.mul [cos-p1-term.])
    ([.cos-c1 cos-p1-term] stdlib.models.memory.f32.add [cos-p1.])
    ([.squared squared] stdlib.models.memory.f32.mul [fourth-power.])
    ([.fourth-power cos-p1] stdlib.models.memory.f32.mul [cos-tail.])
    (const.u32.0x3F000000 u32.bitcast-f32 [half.])
    ([.squared half] stdlib.models.memory.f32.mul [half-squared.])
    ((const.u32.0x3F800000 u32.bitcast-f32) [one.])
    ([.one half-squared] stdlib.models.memory.f32.sub [cos-head.])
    ([.cos-head cos-tail] stdlib.models.memory.f32.add [cosine-reduced.])

    ([.sine-reduced] stdlib.models.memory.f32.negate [negative-sine.])
    ([.cosine-reduced] stdlib.models.memory.f32.negate [negative-cosine.])
    (const.u32.0x00000004 [quadrant-mask.])
    (const.u32.0x00000000 [quadrant-0.])
    (const.u32.0x00000001 [quadrant-1.])
    (const.u32.0x00000002 [quadrant-2.])
    ([.quadrant-count quadrant-mask] stdlib.models.memory.u32.rem [quadrant.])
    ([.quadrant quadrant-0] stdlib.models.memory.u32.equal [is-quadrant-0.])
    ([.quadrant quadrant-1] stdlib.models.memory.u32.equal [is-quadrant-1.])
    ([.quadrant quadrant-2] stdlib.models.memory.u32.equal [is-quadrant-2.])
    ([.is-quadrant-2 negative-sine negative-cosine] stdlib.models.memory.select-f32 [sine-q23.])
    ([.is-quadrant-1 cosine-reduced sine-q23] stdlib.models.memory.select-f32 [sine-q123.])
    ([.is-quadrant-0 sine-reduced sine-q123] stdlib.models.memory.select-f32 [sine.])
    ([.is-quadrant-2 negative-cosine sine-reduced] stdlib.models.memory.select-f32 [cosine-q23.])
    ([.is-quadrant-1 negative-sine cosine-q23] stdlib.models.memory.select-f32 [cosine-q123.])
    ([.is-quadrant-0 cosine-reduced cosine-q123] stdlib.models.memory.select-f32 [cosine.])
    {[.sine] [.cosine]}
  )
)

