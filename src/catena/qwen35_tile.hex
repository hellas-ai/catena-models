# Shared register-only tuples: eight packed operand pairs and eight F32 outputs.
# CUDA consumes the first four operand pairs; its upper slots duplicate those
# coordinates and are eliminated by nvcc. HIP consumes all eight pairs.
# Load each linear closure once per step, then reuse its ordinary register tuple.
(def program stdlib.qwen35.tile.zero : 1 -> ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) (f32 val)} *)} *)} *)} *)} *)} *)} *) =
 (unit.elim
  ({(const.u32.0x00000000 u32.bitcast-f32) (const.u32.0x00000000 u32.bitcast-f32)} *.intro [p6.])
  ({(const.u32.0x00000000 u32.bitcast-f32) [.p6]} *.intro [p5.])
  ({(const.u32.0x00000000 u32.bitcast-f32) [.p5]} *.intro [p4.])
  ({(const.u32.0x00000000 u32.bitcast-f32) [.p4]} *.intro [p3.])
  ({(const.u32.0x00000000 u32.bitcast-f32) [.p3]} *.intro [p2.])
  ({(const.u32.0x00000000 u32.bitcast-f32) [.p2]} *.intro [p1.])
  ({(const.u32.0x00000000 u32.bitcast-f32) [.p1]} *.intro [p0.])
  [.p0]
 ))
(def program stdlib.qwen35.tile.get : {({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) (f32 val)} *)} *)} *)} *)} *)} *)} *) (u32 val)} -> (f32 val) =
 ([acc j.]
  ([.acc] *.elim [c0 tail0.])
  ([.tail0] *.elim [c1 tail1.])
  ([.tail1] *.elim [c2 tail2.])
  ([.tail2] *.elim [c3 tail3.])
  ([.tail3] *.elim [c4 tail4.])
  ([.tail4] *.elim [c5 tail5.])
  ([.tail5] *.elim [c6 c7.])
  ({[.j] (const.u32.0x00000000)} stdlib.models.memory.u32.equal [is0.])
  ({[.is0] [.c0] [.c0]} stdlib.models.memory.select-f32 [r0.])
  ({[.j] (const.u32.0x00000001)} stdlib.models.memory.u32.equal [is1.])
  ({[.is1] [.c1] [.r0]} stdlib.models.memory.select-f32 [r1.])
  ({[.j] (const.u32.0x00000002)} stdlib.models.memory.u32.equal [is2.])
  ({[.is2] [.c2] [.r1]} stdlib.models.memory.select-f32 [r2.])
  ({[.j] (const.u32.0x00000003)} stdlib.models.memory.u32.equal [is3.])
  ({[.is3] [.c3] [.r2]} stdlib.models.memory.select-f32 [r3.])
  ({[.j] (const.u32.0x00000004)} stdlib.models.memory.u32.equal [is4.])
  ({[.is4] [.c4] [.r3]} stdlib.models.memory.select-f32 [r4.])
  ({[.j] (const.u32.0x00000005)} stdlib.models.memory.u32.equal [is5.])
  ({[.is5] [.c5] [.r4]} stdlib.models.memory.select-f32 [r5.])
  ({[.j] (const.u32.0x00000006)} stdlib.models.memory.u32.equal [is6.])
  ({[.is6] [.c6] [.r5]} stdlib.models.memory.select-f32 [r6.])
  ({[.j] (const.u32.0x00000007)} stdlib.models.memory.u32.equal [is7.])
  ({[.is7] [.c7] [.r6]} stdlib.models.memory.select-f32 [r7.])
  [.r7]
 ))
(def program stdlib.qwen35.tile.dot.fold : {({({(u64 val) (u64 val)} *) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) (bf16x2 val)} *)} *)} *)} *)} *)} *)} *)} =>) ({({(u64 val) (u64 val)} *) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) ({(bf16x2 val) (bf16x2 val)} *)} *)} *)} *)} *)} *)} *)} =>) (u64 val) ({({master.index32 u32} :) ({({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) (f32 val)} *)} *)} *)} *)} *)} *)} *) ({(({master.index32 master.end32} prop.Less) |-) (prop.Truth |-)} *)} *)} *)} -> ({({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) ({(f32 val) (f32 val)} *)} *)} *)} *)} *)} *)} *) (prop.Truth |-)} *) =
 ([a b tid pair.]
  ([.pair] *.elim [index rest.])
  ([.rest] *.elim [acc proofs.])
  ([.proofs] *.elim [less truth.])
  ([.less] unsafe.discard unit.elim)
  ([.index] :.forget stdlib.models.memory.u32.to-u64 [step.])
  ({[.step] (const.u64.0x0000000000000008)} stdlib.models.memory.u64.mul [k.])
  ({[.tid] [.k]} *.intro [args.])
  ({[.args] [.a]} evaluate [af.])
  ({[.args] [.b]} evaluate [bf.])
  ({[.af] [.bf] [.acc]} stdlib.qwen35.tile.dot [result.])
  ({[.result] [.truth]} *.intro [done.])
  [.done]
 ))

(def program stdlib.qwen35.tile.load-own-pair : {((cap.own mem) val) (u64 val) (u64 val) (u64 val) (u64 val) (u64 val)} -> (bf16x2 val) =
 ([mem first rows stride row k.]
  ({[.first] [.row]} stdlib.models.memory.u64.add [r.])
  ({[.r] [.rows]} stdlib.models.memory.u64.less [valid.])
  ({[.valid] [.r] (const.u64.0x0000000000000000)} stdlib.models.memory.select-u64 [safe.])
  ({[.safe] [.stride]} stdlib.models.memory.u64.mul [base.])
  ({[.base] [.k]} stdlib.models.memory.u64.add [index.])
  ({[.mem] [.index]} stdlib.models.memory.own-read-bf16x2 [pair.])
  [.pair]
 ))
