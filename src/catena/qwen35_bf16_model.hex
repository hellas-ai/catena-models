# Depthwise causal convolution over a token block and its ring history.
(def program qwen3.qwen35-conv-term-at :
  ([n k.] {
    ({
      ({({({(cap.own mem) (cap.own mem)} *) (cap.ref mem)} *) (u64 val)} *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env indices.])
  ([.env] *.elim [buffers start.])
  ([.buffers] *.elim [history-and-qkv conv-weight.])
  ([.history-and-qkv] *.elim [history qkv.])
  ([.indices] *.elim [output-index kernel-index.])
  ([.output-index] ix.to-u64 [flat-output.])
  ([.kernel-index] ix.to-u64 [kernel.])
  (const.u64.0x{{LINEAR_QKV_SIZE}} [qkv-size.])
  ([.flat-output qkv-size] u64.div [token.])
  ([.flat-output qkv-size] u64.rem [channel.])
  (const.u64.0x{{LINEAR_CONV_KERNEL}} [kernel-size.])
  (const.u64.0x0000000000000001 [one.])
  ([.kernel-size one] u64.sub [history-slots.])
  ([.token kernel] u64.add [token-plus-kernel.])
  ([.token-plus-kernel history-slots] u64.gte [is-current.])
  ([.start token-plus-kernel] u64.add [absolute-plus-kernel.])
  ([.absolute-plus-kernel history-slots] u64.gte [history-valid.])
  ([.absolute-plus-kernel history-slots] u64.rem [slot.])
  ([.slot qkv-size] u64.mul [slot-base.])
  ([.slot-base channel] u64.add [history-index.])
  ([.history] mem.cast.bf16 [history-count history-buffer.])
  ({[.history-count] [.history-buffer] [.history-index]} qwen3.bf16-buffer-at bf16.to-f32 [history-value-raw.])
  (const.u32.0x00000000 u32.bitcast-f32 [zero.])
  ([.history-valid history-value-raw zero] f32.select [history-value.])
  ([.qkv] mem.cast.bf16 [qkv-count qkv-buffer.])
  ([.token-plus-kernel history-slots] u64.sub [current-token-raw.])
  (const.u64.0x0000000000000000 [zero-index.])
  ([.is-current current-token-raw zero-index] u64.select [current-token.])
  ([.current-token qkv-size] u64.mul [current-base.])
  ([.current-base channel] u64.add [current-index.])
  ({[.qkv-count] [.qkv-buffer] [.current-index]} qwen3.bf16-buffer-at bf16.to-f32 [current-value.])
  ([.is-current current-value history-value] f32.select [input-value.])
  ([.channel kernel-size] u64.mul [weight-row-base.])
  ([.weight-row-base kernel] u64.add [weight-index.])
  ([.conv-weight] mem.cast.f32 [weight-count weight-buffer.])
  ({[.weight-count] [.weight-buffer] [.weight-index]} qwen3.f32-buffer-at [weight-value.])
  ([.input-value weight-value] f32.mul [result.])
  [.result]
))

(def program qwen3.qwen35-conv-epilogue :
  ([n.] {
