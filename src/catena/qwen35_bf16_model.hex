(def program qwen3.qwen35-full-decoder-layer :
  {
    (cap.own mem) (cap.own mem) (u64 val) (cap.own mem)
    (u64 val) (u64 val) (u64 val)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
    (cap.ref mem) (cap.ref mem) (cap.ref mem)
