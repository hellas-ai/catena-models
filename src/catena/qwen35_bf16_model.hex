    qwen3.linear [query-and-gate.])
  ([.query-and-gate] qwen3.qwen35-extract-query [query-raw.])
  ({[.normalized-attention-input] [.k-weight] [.key-value-features]}
    qwen3.linear [key-raw.])
  ({[.normalized-attention-input] [.v-weight] [.key-value-features]}
    qwen3.linear [value.])
  ({[.normalized-attention-input] [.value]}
    qwen3.free-bf16-before [value-after-normalized.])
  ({[.query-raw] [.q-norm]} qwen3.head-rmsnorm [query.])
  ({[.key-raw] [.k-norm]} qwen3.head-rmsnorm [key.])
  ({[.cache] [.key] [.rope] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cache-append-key [cache-with-key.])
  ({[.key] [.cache-with-key]} qwen3.free-bf16-before [cache-after-key.])
  ({[.cache-after-key] [.value-after-normalized] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cache-append-value [cache-with-value.])
  ({[.value-after-normalized] [.cache-with-value]} qwen3.free-bf16-before [cache-after-value.])
  ({[.cache-after-value] [.query] [.rope] [.sequence] [.token-capacity] [.start] [.layer]}
    qwen3.cached-attention [cache-after-attention context.])
  ({[.query-and-gate] [.context]} qwen3.qwen35-gate-context [gated-context.])
  ({[.attention-inverse] [.gated-context]} qwen3.free-f32-before [context-after-inverse.])
  ({[.query] [.context-after-inverse]} qwen3.free-bf16-before [context-after-query.])
  (const.u64.0x{{QUERY_SIZE}} [attention-input-features.])
  ({[.context-after-query] [.o-weight] [.hidden] [.attention-input-features]}
    qwen3.linear-residual [attention-hidden.])
  ({[.context-after-query] [.attention-hidden]} qwen3.free-bf16-before [attention-hidden-after-context.])
  ({[.hidden] [.attention-hidden-after-context]} qwen3.free-bf16-before [attention-hidden-after-residual.])
  ([.attention-hidden-after-residual] qwen3.rms-inv [mlp-inverse.])
  ({[.attention-hidden-after-residual] [.post-norm] [.mlp-inverse]}
    qwen3.apply-rmsnorm [normalized-mlp-input.])
  (const.u64.0x{{INTERMEDIATE_SIZE}} [intermediate-features.])
  ({[.normalized-mlp-input] [.gate-weight] [.intermediate-features]}
    qwen3.linear [gate.])
  ({[.normalized-mlp-input] [.up-weight] [.intermediate-features]}
    qwen3.linear [up.])
  ({[.normalized-mlp-input] [.up]}
    qwen3.free-bf16-before [up-after-normalized.])
  ({[.gate] [.up-after-normalized]} qwen3.dense-activate [activated.])
  ({[.activated] [.down-weight] [.attention-hidden-after-residual] [.intermediate-features]}
    qwen3.linear-residual [output.])
  ({[.mlp-inverse] [.output]} qwen3.free-f32-before [output-after-mlp-inverse.])
  ({[.gate] [.output-after-mlp-inverse]} qwen3.free-bf16-before [output-after-gate.])
  ({[.up-after-normalized] [.output-after-gate]} qwen3.free-bf16-before [output-after-up.])
  ({[.activated] [.output-after-up]} qwen3.free-bf16-before [output-after-activated.])
  ({[.attention-hidden-after-residual] [.output-after-activated]}
    qwen3.free-bf16-before [output-after-residual.])
  {[.output-after-residual] [.cache-after-attention]}
))

(def program qwen3.qwen35-full-moe-decoder-layer :
