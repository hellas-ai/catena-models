  (const.u32.0x358637BD u32.bitcast-f32 [epsilon.])
  ([.sum-squared epsilon] f32.add qwen3.sqrt [norm.])
  ([.effective-base within-key] u64.add [input-index.])
  ([.input] mem.cast.bf16 [count buffer.])
  ({[.count] [.buffer] [.input-index]} qwen3.bf16-buffer-at bf16.to-f32 [value.])
  ([.value norm] f32.div [result.])
  ([.result] f32.to-bf16)
