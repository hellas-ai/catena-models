(def program qwen3.qwen35-update-state-cache :
  {(cap.own mem) (cap.own mem) (u64 val) (u64 val)} -> (cap.own mem)
= ([cache state token-capacity layer.]
  ([.cache] mem.cast.bf16 [cache-count cache-buffer.])
  (const.u64.0x{{KV_CACHE_ELEMENTS_PER_TOKEN}} [kv-elements-per-token.])
  ([.token-capacity kv-elements-per-token] u64.mul [recurrent-base.])
  (const.u64.0x{{LINEAR_CONV_STATE_SIZE}} [conv-state-size.])
  (const.u64.0x{{LINEAR_RECURRENT_STATE_SIZE}} [matrix-state-size-value.])
  ([.conv-state-size matrix-state-size-value] u64.add [layer-stride.])
  ([.layer layer-stride] u64.mul [layer-offset.])
  ([.recurrent-base layer-offset] u64.add [layer-base.])
  ([.layer-base conv-state-size] u64.add [write-offset.])
  ([.matrix-state-size-value] u64.name [matrix-state-size.])
  {
    [.cache-buffer] [.cache-count] [.write-offset] [.matrix-state-size] [.state]
    (([.matrix-state-size] :.param) name.qwen3.qwen35-update-state-cache-at)
  } materializec.into [cache-after.]
  ({[.cache-count] [.cache-after]} buf.to-mem)
))

(def program qwen3.qwen35-gated-norm-term-at :
  ([n.] {({(cap.own mem) (u64 val)} *) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([input-and-head channel-index.]
  ([.input-and-head] *.elim [input head.])
  ([.channel-index] ix.to-u64 [channel.])
  (const.u64.0x{{LINEAR_VALUE_HEAD_DIM}} [value-dim.])
  ([.head value-dim] u64.mul [head-base.])
  ([.head-base channel] u64.add [index.])
  ([.input] mem.cast.bf16 [count buffer.])
  ({[.count] [.buffer] [.index]} qwen3.bf16-buffer-at bf16.to-f32 [value.])
  ([.value value] f32.mul [result.])
  [.result]
))

(def program qwen3.qwen35-gated-norm-at :
  ([n.] {({({(cap.own mem) (cap.own mem)} *) (cap.ref mem)} *) ([.n] ix val)})
  ->
  ([n.] (bf16 val))
= ([env output-index.]
  ([.env] *.elim [input-and-z norm-weight.])
  ([.input-and-z] *.elim [input z.])
  ([.output-index] ix.to-u64 [index.])
  (const.u64.0x{{LINEAR_VALUE_HEAD_DIM}} [value-dim-value.])
  ([.index value-dim-value] u64.div [head.])
  ([.index value-dim-value] u64.rem [channel.])
  ({[.input] [.head]} *.intro [term-env.])
  ([.value-dim-value] u64.name [value-dim.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    unit.intro name.f32.add-env
    ({[.term-env] (([.value-dim] :.param) name.qwen3.qwen35-gated-norm-term-at)})
    [.value-dim]
  } reducec [sum-squared.])
  ([.value-dim-value] u64.to-f32 [value-dim-f32.])
  ([.sum-squared value-dim-f32] f32.div [mean-squared.])
  (const.u32.0x{{RMS_EPSILON_BITS}} u32.bitcast-f32 [epsilon.])
  ([.mean-squared epsilon] f32.add qwen3.sqrt [rms.])
  ([.input] mem.cast.bf16 [input-count input-buffer.])
  ({[.input-count] [.input-buffer] [.index]} qwen3.bf16-buffer-at bf16.to-f32 [input-value.])
  ([.input-value rms] f32.div [normalized.])
  ([.norm-weight] mem.cast.f32 [norm-count norm-buffer.])
  ({[.norm-count] [.norm-buffer] [.channel]} qwen3.f32-buffer-at [norm-value.])
  ([.z] mem.cast.bf16 [z-count z-buffer.])
  ({[.z-count] [.z-buffer] [.index]} qwen3.bf16-buffer-at bf16.to-f32 qwen3.silu [z-gate.])
  ([.normalized norm-value] f32.mul [scaled.])
  ([.scaled z-gate] f32.mul [result.])
  ([.result] f32.to-bf16)
))

(def program qwen3.qwen35-gated-norm :
  {(cap.own mem) (cap.own mem) (cap.ref mem) (u64 val)} -> (cap.own mem)
= ([input z norm-weight sequence.]
  (const.u64.0x{{LINEAR_VALUE_SIZE}} [value-size.])
  ([.sequence value-size] u64.mul [count-value.])
  ([.count-value] u64.name [count.])
  ({[.input] [.z]} *.intro [input-and-z.])
  ({[.input-and-z] [.norm-weight]} *.intro [env.])
  { [.count] ({[.count] [.env] (([.count] :.param) name.qwen3.qwen35-gated-norm-at)} materializec) }
  buf.to-mem
))

(def program qwen3.qwen35-value-at :
  ([n.] {(cap.own mem) ([.n] ix val)})
  ->
  ([n.] (bf16 val))
= ([conv output-index.]
  ([.output-index] ix.to-u64 [flat-index.])
  (const.u64.0x{{LINEAR_VALUE_SIZE}} [value-size.])
  (const.u64.0x{{LINEAR_QKV_SIZE}} [qkv-size.])
  (const.u64.0x{{LINEAR_KEY_SIZE}} [key-size.])
  ([.key-size key-size] u64.add [value-base.])
  ([.flat-index value-size] u64.div [token.])
  ([.flat-index value-size] u64.rem [channel.])
  ([.token qkv-size] u64.mul [token-base.])
  ([.token-base value-base] u64.add [token-value-base.])
  ([.token-value-base channel] u64.add [conv-index.])
  ([.conv] mem.cast.bf16 [conv-count conv-buffer.])
  ({[.conv-count] [.conv-buffer] [.conv-index]} qwen3.bf16-buffer-at bf16.to-f32 [result.])
  ([.result] f32.to-bf16)
))

(def program qwen3.qwen35-values :
  {(cap.own mem) (u64 val)} -> (cap.own mem)
= ([conv sequence.]
  (const.u64.0x{{LINEAR_VALUE_SIZE}} [value-size.])
  ([.sequence value-size] u64.mul [count-value.])
  ([.count-value] u64.name [count.])
  { [.count] ({[.count] [.conv] (([.count] :.param) name.qwen3.qwen35-value-at)} materializec) }
  buf.to-mem
))

# The recurrent dependency remains sequential in token order, but is kept
# entirely inside one GPU launch. State is updated in-place in the cache.
(def program qwen3.qwen35-gated-delta-scan :
  {
    (cap.own mem) (cap.own mem) (cap.own mem) (cap.own mem)
    (cap.own mem) (cap.own mem) (u64 val) (u64 val)
  }
  ->
  {(cap.own mem) (cap.own mem)}
= ([cache query key value gate beta matrix-base sequence.]
  ([.cache] mem.cast.bf16 [state-cap state-buffer.])
  ([.query] mem.cast.bf16 [query-cap query-buffer.])
  ([.key] mem.cast.bf16 [key-cap key-buffer.])
