  ([.key-head key-dim] u64.mul [key-head-base.])
  ([.key-head-base key-channel] u64.add [flat-key-index.])
  ([.key] mem.cast.bf16 [key-count key-buffer.])
  ({[.key-count] [.key-buffer] [.flat-key-index]} qwen3.bf16-buffer-at bf16.to-f32 [key-value.])
