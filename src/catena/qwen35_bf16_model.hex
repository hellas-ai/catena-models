  ({[.normalized-attention-input] [.v-weight] [.key-value-features]}
    qwen3.linear [value.])
  ({[.normalized-attention-input] [.value]}
    qwen3.free-bf16-before [value-after-normalized.])
  ({[.query-raw] [.q-norm]} qwen3.head-rmsnorm [query.])
  ({[.key-raw] [.k-norm]} qwen3.head-rmsnorm [key.])
