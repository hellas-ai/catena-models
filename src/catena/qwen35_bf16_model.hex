  ([.output-count-value] u64.name [output-count.])
  ([.kernel-size-value] u64.name [kernel-size.])
  ({[.history] [.qkv]} *.intro [history-and-qkv.])
  ({[.history-and-qkv] [.conv-weight]} *.intro [buffers.])
  ({[.buffers] [.start]} *.intro [env.])
