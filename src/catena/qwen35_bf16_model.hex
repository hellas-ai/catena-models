# Metadata-parameterized Qwen3.5 dense hybrid operations with BF16 storage and
# F32 accumulation for reductions, normalization, and recurrent updates.

# Extract Q from the per-head [Q, gate] projection layout.
(def program qwen3.qwen35-query-at :
  ([n.] {(cap.own mem) ([.n] ix val)})
  ->
  ([n.] (bf16 val))
= ([qg output-index.]
  ([.output-index] ix.to-u64 [flat-index.])
  (const.u64.0x{{QUERY_SIZE}} [query-size.])
  (const.u64.0x{{HEAD_DIM}} [head-dim.])
  ([.flat-index query-size] u64.div [row.])
  ([.flat-index query-size] u64.rem [query-channel.])
  ([.query-channel head-dim] u64.div [head.])
  ([.query-channel head-dim] u64.rem [channel.])
  ([.query-size query-size] u64.add [qg-row-size.])
  ([.head head-dim] u64.mul [head-offset.])
  ([.head-offset head-offset] u64.add [qg-head-offset.])
  ([.row qg-row-size] u64.mul [row-offset.])
  ([.row-offset qg-head-offset] u64.add [head-base.])
  ([.head-base channel] u64.add [qg-index.])
  ([.qg] mem.cast.bf16 [qg-count qg-buffer.])
  ({[.qg-count] [.qg-buffer] [.qg-index]} qwen3.bf16-buffer-at bf16.to-f32 [result.])
  ([.result] f32.to-bf16)
))

(def program qwen3.qwen35-extract-query :
  (cap.own mem)
  ->
  (cap.own mem)
= ([qg.]
  ([.qg] mem.cast.bf16 [qg-count qg-buffer.])
  ([.qg-count] :.forget [qg-count-value.])
  (const.u64.0x0000000000000002 [two.])
  ([.qg-count-value two] u64.div [query-count-value.])
  ([.query-count-value] u64.name [query-count.])
  {
    [.query-count]
    ({[.query-count] [.qg] (([.query-count] :.param) name.qwen3.qwen35-query-at)} materializec)
  } buf.to-mem
))

# Multiply full-attention context by sigmoid of the Q projection's gate half.
(def program qwen3.qwen35-gate-context-at :
  ([n.] {({(cap.own mem) (cap.own mem)} *) ([.n] ix val)})
  ->
  ([n.] (bf16 val))
= ([env output-index.]
  ([.env] *.elim [qg context.])
  ([.output-index] ix.to-u64 [flat-index.])
  (const.u64.0x{{QUERY_SIZE}} [query-size.])
  (const.u64.0x{{HEAD_DIM}} [head-dim.])
  ([.flat-index query-size] u64.div [row.])
  ([.flat-index query-size] u64.rem [query-channel.])
  ([.query-channel head-dim] u64.div [head.])
  ([.query-channel head-dim] u64.rem [channel.])
  ([.query-size query-size] u64.add [qg-row-size.])
  ([.head head-dim] u64.mul [head-offset.])
  ([.head-offset head-offset] u64.add [qg-head-offset.])
  ([.qg-head-offset head-dim] u64.add [gate-head-offset.])
  ([.row qg-row-size] u64.mul [row-offset.])
  ([.row-offset gate-head-offset] u64.add [gate-base.])
  ([.gate-base channel] u64.add [gate-index.])
  ([.qg] mem.cast.bf16 [qg-count qg-buffer.])
  ({[.qg-count] [.qg-buffer] [.gate-index]} qwen3.bf16-buffer-at bf16.to-f32 [gate.])
  ([.gate] qwen3.sigmoid [gate-sigmoid.])
  ([.context] mem.cast.bf16 [context-count context-buffer.])
  ({[.context-count] [.context-buffer] [.flat-index]} qwen3.bf16-buffer-at bf16.to-f32 [context-value.])
  ([.context-value gate-sigmoid] f32.mul [result.])
  ([.result] f32.to-bf16)
))

(def program qwen3.qwen35-gate-context :
  {(cap.own mem) (cap.own mem)}
  ->
  (cap.own mem)
= ([qg context.]
  ([.qg] mem.cast.bf16 [qg-count qg-buffer.])
  ([.context] mem.cast.bf16 [context-count _context-buffer.])
  ({[.qg] [.context]} *.intro [env.])
  {
    [.context-count]
    ({[.context-count] [.env] (([.context-count] :.param) name.qwen3.qwen35-gate-context-at)} materializec)
  } buf.to-mem [gated.]
  ({[.qg] [.gated]} qwen3.free-bf16-before [gated-after-qg.])
  ({[.context] [.gated-after-qg]} qwen3.free-bf16-before)
))

# Paired shared-expert projection. Unlike the routed variant, these GGUF
# matrices have no leading expert dimension and always select slot zero.
(def program qwen3.qwen35-shared-linear-pair :
  {(cap.own mem) (cap.ref mem) (cap.ref mem) (cap.own mem)}
  ->
  {(cap.own mem) (cap.own mem) (cap.own mem) (cap.own mem)}
= ([input gate-weight up-weight selected-experts.]
  ([.input] mem.cast.bf16 [input-count input-buffer.])
  ([.gate-weight] mem.cast.bf16 [gate-count gate-buffer.])
  ([.up-weight] mem.cast.bf16 [up-count up-buffer.])
  ([.selected-experts] mem.cast.u64 [selected-count selected-buffer.])
  ([.input-count] :.forget [input-count-value.])
  (const.u64.0x{{HIDDEN_SIZE}} [hidden-size-value.])
  (const.u64.0x{{SHARED_INTERMEDIATE_SIZE}} [shared-size.])
  (const.u64.0x0000000000000001 [one.])
  ([.input-count-value hidden-size-value] u64.div [row-count.])
  ([.row-count shared-size] u64.mul [output-count-value.])
  ([.output-count-value] u64.name [output-count.])
  ([.hidden-size-value] u64.name [hidden-size.])
  {
    [.input-buffer] [.input-count]
    [.gate-buffer] [.gate-count]
    [.up-buffer] [.up-count]
    [.selected-buffer] [.selected-count]
    [.output-count] [.hidden-size] [.one] [.shared-size]
  } materializec.borrow-routed-native-bf16-gemv-pair
    [input-after selected-after gate up.]
  {
    ({[.input-count] [.input-after]} buf.to-mem)
    ({[.selected-count] [.selected-after]} buf.to-mem)
    ({[.output-count] [.gate]} buf.to-mem)
    ({[.output-count] [.up]} buf.to-mem)
  }
))

(def program qwen3.qwen35-shared-scale-at :
  ([n.] {({(cap.own mem) (cap.own mem)} *) ([.n] ix val)})
  ->
  ([n.] (bf16 val))
= ([env output-index.]
  ([.env] *.elim [activated router.])
  ([.output-index] ix.to-u64 [index.])
  (const.u64.0x{{SHARED_INTERMEDIATE_SIZE}} [shared-size.])
  ([.index shared-size] u64.div [row.])
  ([.activated] mem.cast.bf16 [active-count active-buffer.])
  ({[.active-count] [.active-buffer] [.index]} qwen3.bf16-buffer-at bf16.to-f32 [value.])
  ([.router] mem.cast.f32 [router-count router-buffer.])
  ({[.router-count] [.router-buffer] [.row]} qwen3.f32-buffer-at qwen3.sigmoid [scale.])
  ([.value scale] f32.mul [result.])
  ([.result] f32.to-bf16)
))

(def program qwen3.qwen35-shared-scale :
  {(cap.own mem) (cap.own mem)} -> (cap.own mem)
= ([activated router.]
  ([.activated] mem.cast.bf16 [count _buffer.])
  ({[.activated] [.router]} *.intro [env.])
  { [.count] ({[.count] [.env] (([.count] :.param) name.qwen3.qwen35-shared-scale-at)} materializec) }
  buf.to-mem [scaled.]
  ({[.activated] [.scaled]} qwen3.free-bf16-before [scaled-after-activated.])
  ({[.router] [.scaled-after-activated]} qwen3.free-f32-before)
))

# One term of a router projection with BF16 activations and native-F32 weights.
# Qwen3.5/3.6 stores both the routed and shared router matrices as F32.
(def program qwen3.qwen35-router-linear-term-at :
  ([n k.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        (u64 val)
      } *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([n k.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [env indices.])
  ([.env] *.elim [input-and-weight output-features.])
  ([.input-and-weight] *.elim [input linear-weight.])
  ([.indices] *.elim [output-index input-index.])
  ([.output-index] ix.to-u64 [index.])
  ([.input-index] ix.to-u64 [input-channel.])
  (const.u64.0x{{HIDDEN_SIZE}} [input-features.])
  ([.index output-features] u64.div [row.])
  ([.index output-features] u64.rem [output-channel.])
  ([.row input-features] u64.mul [input-row-base.])
  ([.input-row-base input-channel] u64.add [flat-input-index.])
  ([.output-channel input-features] u64.mul [weight-row-base.])
  ([.weight-row-base input-channel] u64.add [weight-index.])
  ([.input] mem.cast.bf16 [input-count input-buffer.])
  ({[.input-count] [.input-buffer] [.flat-input-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [input-value.])
  ([.linear-weight] mem.cast.f32 [weight-count weight-buffer.])
  ({[.weight-count] [.weight-buffer] [.weight-index]}
    qwen3.f32-buffer-at [weight-value.])
  ([.input-value weight-value] f32.mul)
))

(def program qwen3.qwen35-router-linear-epilogue :
  ([n.] {
    ({
      ({
        ({(cap.own mem) (cap.ref mem)} *)
        (u64 val)
      } *)
      ({([.n] ix val) (f32 val)} *)
    } *)
  })
  ->
  ([n.] (f32 val))
= ([arguments.]
  ([.arguments] *.elim [_env index-and-sum.])
  ([.index-and-sum] *.elim [_index sum.])
  [.sum]
))

# Router projection preserving F32 logits for top-k and sigmoid scaling.
(def program qwen3.qwen35-router-linear :
  {(cap.own mem) (cap.ref mem) (u64 val)} -> (cap.own mem)
= ([input linear-weight output-features.]
  ([.input] mem.cast.bf16 [input-count _input-buffer.])
  ([.input-count] :.forget [input-count-value.])
  (const.u64.0x{{HIDDEN_SIZE}} [input-features.])
  ([.input-count-value input-features] u64.div [row-count.])
  ([.row-count output-features] u64.mul [output-count-value.])
  ([.output-count-value] u64.name [output-count.])
  ([.input-features] u64.name [input-feature-count.])
  ({[.input] [.linear-weight]} *.intro [input-and-weight.])
  ({[.input-and-weight] [.output-features]} *.intro [env.])
  {
    [.output-count]
    [.input-feature-count]
    [.env]
    ({
      ([.output-count] :.param)
      ([.input-feature-count] :.param)
    } name.qwen3.qwen35-router-linear-term-at)
    (([.output-count] :.param) name.qwen3.qwen35-router-linear-epilogue)
  } materializec.reduce-f32 [output.]
  ({[.output-count] [.output]} buf.to-mem)
))

(def program qwen3.qwen35-expert-linear-pair :
  {(cap.own mem) (cap.ref mem) (cap.ref mem) (cap.own mem)}
  ->
  {(cap.own mem) (cap.own mem) (cap.own mem) (cap.own mem)}
= ([input gate-weight up-weight selected-experts.]
  ([.input] mem.cast.bf16 [input-count input-buffer.])
  ([.gate-weight] mem.cast.bf16 [gate-count gate-buffer.])
  ([.up-weight] mem.cast.bf16 [up-count up-buffer.])
  ([.selected-experts] mem.cast.u64 [selected-count selected-buffer.])
  ([.input-count] :.forget [input-count-value.])
  (const.u64.0x{{HIDDEN_SIZE}} [hidden-size-value.])
  (const.u64.0x{{ACTIVE_INTERMEDIATE_SIZE}} [active-intermediate-row.])
  (const.u64.0x{{INTERMEDIATE_SIZE}} [intermediate-size.])
  (const.u64.0x{{EXPERTS_PER_TOKEN}} [experts-per-token.])
  ([.input-count-value hidden-size-value] u64.div [row-count.])
  ([.row-count active-intermediate-row] u64.mul [output-count-value.])
  ([.output-count-value] u64.name [output-count.])
  ([.hidden-size-value] u64.name [hidden-size.])
  {
    [.input-buffer] [.input-count]
    [.gate-buffer] [.gate-count]
    [.up-buffer] [.up-count]
    [.selected-buffer] [.selected-count]
    [.output-count] [.hidden-size] [.experts-per-token] [.intermediate-size]
  } materializec.borrow-routed-native-bf16-gemv-pair
    [input-after selected-after gate up.]
  {
    ({[.input-count] [.input-after]} buf.to-mem)
    ({[.selected-count] [.selected-after]} buf.to-mem)
    ({[.output-count] [.gate]} buf.to-mem)
    ({[.output-count] [.up]} buf.to-mem)
  }
))

(def program qwen3.qwen35-moe-activate-at :
  ([n.] {({({(cap.own mem) (cap.own mem)} *) (cap.own mem)} *) ([.n] ix val)})
  ->
  ([n.] (bf16 val))
= ([env output-index.]
  ([.env] *.elim [gate-and-up routing-weights.])
  ([.gate-and-up] *.elim [gate up.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  (const.u64.0x{{ACTIVE_INTERMEDIATE_SIZE}} [active-intermediate-row.])
  (const.u64.0x{{INTERMEDIATE_SIZE}} [intermediate-size.])
  (const.u64.0x{{EXPERTS_PER_TOKEN}} [experts-per-token.])
  ([.flat-output-index active-intermediate-row] u64.div [row.])
  ([.flat-output-index active-intermediate-row] u64.rem [row-element.])
  ([.row-element intermediate-size] u64.div [slot.])
  ([.row experts-per-token] u64.mul [routing-row-base.])
  ([.routing-row-base slot] u64.add [routing-index.])
  ([.gate] mem.cast.bf16 [gate-count gate-buffer.])
  ({[.gate-count] [.gate-buffer] [.flat-output-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [gate-value.])
  ([.up] mem.cast.bf16 [up-count up-buffer.])
  ({[.up-count] [.up-buffer] [.flat-output-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [up-value.])
  ([.routing-weights] mem.cast.f32 [routing-count routing-buffer.])
  ({[.routing-count] [.routing-buffer] [.routing-index]}
    qwen3.f32-buffer-at [routing-weight.])
  ([.gate-value] qwen3.silu [activated-gate.])
  ([.activated-gate up-value] f32.mul [expert-hidden.])
  ([.expert-hidden routing-weight] f32.mul f32.to-bf16)
))

(def program qwen3.qwen35-moe-activate :
  {(cap.own mem) (cap.own mem) (cap.own mem)} -> (cap.own mem)
= ([gate up routing-weights.]
  ([.gate] mem.cast.bf16 [output-count _gate-buffer.])
  ({[.gate] [.up]} *.intro [gate-and-up.])
  ({[.gate-and-up] [.routing-weights]} *.intro [env.])
  {
    [.output-count]
    ({[.output-count] [.env] (([.output-count] :.param) name.qwen3.qwen35-moe-activate-at)} materializec)
  } buf.to-mem
))

(def program qwen3.qwen35-moe-down-term-at :
  ([active-count output-count k.] {
    ({cap.ref [.active-count] bf16} buf val)
    ({
      ({({[.active-count] u64} :) ({(cap.ref mem) (cap.own mem)} *)} *)
      (cap.own mem)
    } *)
    ({([.output-count] ix val) ([.k] ix val)} *)
  })
  ->
  ([active-count output-count k.] (f32 val))
= ([active-buffer env indices.]
  ([.env] *.elim [active-count-and-weights _residual.])
  ([.active-count-and-weights] *.elim [active-count-value down-and-experts.])
  ([.down-and-experts] *.elim [down-weight selected-experts.])
  ([.indices] *.elim [output-index reduction-index.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.reduction-index] ix.to-u64 [flat-reduction-index.])
  (const.u64.0x{{HIDDEN_SIZE}} [hidden-size.])
  (const.u64.0x{{INTERMEDIATE_SIZE}} [intermediate-size.])
  (const.u64.0x{{EXPERTS_PER_TOKEN}} [experts-per-token.])
  (const.u64.0x{{ACTIVE_INTERMEDIATE_SIZE}} [active-intermediate-row.])
  (const.u64.0x{{EXPERT_STRIDE}} [down-expert-stride.])
  ([.flat-output-index hidden-size] u64.div [row.])
  ([.flat-output-index hidden-size] u64.rem [output-channel.])
  ([.flat-reduction-index intermediate-size] u64.div [slot.])
  ([.flat-reduction-index intermediate-size] u64.rem [intermediate-channel.])
  ([.row active-intermediate-row] u64.mul [active-row-base.])
  ([.active-row-base flat-reduction-index] u64.add [active-index.])
  ({[.active-count-value] [.active-buffer] [.active-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [active-value.])
  ([.row experts-per-token] u64.mul [selected-row-base.])
  ([.selected-row-base slot] u64.add [selected-index.])
  ([.selected-experts] mem.cast.u64 [selected-count selected-buffer.])
  ({[.selected-count] [.selected-buffer] [.selected-index]}
    qwen3.u64-buffer-at [expert.])
  ([.expert down-expert-stride] u64.mul [expert-base.])
  ([.output-channel intermediate-size] u64.mul [down-row-base.])
  ([.expert-base down-row-base] u64.add [expert-row-base.])
  ([.expert-row-base intermediate-channel] u64.add [down-index.])
  ([.down-weight] mem.cast.bf16 [down-count down-buffer.])
  ({[.down-count] [.down-buffer] [.down-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [down-value.])
  ([.active-value down-value] f32.mul)
))

(def program qwen3.qwen35-moe-down-epilogue :
  ([active-count output-count.] {
    ({cap.ref [.active-count] bf16} buf val)
    ({
      ({({[.active-count] u64} :) ({(cap.ref mem) (cap.own mem)} *)} *)
      (cap.own mem)
    } *)
    ({([.output-count] ix val) (f32 val)} *)
  })
  ->
  ([active-count output-count.] (bf16 val))
= ([_active-buffer env index-and-sum.]
  ([.env] *.elim [_active-count-and-weights residual.])
  ([.index-and-sum] *.elim [output-index projected.])
  ([.output-index] ix.to-u64 [flat-output-index.])
  ([.residual] mem.cast.bf16 [residual-count residual-buffer.])
  ({[.residual-count] [.residual-buffer] [.flat-output-index]}
    qwen3.bf16-buffer-at bf16.to-f32 [residual-value.])
  ([.projected residual-value] f32.add f32.to-bf16)
))

(def program qwen3.qwen35-moe-down-residual :
  {(cap.own mem) (cap.ref mem) (cap.own mem) (cap.own mem)}
  ->
  {(cap.own mem) (cap.own mem) (cap.own mem) (cap.own mem)}
= ([activated down-weight selected-experts residual.]
  ([.activated] mem.cast.bf16 [active-count active-buffer.])
  ([.down-weight] mem.cast.bf16 [down-count down-buffer.])
  ([.selected-experts] mem.cast.u64 [selected-count selected-buffer.])
  ([.residual] mem.cast.bf16 [output-count residual-buffer.])
  (const.u64.0x{{ACTIVE_INTERMEDIATE_SIZE}} [active-intermediate-value.])
  ([.active-intermediate-value] u64.name [active-intermediate.])
  (const.u64.0x{{EXPERTS_PER_TOKEN}} [experts-per-token.])
  (const.u64.0x{{INTERMEDIATE_SIZE}} [intermediate-size.])
  (const.u64.0x{{HIDDEN_SIZE}} [hidden-size.])
  {
    [.active-buffer] [.active-count]
    [.down-buffer] [.down-count]
    [.selected-buffer] [.selected-count]
    [.residual-buffer] [.output-count]
    [.output-count] [.active-intermediate]
    [.experts-per-token] [.intermediate-size] [.hidden-size]
  } materializec.borrow-routed-native-bf16-gemv-residual
    [activated-after selected-after residual-after output-buffer.]
  {
    ({[.active-count] [.activated-after]} buf.to-mem)
    ({[.selected-count] [.selected-after]} buf.to-mem)
    ({[.output-count] [.residual-after]} buf.to-mem)
    ({[.output-count] [.output-buffer]} buf.to-mem)
  }
))

# Qwen3.5/3.6 MoE FFN: normalized top-k routed experts plus a sigmoid-gated
# dense shared expert, both added to the attention residual.
(def program qwen3.qwen35-moe-ffn :
  {
    (cap.own mem) (cap.own mem) (u64 val)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
    (cap.ref mem) (cap.ref mem) (cap.ref mem) (cap.ref mem)
  }
  ->
  (cap.own mem)
= ([normalized residual sequence
    router-weight expert-gate-weight expert-up-weight expert-down-weight
    shared-router-weight shared-gate-weight shared-up-weight shared-down-weight.]
  (const.u64.0x{{EXPERT_COUNT}} [router-features.])
  ({[.normalized] [.router-weight] [.router-features]} qwen3.qwen35-router-linear [router-logits.])
  ([.router-logits] qwen3.router-select-experts [router-after selected-experts.])
  ({[.router-after] [.selected-experts]} qwen3.routing-weights [routing-weights.])
  ({[.normalized] [.expert-gate-weight] [.expert-up-weight] [.selected-experts]}
    qwen3.qwen35-expert-linear-pair
    [normalized-after-expert selected-after-expert expert-gate expert-up.])
  ({[.expert-gate] [.expert-up] [.routing-weights]}
    qwen3.qwen35-moe-activate [expert-activated.])
  ({[.expert-activated] [.expert-down-weight] [.selected-after-expert] [.residual]}
    qwen3.qwen35-moe-down-residual
    [expert-activated-after selected-after-down residual-after-down routed-output.])
  (const.u64.0x0000000000000001 [one.])
  ({[.normalized-after-expert] [.shared-router-weight] [.one]}
    qwen3.qwen35-router-linear [shared-router.])
  ([.sequence] qwen3.dense-selected-experts [shared-selected.])
  ({[.normalized-after-expert] [.shared-gate-weight] [.shared-up-weight] [.shared-selected]}
    qwen3.qwen35-shared-linear-pair
    [normalized-after-shared shared-selected-after shared-gate shared-up.])
  ({[.shared-gate] [.shared-up]} qwen3.dense-activate [shared-activated.])
  ({[.shared-activated] [.shared-router]} qwen3.qwen35-shared-scale [shared-scaled.])
  (const.u64.0x{{SHARED_INTERMEDIATE_SIZE}} [shared-features.])
  ({[.shared-scaled] [.shared-down-weight] [.routed-output] [.shared-features]}
    qwen3.linear-residual [output.])
  ({[.normalized-after-shared] [.output]} qwen3.free-bf16-before [output-01.])
  ({[.router-after] [.output-01]} qwen3.free-f32-before [output-02.])
  ({[.expert-gate] [.output-02]} qwen3.free-bf16-before [output-03.])
  ({[.expert-up] [.output-03]} qwen3.free-bf16-before [output-04.])
  ({[.expert-activated-after] [.output-04]} qwen3.free-bf16-before [output-05.])
  ({[.routing-weights] [.output-05]} qwen3.free-f32-before [output-06.])
  ({[.selected-after-down] [.output-06]} qwen3.free-u64-before [output-07.])
  ({[.routed-output] [.output-07]} qwen3.free-bf16-before [output-08.])
  ({[.shared-gate] [.output-08]} qwen3.free-bf16-before [output-09.])
  ({[.shared-up] [.output-09]} qwen3.free-bf16-before [output-10.])
  ({[.shared-selected-after] [.output-10]} qwen3.free-u64-before [output-11.])
  ({[.shared-scaled] [.output-11]} qwen3.free-bf16-before [output-12.])
  ({[.residual-after-down] [.output-12]} qwen3.free-bf16-before)
