  ({[.qkv-count] [.qkv-buffer] [.index]} qwen3.bf16-buffer-at bf16.to-f32 [result.])
  ([.result] f32.to-bf16)
))

(def program qwen3.qwen35-final-conv-cache-at :
  ([n.] {({({({(cap.own mem) (cap.own mem)} *) (u64 val)} *) (u64 val)} *) ([.n] ix val)})
  ->
  ([n.] (bf16 val))
= ([env output-index.]
  ([.env] *.elim [buffers-and-sequence start.])
  ([.buffers-and-sequence] *.elim [buffers sequence.])
  ([.buffers] *.elim [history qkv.])
  ([.output-index] ix.to-u64 [flat-index.])
  (const.u64.0x{{LINEAR_QKV_SIZE}} [qkv-size.])
  (const.u64.0x0000000000000003 [history-slots.])
  (const.u64.0x0000000000000001 [one.])
  ([.flat-index qkv-size] u64.div [slot.])
  ([.flat-index qkv-size] u64.rem [channel.])
  ([.start sequence] u64.add [end.])
  ([.end one] u64.sub [last.])
  ([.last history-slots] u64.add [last-plus-three.])
  ([.last-plus-three slot] u64.sub [back-numerator.])
  ([.back-numerator history-slots] u64.rem [back.])
  ([.last back] u64.gte [available.])
  ([.last back] u64.sub [absolute-raw.])
  (const.u64.0x0000000000000000 [zero.])
  ([.available absolute-raw zero] u64.select [absolute.])
  ([.absolute start] u64.gte [at-or-after-start.])
  ([.available at-or-after-start] bool.and [from-batch.])
  ([.absolute start] u64.sub [batch-token-raw.])
  ([.from-batch batch-token-raw zero] u64.select [batch-token.])
  ([.batch-token qkv-size] u64.mul [batch-base.])
  ([.batch-base channel] u64.add [batch-index.])
  ([.qkv] mem.cast.bf16 [qkv-count qkv-buffer.])
  ({[.qkv-count] [.qkv-buffer] [.batch-index]} qwen3.bf16-buffer-at bf16.to-f32 [batch-value.])
  ([.history] mem.cast.bf16 [history-count history-buffer.])
  ({[.history-count] [.history-buffer] [.flat-index]} qwen3.bf16-buffer-at bf16.to-f32 [history-value.])
  ([.from-batch batch-value history-value] f32.select [result.])
  ([.result] f32.to-bf16)
))

(def program qwen3.qwen35-update-conv-cache :
  {(cap.own mem) (cap.own mem) (cap.own mem) (u64 val) (u64 val) (u64 val) (u64 val)}
  ->
  (cap.own mem)
= ([cache qkv history token-capacity start layer sequence.]
