# Inference control helpers. Model passes and token decisions execute in generated C++.
(def program whisper.free-u64-value : {(cap.own mem) (u64 val)} -> (u64 val)
= ([memory value.] ([.memory] mem.cast.u64 [count buffer.]) ([.buffer] buf.free) [.value]))
(def program whisper.first-u64 : (cap.own mem) -> (u64 val)
= ([memory.] ([.memory] mem.cast.u64 [count buffer.])
 ({[.count] [.buffer] (const.u64.0x0000000000000000)} qwen3.u64-buffer-at [value.])
 ({[.memory] [.value]} whisper.free-u64-value)))
(def program whisper.release-score : {(cap.own mem) (cap.own mem) (bool val)} -> {(cap.own mem) (bool val)}
= ([score logits valid.] ({[.score] [.logits]} qwen3.free-f32-before [ready.]) {[.ready] [.valid]}))

# Reverse vocabulary order because the existing argmax chooses the greatest
# index on ties, whereas Whisper chooses the lowest original token ID.
(def program whisper.mask-score-at : ([n.] {({(cap.own mem) ({(cap.ref mem) ({(cap.ref mem) (bool val)} *)} *)} *) ([.n] ix val)}) -> ([n.] (f32 val))
= ([env index.]
 ([.env] *.elim [logits rest.]) ([.rest] *.elim [mask tail.]) ([.tail] *.elim [begin first.])
 ([.logits] mem.cast.bf16 [count buffer.]) ([.count] :.forget [length.])
 ([.index] ix.to-u64 [i.]) ([.length i] u64.sub [remaining.])
 ({[.remaining] (const.u64.0x0000000000000001)} u64.sub [source.])
 ({[.count] [.buffer] [.source]} qwen3.bf16-buffer-at bf16.to-f32 [value.])
 ([.mask] mem.cast.f32 [mc mb.]) ([.begin] mem.cast.f32 [bc bb.])
 ({[.mc] [.mb] [.source]} qwen3.f32-buffer-at [allowed.])
 ({[.bc] [.bb] [.source]} qwen3.f32-buffer-at [begin-allowed.])
 (const.u32.0x00000000 u32.bitcast-f32 [zero.])
 (const.u32.0xFF800000 u32.bitcast-f32 [negative-infinity.])
 (const.u32.0x7F800000 u32.bitcast-f32 [positive-infinity.])
 ([.allowed zero] f32.gte [general.]) ([.begin-allowed zero] f32.gte [initial.])
 ([.first] bool.not [later.]) ([.later initial] bool.or [begin-ok.])
 ([.general begin-ok] bool.and [allow.])
 ([.allow value negative-infinity] f32.select [masked.])
 ([.negative-infinity value] f32.lt [above.]) ([.value positive-infinity] f32.lt [below.])
 ([.above below] bool.and [finite.])
 ([.finite masked positive-infinity] f32.select)
))
(def program whisper.select-token : {(cap.own mem) (cap.ref mem) (cap.ref mem) (bool val)} -> {(cap.own mem) (u64 val) (bool val)}
= ([logits mask begin first.]
 ([.logits] mem.cast.bf16 [count ignored.])
 ({[.begin] [.first]} *.intro [tail.]) ({[.mask] [.tail]} *.intro [rest.]) ({[.logits] [.rest]} *.intro [env.])
 {[.count] [.env] (([.count] :.param) name.whisper.mask-score-at)} materializec [score.]
 (const.u64.0x0000000000000001 u64.name [one.])
 {[.score] [.count] [.one]} materializec.borrow-argmax-f32 [after-score indices.]
 ({[.one] [.indices]} buf.to-mem whisper.first-u64 [reverse-index.])
 ({[.count] [.after-score] [.reverse-index]} qwen3.f32-buffer-at [winning-score.])
 (const.u32.0xFF800000 u32.bitcast-f32 [negative-infinity.])
 (const.u32.0x7F800000 u32.bitcast-f32 [positive-infinity.])
 ([.negative-infinity winning-score] f32.lt [above.]) ([.winning-score positive-infinity] f32.lt [below.])
 ([.above below] bool.and [valid.])
 ([.count] :.forget [length.]) ([.length reverse-index] u64.sub [remaining.])
 ({[.remaining] (const.u64.0x0000000000000001)} u64.sub [token.])
 ({[.count] [.after-score]} buf.to-mem [score-memory.])
 ({[.score-memory] [.logits] [.valid]} whisper.release-score [ready-logits ready-valid.])
 {[.ready-logits] [.token] [.ready-valid]}
))
(def program whisper.token-at : ([n.] {(u64 val) ([.n] ix val)}) -> ([n.] (u64 val))
= ([token index.] [.token]))
(def program whisper.write-token : {(cap.own mem) (u64 val) (u64 val)} -> (cap.own mem)
= ([memory offset token.] ([.memory] mem.cast.u64 [capacity buffer.])
 (const.u64.0x0000000000000001 u64.name [one.])
 {[.buffer] [.capacity] [.offset] [.one] [.token] (([.one] :.param) name.whisper.token-at)} materializec.into [after.]
 ({[.capacity] [.after]} buf.to-mem)
))

# Diagnostic copies are compiled only into the debug transcription entrypoint.
(def program whisper.copy-bf16 : {(cap.own mem) (u64 val)} -> (cap.own mem)
= ([input count.] ([.count] u64.name [n.]) ({[.input] [.count]} *.intro [env.])
 {[.n] ({[.n] [.env] (([.n] :.param) name.whisper.cache-at)} materializec)} buf.to-mem))
(def program whisper.write-logits : {(cap.own mem) (cap.own mem) (u64 val) (u64 val)} -> (cap.own mem)
= ([trace logits position cols.]
 ([.trace] mem.cast.bf16 [capacity buffer.]) ([.cols] u64.name [n.])
 ([.position cols] u64.mul [offset.]) ({[.logits] [.cols]} *.intro [env.])
 {[.buffer] [.capacity] [.offset] [.n] [.env] (([.n] :.param) name.whisper.cache-at)} materializec.into [after.]
 ({[.capacity] [.after]} buf.to-mem)
))
